<script lang="uts">
	import { getContractStatistics, ContractStatus } from '../../api/contracts/index';
	import type { ContractStatistics } from '../../api/contracts/index';
	import { isLoggedIn, requireLogin } from '../../api/auth';
	import { getSealPageUrl } from '../../api/seals/index';
	import { checkNetworkStatus, testH5ServiceAvailability } from '../../utils/network';
	import { getSealToken, clearSealToken } from '../../utils/sealTokenManager';
	import { getEnterpriseList, switchEnterprise, switchToPersonal, EnterpriseStatus } from '../../api/enterprise/index';
	import { getQuotaBalance } from '@/api/quota/index';
	import { get } from '@/api/index';
	import PrivacyGuideModal from '../../components/PrivacyGuideModal.uvue';
	import { buildDefaultShareConfig } from '../../utils/share';
	import { APP_NAME, APP_COPYRIGHT_SLOGAN, APP_COPYRIGHT_OWNER_TEXT } from '../../config/app.config';
	
	export default {
		components: {
			PrivacyGuideModal
		},
		onLoad() {
			// 检查隐私协议同意状态
			this.checkPrivacyAgreement();
			this.safeTop = this.getSafeTop();
		},
		async onShow() {
			this.safeTop = this.getSafeTop();
			await this.initializeHome();
		},
		onHide() {
			// 页面隐藏时关闭弹窗
			this.showIdentityDropdown = false;
		},
		onPullDownRefresh() {
			if (!this.isLoggedIn) {
				uni.stopPullDownRefresh();
				return;
			}
			this.loadContractSummary(true);
		},
		// #ifdef MP-WEIXIN
		onShareAppMessage() : any {
			const config = buildDefaultShareConfig();
			return {
				title: config.title,
				path: config.path,
				imageUrl: config.imageUrl
			};
		},
		onShareTimeline() : any {
			const config = buildDefaultShareConfig();
			return {
				title: config.title,
				query: 'type=app'
			};
		},
		// #endif
		data() {
			return {
				// 品牌信息（从集中配置获取）
				appName: APP_NAME,
				copyrightSlogan: APP_COPYRIGHT_SLOGAN,
				copyrightOwnerText: APP_COPYRIGHT_OWNER_TEXT,
				safeTop: 0,
					// 隐私协议引导弹窗
					showPrivacyModal: false,  // 是否显示隐私协议引导弹窗
					// 游客首页不请求任何需要 Token 的私有接口
					isLoggedIn: false,
				// 身份切换相关（复用个人中心逻辑）
				showIdentityDropdown: false,  // 是否显示身份切换弹窗
				currentIdentity: {
					type: 'personal',  // 当前身份类型：personal 或 enterprise
					id: '',  // 身份ID
					name: '个人',  // 身份名称
					verified: false,  // 当前身份是否已认证
					role: ''  // 角色（企业身份才有）
				},
				// 企业列表
				enterprises: [] as any[],
				// 用户信息（用于身份切换）
				userInfo: {
					id: '',
					name: '',
					isVerified: false
				},
				// 配额功能是否启用
				quotaEnabled: true,
				// 个人配额（用于身份切换弹窗显示）
				personalQuota: 0,
				// 企业配额 Map (enterpriseId -> quota)
				enterpriseQuotaMap: {} as Record<string, number>,
				// 状态摘要数据
				statusData: [
					{ label: '签署中', count: 0, color: '#1890FF' },
					{ label: '填写表单', count: 0, color: '#FAAD14' },
					{ label: '已完成', count: 0, color: '#00C28A' }
				],
				// 是否正在加载数据
				isLoading: false,
				// 快速发起选项
				quickStartItems: [
					{ icon: '/static/icons/template.png', label: '模板发起', path: '/pages/template-market/index' },
					{ icon: '/static/icons/folder.png', label: '文件发起', path: '/pages/contract-create/h5-create?type=file' },
					{ icon: '/static/icons/image.png', label: '图片发起', path: '/pages/contract-create/h5-create?type=image' },
					{ icon: '/static/icons/draft.png', label: '批量发起', path: '' }
				],
				// 热门模板数据：ID 需与 seal_template 当前系统模板保持一致
				templates: [
					{ 
						id: 159,
						name: '个人借条1',
						description: '让每一份承诺都有据可依',
						buttonLabel: '立即使用',
						buttonColor: '#007BFF',
						image: '/static/templates/loan.png'
					},
					{
						id: 156,
						name: '房屋租赁收据',
						description: '让每一笔资金流动都有迹可循',
						image: '/static/templates/receipt.png'
					},
					{
						id: 163,
						name: '买卖合同',
						description: '让每一次交易都充满安心与信赖',
						image: '/static/templates/purchase.png'
					}
				],
				// 特色服务数据
				features: [
					{
						name: '天眼审查',
						aiBadge: 'AI生成',
						description: '人工智能生成合同审查结果，仅供参考',
						faIcon: 'fa-eye',
						iconColor: '#00C28A',
						path: '/pages/contract-audit/intro' // 跳转到天眼审查宣传页
					},
					{
						name: 'AI起草',
						aiBadge: 'AI生成',
						description: '人工智能生成合同内容，请核对确认后使用',
						faIcon: 'fa-robot',
						iconColor: '#1890FF',
						path: '/pages/ai-draft/index' // 跳转到AI起草页面
					},
					{
						name: '合同验真',
						aiBadge: '',
						description: '上传PDF验证签名真实性与文件完整性',
						faIcon: 'fa-shield-halved',
						iconColor: '#667eea',
						path: '/pages/contract-verify/index' // 跳转到合同验真页面
					}
				]
			}
		},
			methods: {
				async initializeHome(): Promise<void> {
					this.isLoggedIn = isLoggedIn();
					this.syncHomeTabBar();
					if (!this.isLoggedIn) {
						this.resetGuestHome();
						return;
					}

					try {
						await getSealToken();
					} catch (error) {
						console.error('[首页] sealToken 获取失败:', error);
					}
					this.loadIdentityFromStorage();
					await this.getUserInfo();
					this.loadContractSummary();
				},

				resetGuestHome(): void {
					this.showIdentityDropdown = false;
					this.currentIdentity = {
						type: 'personal',
						id: '',
						name: '个人',
						verified: false,
						role: ''
					};
					this.userInfo = { id: '', name: '', isVerified: false };
					this.enterprises = [];
					this.personalQuota = 0;
					this.enterpriseQuotaMap = {};
					this.statusData = [
						{ label: '签署中', count: 0, color: '#1890FF' },
						{ label: '填写表单', count: 0, color: '#FAAD14' },
						{ label: '已完成', count: 0, color: '#00C28A' }
					];
				},

				/**
				 * 原生 TabBar 会先切换页面再触发页面生命周期，无法做点击前鉴权。
				 * 游客态用首页内的可控导航替代，登录后恢复原生 TabBar。
				 */
				syncHomeTabBar(): void {
					if (this.isLoggedIn) {
						uni.showTabBar({ animation: false });
						return;
					}
					uni.hideTabBar({ animation: false });
				},

				handleGuestTabClick(path: string): void {
					if (path === '/pages/index/index') {
						return;
					}
					// 不显示延迟 Toast，直接打开登录页并保留回跳目标。
					requireLogin(path, false);
				},

				ensureLoggedIn(redirectUrl: string): boolean {
					return requireLogin(redirectUrl, true);
				},
			getSafeTop(): number {
				try {
					const sys: any = uni.getSystemInfoSync();
					let top = sys && sys.statusBarHeight ? Number(sys.statusBarHeight) : 0;
					const getMenuBtn: any = (uni as any).getMenuButtonBoundingClientRect;
					if (typeof getMenuBtn === 'function') {
						const rect: any = getMenuBtn();
						if (rect && rect.top) {
							top = Number(rect.top);
						}
					}
					return top;
				} catch (e) {
					return 0;
				}
			},
			// ========== 隐私协议相关方法 ==========
			
			/**
			 * 检查隐私协议同意状态
			 */
			checkPrivacyAgreement(): void {
				try {
					const privacyStatus = uni.getStorageSync('privacyAgreementStatus');
					if (!privacyStatus) {
						// 首次访问，显示隐私协议引导弹窗
						this.showPrivacyModal = true;
						console.log('[首页] 首次访问，显示隐私协议引导弹窗');
					} else if (privacyStatus === 'accepted') {
						console.log('[首页] 用户已同意隐私协议');
					} else if (privacyStatus === 'declined') {
						console.log('[首页] 用户已拒绝隐私协议');
					}
				} catch (error) {
					console.error('[首页] 检查隐私协议状态失败:', error);
				}
			},
			
			/**
			 * 用户同意隐私协议
			 */
			handlePrivacyAgree(): void {
				try {
					// 保存同意状态到本地存储
					uni.setStorageSync('privacyAgreementStatus', 'accepted');
					// 关闭弹窗
					this.showPrivacyModal = false;
					console.log('[首页] 用户已同意隐私协议');
					
					// 显示成功提示
					uni.showToast({
						title: '感谢您的信任',
						icon: 'success',
						duration: 1500
					});
				} catch (error) {
					console.error('[首页] 保存隐私协议同意状态失败:', error);
					uni.showToast({
						title: '操作失败，请重试',
						icon: 'none',
						duration: 2000
					});
				}
			},
			
			/**
			 * 用户不同意隐私协议
			 */
			handlePrivacyDisagree(): void {
				try {
					// 保存拒绝状态到本地存储
					uni.setStorageSync('privacyAgreementStatus', 'declined');
					// 关闭隐私协议弹窗
					this.showPrivacyModal = false;
					console.log('[首页] 用户不同意隐私协议，已关闭弹窗');
					
					// 显示提示信息
					uni.showToast({
						title: '您已拒绝隐私协议',
						icon: 'none',
						duration: 2000
					});
				} catch (error) {
					console.error('[首页] 保存隐私协议状态失败:', error);
				}
			},
			
			// ========== 功能点击相关方法 ==========
			
			/**
			 * 处理功能点击
			 */
			handleItemClick(item: any): void {
				// 如果是状态摘要项，跳转到合同管理页面并设置对应的状态筛选
				if (item.label === '签署中') {
					if (!this.ensureLoggedIn('/pages/contract-manage/index')) return;
					uni.switchTab({
						url: '/pages/contract-manage/index'
					});
					// 设置状态筛选参数
					uni.setStorageSync('contractStatus', ContractStatus.SIGNING);
					return;
				}
				
				if (item.label === '填写表单') {
					if (!this.ensureLoggedIn('/pages/contract-manage/index')) return;
					uni.switchTab({
						url: '/pages/contract-manage/index'
					});
					uni.setStorageSync('contractStatus', ContractStatus.FORM_FILLING);
					return;
				}
				
				if (item.label === '已完成') {
					if (!this.ensureLoggedIn('/pages/contract-manage/index')) return;
					uni.switchTab({
						url: '/pages/contract-manage/index'
					});
					uni.setStorageSync('contractStatus', ContractStatus.COMPLETED);
					return;
				}
				
				// 如果是快速发起项或特色服务项，检查是否有路径
				if (item.path) {
					if (!this.ensureLoggedIn(item.path)) return;
					uni.navigateTo({
						url: item.path
					})
					return
				}
				
				// 如果是热门模板项，跳转到模板详情页
				if (item.id != null && item.name) {
					const templateUrl = `/pages/template-detail/index?id=${item.id}`;
					if (!this.ensureLoggedIn(templateUrl)) return;
					uni.navigateTo({
						url: templateUrl
					});
					return;
				}
				
				// 默认提示
				uni.showToast({
					title: '功能开发中',
					icon: 'none'
				})
			},
			
			// 处理快速发起项点击（先检测H5服务，再跳转）
			async handleQuickStartClick(item: any): Promise<void> {
				const targetUrl = item.path || '/pages/template-market/index';
				if (!this.ensureLoggedIn(targetUrl)) return;

				// 批量发起已迁移到模板详情页面
				if (item.label === '批量发起') {
					uni.showModal({
						title: '功能已迁移',
						content: '批量发起功能已迁移至模板详情页面，请先选择模板后再进行批量发起。',
						confirmText: '去选模板',
						cancelText: '知道了',
						success: (res) => {
							if (res.confirm) {
								uni.navigateTo({ url: '/pages/template-market/index' });
							}
						}
					});
					return;
				}
				
				// 草稿发起功能暂未开放（通过 path 为 null 或 label 判断）
				if (item.label === '草稿发起' || !item.path) {
					uni.showToast({
						title: '该功能暂未开放，敬请期待',
						icon: 'none',
						duration: 2000
					});
					return;
				}
				
				// 检查当前身份的认证状态
				// 如果是个人身份且未实名认证，则提示用户先完成实名认证
				if (this.currentIdentity.type === 'personal' && !this.currentIdentity.verified) {
					uni.showModal({
						title: '请先实名认证',
						content: '为保障合同的法律效力，发起合同前需要完成实名认证。',
						confirmText: '去认证',
						cancelText: '取消',
						success: (res) => {
							if (res.confirm) {
								uni.navigateTo({ url: '/pages/kyc/personal/index' });
							}
						}
					});
					return;
				}
				
				// 如果是企业身份且企业未认证，则提示用户先完成企业认证
				if (this.currentIdentity.type === 'enterprise' && !this.currentIdentity.verified) {
					uni.showModal({
						title: '企业未认证',
						content: '当前企业尚未完成认证，无法发起合同。是否前往认证？',
						confirmText: '去认证',
						cancelText: '取消',
						success: (res) => {
							if (res.confirm) {
								// 跳转到企业认证页面
								uni.navigateTo({
									url: `/pages/kyc/enterprise/index?id=${this.currentIdentity.id}&name=${encodeURIComponent(this.currentIdentity.name)}`
								});
							}
						}
					});
					return;
				}
				
				// 模板发起不需要检测H5服务
				if (item.path === '/pages/template-market/index') {
					uni.navigateTo({ url: item.path });
					return;
				}
				
				// 文件发起、图片发起需要检测H5服务
				try {
					uni.showLoading({ title: '正在检测服务...', mask: true });
					
					// 步骤 1: 检查网络状态
					const networkResult = await checkNetworkStatus();
					if (!networkResult.success) {
						uni.hideLoading();
						uni.showModal({
							title: '网络异常',
							content: networkResult.errorMessage || '请检查网络连接后重试',
							showCancel: false
						});
						return;
					}
					
					// 步骤 2: 获取 H5 创建合同 URL
					uni.showLoading({ title: '正在连接服务...', mask: true });
					const type = item.path.includes('type=file') ? 'file' : 'image';
					
					// 获取当前选择的企业ID
					let enterpriseId: number | undefined = undefined;
					try {
						const savedIdentity = uni.getStorageSync('currentIdentity');
						if (savedIdentity) {
							const identity = JSON.parse(savedIdentity) as { type?: string; id?: number };
							if (identity && identity.type === 'enterprise' && identity.id) {
								enterpriseId = identity.id;
							}
						}
					} catch (e) {
						console.warn('[首页] 获取当前身份信息失败:', e);
					}
					
					let createUrl: string;
					try {
						createUrl = await getSealPageUrl('create', undefined, { type, enterpriseId });
					} catch (error) {
						uni.hideLoading();
						uni.showModal({
							title: '服务异常',
							content: '无法连接到创建服务\n请稍后重试或联系技术支持',
							showCancel: false
						});
						return;
					}
					
					// 步骤 3: 测试 H5 服务器可用性
					uni.showLoading({ title: '正在检测服务状态...', mask: true });
					const serviceResult = await testH5ServiceAvailability(createUrl, 8000);
					
					uni.hideLoading();
					
					if (!serviceResult.available) {
						uni.showModal({
							title: '签署服务暂时不可用',
							content: serviceResult.errorMessage || 'H5签署服务暂时无法访问\n请稍后重试或联系技术支持',
							showCancel: false
						});
						return;
					}
					
					// 步骤 4: 所有检测通过，跳转到创建页面
					uni.navigateTo({ url: item.path });
					
				} catch (error) {
					uni.hideLoading();
					uni.showModal({
						title: '检测失败',
						content: '无法完成服务检测\n请稍后重试',
						showCancel: false
					});
				}
			},
			
			// 处理特色服务点击
			handleFeatureClick(feature: any): void {
				if (!this.ensureLoggedIn(feature.path)) return;

				// 判断是否是 tabBar 页面
				const tabBarPages = [
					'/pages/index/index',
					'/pages/contract-manage/index',
					'/pages/profile/index'
				]
				
				if (tabBarPages.includes(feature.path)) {
					// tabBar 页面使用 switchTab
					uni.switchTab({
						url: feature.path
					})
				} else {
					// 普通页面使用 navigateTo
					uni.navigateTo({
						url: feature.path
					})
				}
			},
			
			// ========== 身份切换相关方法（复用个人中心逻辑）==========
			
			// 获取用户信息
			async getUserInfo(): Promise<void> {
				try {
					console.log('[首页] 开始获取用户信息...');
					const res = await get<any>('/api/v1/member/user/get');
					
					console.log('[首页] 获取用户信息成功:', JSON.stringify(res));
					
					// 更新用户信息
					this.userInfo = {
						id: res.id?.toString() || '',
						name: res.nickname || '未命名用户',
						isVerified: res.verifyStatus === 2
					};
					
					// 如果是首次加载且未从缓存加载，则设置默认身份
					if (!this.currentIdentity.id) {
						this.currentIdentity = {
							type: 'personal',
							id: this.userInfo.id,
							name: '个人',
							verified: this.userInfo.isVerified,
							role: ''
						};
						this.saveIdentityToStorage();
					} else if (this.currentIdentity.type === 'personal') {
						// 如果当前是个人身份，更新认证状态
						this.currentIdentity.verified = this.userInfo.isVerified;
						this.currentIdentity.id = this.userInfo.id;
						this.saveIdentityToStorage();
					}
					
					// 如果用户已认证，加载企业列表
					if (this.userInfo.isVerified) {
						this.loadEnterpriseList();
					}
				} catch (error) {
					console.error('[首页] 获取用户信息失败:', error);
				}
			},
			
			// 加载企业列表（后端驱动身份模型）
			// 后端根据 current_enterprise_id 字段返回 activeEnterprise：
			// - activeEnterprise 非 null → 企业模式
			// - activeEnterprise 为 null → 个人模式
			async loadEnterpriseList(): Promise<void> {
				try {
					console.log('[首页] 开始加载企业列表...');
					const response = await getEnterpriseList();
					
					console.log('[首页] 企业列表API响应:', response);
					
					if (response && response.list) {
						this.enterprises = response.list.map(item => ({
							id: item.id,
							name: item.name,
							verified: item.status === EnterpriseStatus.VERIFIED,
							role: this.mapRoleToText(item.role)
						}));
						console.log('[首页] 企业列表加载成功，企业数量:', this.enterprises.length);
						
						// ✅ 后端驱动：根据 activeEnterprise 确定当前身份
						const activeEnterprise = response.activeEnterprise;
						if (activeEnterprise != null) {
							// 后端返回了激活的企业 → 企业模式
							const matchedEnterprise = this.enterprises.find(e => e.id === activeEnterprise.id);
							if (matchedEnterprise) {
								this.currentIdentity = {
									type: 'enterprise',
									id: matchedEnterprise.id,
									name: matchedEnterprise.name,
									verified: matchedEnterprise.verified,
									role: matchedEnterprise.role
								};
								console.log('[首页] 后端驱动：恢复企业身份:', matchedEnterprise.name);
							} else {
								// 企业已失效，回退到个人模式
								this.currentIdentity = {
									type: 'personal',
									id: this.userInfo.id,
									name: '个人',
									verified: this.userInfo.isVerified,
									role: ''
								};
								console.log('[首页] 后端驱动：企业已失效，回退到个人模式');
							}
						} else {
							// activeEnterprise 为 null → 个人模式
							this.currentIdentity = {
								type: 'personal',
								id: this.userInfo.id,
								name: '个人',
								verified: this.userInfo.isVerified,
								role: ''
							};
							console.log('[首页] 后端驱动：当前为个人模式');
						}
						
						// 保存身份到本地存储（作为缓存）
						this.saveIdentityToStorage();
					}
				} catch (error) {
					console.error('[首页] 获取企业列表失败:', error);
				}
			},
			
			// 将API角色值映射为角色文本
			mapRoleToText(role: number): string {
				switch (role) {
					case 1:
						return '所有者';
					case 2:
						return '管理员';
					case 3:
						return '成员';
					default:
						return '成员';
				}
			},
			
			// 切换身份下拉菜单
			toggleIdentityDropdown(): void {
				if (!this.ensureLoggedIn('/pages/profile/index')) return;

				// 在用户未实名认证的情况下，不允许打开身份切换菜单
				if (!this.userInfo.isVerified) {
					uni.showToast({
						title: '请先完成实名认证',
						icon: 'none'
					});
					return;
				}
				this.showIdentityDropdown = !this.showIdentityDropdown;
				// 打开弹窗时加载所有身份的配额
				if (this.showIdentityDropdown) {
					this.loadAllQuotas();
				}
			},
			
			// 关闭身份下拉菜单
			closeIdentityDropdown(): void {
				this.showIdentityDropdown = false;
			},
			
			// 切换身份（后端驱动）
			async switchIdentity(type: string, enterprise: any = null): Promise<void> {
				try {
					if (type === 'personal') {
						// ✅ 先调用后端API，清除 current_enterprise_id
						await switchToPersonal();
						
						this.currentIdentity = {
							type: 'personal',
							id: this.userInfo.id || '',
							name: '个人',
							verified: this.userInfo.isVerified,
							role: ''
						};
						console.log('[首页] 切换到个人身份（已同步后端）');
					} else if (type === 'enterprise' && enterprise != null) {
						// ✅ 先调用后端API，保存 current_enterprise_id
						await switchEnterprise(enterprise.id as number);
						
						this.currentIdentity = {
							type: 'enterprise',
							id: enterprise.id,
							name: enterprise.name,
							verified: enterprise.verified,
							role: enterprise.role
						};
						console.log('[首页] 切换到企业身份（已同步后端）:', enterprise.name);
					}
					
					// 保存身份选择到本地存储（作为缓存）
					this.saveIdentityToStorage();
					
					// 🔧 清除 Seal-Token 缓存，下次 API 调用时会用新身份重新获取
					// 确保模板查询等使用正确的企业上下文
					clearSealToken();
					console.log('[首页] Seal-Token 缓存已清除（身份已变更）');
					
					// 关闭下拉菜单
					this.closeIdentityDropdown();
					
					// 刷新页面数据
					this.loadContractSummary();
					
					// 显示切换成功提示
					uni.showToast({
						title: '已切换到' + this.currentIdentity.name,
						icon: 'none',
						duration: 1500
					});
				} catch (error) {
					console.error('[首页] 切换身份失败:', error);
					uni.showToast({
						title: '切换身份失败，请重试',
						icon: 'none'
					});
				}
			},
			
			// 保存身份选择到本地存储
			saveIdentityToStorage(): void {
				uni.setStorageSync('currentIdentity', JSON.stringify(this.currentIdentity));
			},
			
			// 从本地存储加载身份
			loadIdentityFromStorage(): void {
				try {
					const savedIdentity = uni.getStorageSync('currentIdentity');
					if (savedIdentity) {
						const parsedIdentity = JSON.parse(savedIdentity) as { type: string; id: string; name: string; verified: boolean; role: string };
						
						if (parsedIdentity) {
							// 兼容旧数据
							if (parsedIdentity.type === 'personal' && parsedIdentity.name !== '个人') {
								parsedIdentity.name = '个人';
							}
							
							this.currentIdentity = parsedIdentity;
							console.log('[首页] 从本地存储加载身份:', this.currentIdentity.name);
						}
					}
				} catch (e) {
					console.error('[首页] 加载身份信息失败:', e);
				}
			},
			
			// 添加新企业
			addEnterprise(): void {
				this.closeIdentityDropdown();
				uni.navigateTo({
					url: '/pages/enterprise/add'
				});
			},
			
			// ========== 配额相关方法 ==========
			
			// 加载所有身份的配额（用于身份切换弹窗显示）
			async loadAllQuotas(): Promise<void> {
				// 先加载个人配额
				await this.loadPersonalQuota();
				
				// 如果配额功能已关闭，跳过加载企业配额
				if (!this.quotaEnabled) {
					return;
				}
				
				// 加载所有企业配额
				for (const enterprise of this.enterprises) {
					await this.loadEnterpriseQuota(enterprise.id);
				}
			},
			
			// 加载个人配额
			async loadPersonalQuota(): Promise<void> {
				try {
					const res = await getQuotaBalance();
					if (res != null) {
						// 检查配额功能是否启用
						if (res.enabled === false) {
							this.quotaEnabled = false;
							return;
						}
						this.personalQuota = res.balance || 0;
					}
				} catch (error) {
					console.warn('[首页] 加载个人配额失败', error);
				}
			},
			
			// 加载企业配额
			async loadEnterpriseQuota(enterpriseId: number): Promise<void> {
				try {
					const res = await getQuotaBalance(enterpriseId);
					if (res != null) {
						this.enterpriseQuotaMap[enterpriseId.toString()] = res.balance || 0;
					}
				} catch (error) {
					console.warn(`[首页] 加载企业${enterpriseId}配额失败`, error);
				}
			},
			
			// 获取企业配额
			getEnterpriseQuota(enterpriseId: number): number {
				return this.enterpriseQuotaMap[enterpriseId.toString()] || 0;
			},
			
			/**
			 * 加载合同统计数据（真实API）
			 */
			async loadContractSummary(isPullDown: boolean = false): Promise<void> {
				if (this.isLoading) return;
				
				this.isLoading = true;
				
				try {
					// 调用真实API获取统计数据
					const stats: ContractStatistics = await getContractStatistics();
					
					console.log('合同统计数据:', stats);
					
					// 更新状态摘要数据
					this.statusData = [
						{ label: '签署中', count: stats.signingCount || 0, color: '#1890FF' },
						{ label: '填写表单', count: stats.formFillingCount || 0, color: '#FAAD14' },
						{ label: '已完成', count: stats.completedCount || 0, color: '#00C28A' }
					];
					
					console.log('统计数据加载成功');
					
				} catch (error) {
					console.error('加载合同统计失败:', error);
					uni.showToast({
						title: '数据加载失败',
						icon: 'none'
					});
				} finally {
					this.isLoading = false;
					
					// 如果是下拉刷新，停止刷新动画
					if (isPullDown) {
						uni.stopPullDownRefresh();
					}
				}
			}
		}
	}
</script>

<template>
	<view class="contract-app">
		<!-- 移除全局层级的红点标记，避免读取hasNotification属性错误 -->
		
		<scroll-view scroll-y="true" class="content">
			<!-- 顶部导航栏 -->
			<view class="header" :style="{ '--safe-top': safeTop + 'px' }">
				<view class="header-dropdown-container">
					<view class="header-dropdown" @click="toggleIdentityDropdown">
						<text class="header-dropdown-text">{{ currentIdentity.type === 'personal' ? '个人' : '企业' }}</text>
						<text class="header-dropdown-icon">{{ showIdentityDropdown ? '▲' : '▼' }}</text>
					</view>
				</view>
				
				<text class="header-title">{{appName}}</text>
			</view>
			
			<!-- 身份切换弹窗遮罩 -->
			<view v-if="showIdentityDropdown" class="identity-mask" @click="closeIdentityDropdown"></view>
			
			<!-- 身份切换弹窗 -->
			<view v-if="showIdentityDropdown" class="identity-dropdown-container">
				<view class="identity-dropdown">
					<view class="dropdown-header">
						<text class="dropdown-title">切换身份</text>
					</view>
					
					<!-- 个人身份 -->
					<view class="dropdown-section">
						<text class="section-label">个人</text>
					</view>
					<view class="identity-option" :class="{ active: currentIdentity.type === 'personal' }" @click="switchIdentity('personal')">
						<view class="option-left">
							<view class="option-info">
								<view class="option-name-row">
									<text class="option-name">个人身份</text>
								</view>
								<view class="option-status-row">
									<view class="option-verified" v-if="userInfo.isVerified">
										<text class="fa fa-check-circle verified-icon"></text>
										<text class="verified-text-small">已认证</text>
									</view>
									<view class="option-unverified" v-else>
										<text class="fa fa-exclamation-circle unverified-icon"></text>
										<text class="unverified-text">未认证</text>
									</view>
									<!-- 配额显示 -->
									<view v-if="quotaEnabled" class="quota-badge" :class="{ 'quota-low': personalQuota <= 5 }">
										<text class="fa fa-file-text quota-icon"></text>
										<text class="quota-text">{{ personalQuota }}份</text>
									</view>
								</view>
							</view>
						</view>
						<view class="option-right">
							<text v-if="currentIdentity.type === 'personal'" class="option-check">✓</text>
						</view>
					</view>
					
					<!-- 企业身份 -->
					<view class="dropdown-section" v-if="enterprises.length > 0">
						<text class="section-label">企业身份</text>
					</view>
					<view v-if="enterprises.length > 0">
						<view v-for="(enterprise, index) in enterprises" :key="index" class="identity-option" :class="{ active: currentIdentity.type === 'enterprise' && currentIdentity.id === enterprise.id }" @click="switchIdentity('enterprise', enterprise)">
							<view class="option-left">
								<view class="option-info">
									<view class="option-name-row">
										<text class="option-name">{{ enterprise.name }}</text>
										<view class="option-role">
											<text class="role-text-small">{{ enterprise.role }}</text>
										</view>
									</view>
									<view class="option-status-row">
										<view v-if="enterprise.verified" class="option-verified">
											<text class="fa fa-check-circle verified-icon"></text>
											<text class="verified-text-small">已认证</text>
										</view>
										<view v-else class="option-unverified">
											<text class="fa fa-exclamation-circle unverified-icon"></text>
											<text class="unverified-text">立即认证</text>
										</view>
										<!-- 配额显示 -->
										<view v-if="quotaEnabled" class="quota-badge" :class="{ 'quota-low': getEnterpriseQuota(enterprise.id) <= 5 }">
											<text class="fa fa-file-text quota-icon"></text>
											<text class="quota-text">{{ getEnterpriseQuota(enterprise.id) }}份</text>
										</view>
									</view>
								</view>
							</view>
							<view class="option-right">
								<text v-if="currentIdentity.type === 'enterprise' && currentIdentity.id === enterprise.id" class="option-check">✓</text>
							</view>
						</view>
					</view>
					
					<!-- 添加新企业 -->
					<view class="add-enterprise" @click="addEnterprise">
						<text class="add-icon">+</text>
						<text class="add-text">添加新企业</text>
					</view>
				</view>
			</view>
			
			<!-- 快速发起合同 - 调整位置使其悬浮在绿色背景上 -->
			<view class="card quick-start quick-start-floating">
				<text class="section-title">快速发起</text>
				<view class="quick-start-grid">
					<view 
						v-for="(item, index) in quickStartItems" 
						:key="index" 
						class="quick-start-item"
						@click="handleQuickStartClick(item)"
					>
						<image class="quick-start-icon" :src="item.icon" mode="aspectFit"></image>
						<text class="quick-start-label">{{ item.label }}</text>
					</view>
				</view>
			</view>
			
			<!-- 状态摘要 -->
			<view class="card status-summary">
				<view class="status-grid">
					<view 
						v-for="(item, index) in statusData" 
						:key="index" 
						class="status-item"
						@click="handleItemClick(item)"
					>
						<!-- 极简状态项结构 -->
						<view class="status-count-wrapper">
							<text class="status-count" :style="{ color: item.color }">{{ item.count }}</text>
							<view class="notification-indicator" v-if="item.count > 0"></view>
						</view>
						<text class="status-label">{{ item.label }}</text>
					</view>
				</view>
			</view>
			
			<!-- 热门模板 -->
			<view class="card hot-templates">
				<view class="templates-header">
					<text class="section-title">热门模板</text>
					<image class="official-tag" src="/static/templates/official-tag.png" mode="aspectFit"></image>
				</view>
				
				<view class="templates-main">
					<view class="templates-left" @click="handleItemClick(templates[0])">
						<image class="template-image" :src="templates[0].image" mode="aspectFit"></image>
					</view>
					<view class="templates-right-simplified">
						<view class="position-relative full-height">
							<image class="template-image-direct top-image" :src="templates[1].image" mode="aspectFit" @click="handleItemClick(templates[1])"></image>
							<image class="template-image-direct bottom-image" :src="templates[2].image" mode="aspectFit" @click="handleItemClick(templates[2])"></image>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 特色服务 -->
			<view class="card features">
				<text class="section-title">特色服务</text>
				<view class="features-list">
					<view 
						v-for="(feature, index) in features" 
						:key="index" 
						class="feature-item"
						@click="handleFeatureClick(feature)"
					>
						<view class="feature-icon-container" :style="{ backgroundColor: feature.iconColor + '10' }">
							<text class="fa feature-fa-icon" :class="feature.faIcon" :style="{ color: feature.iconColor }"></text>
						</view>
							<view class="feature-content">
								<view class="feature-title-row">
									<text class="feature-name">{{ feature.name }}</text>
									<text v-if="feature.aiBadge != ''" class="feature-ai-badge">{{ feature.aiBadge }}</text>
								</view>
								<text class="feature-description">{{ feature.description }}</text>
						</view>
						<view class="feature-arrow-container">
							<text class="feature-arrow">›</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 版权信息 -->
			<view class="copyright-section">
				<text class="copyright-title">{{copyrightSlogan}}</text>
				<text class="copyright-text">{{copyrightOwnerText}}</text>
			</view>
			
			<!-- 底部占位，防止内容被TabBar遮挡 -->
			<view class="bottom-placeholder" :class="{ 'guest-bottom-placeholder': !isLoggedIn }"></view>
		</scroll-view>

		<!-- 游客导航：点击受保护项时在页面切换前进入登录页 -->
		<view v-if="!isLoggedIn" class="guest-tab-bar">
			<view class="guest-tab-item guest-tab-item-active" @click="handleGuestTabClick('/pages/index/index')">
				<image class="guest-tab-icon" src="/static/tabbar/home-active.png" mode="aspectFit"></image>
				<text class="guest-tab-text guest-tab-text-active">首页</text>
			</view>
			<view class="guest-tab-item" @click="handleGuestTabClick('/pages/contract-manage/index')">
				<image class="guest-tab-icon" src="/static/tabbar/contract.png" mode="aspectFit"></image>
				<text class="guest-tab-text">合同管理</text>
			</view>
			<view class="guest-tab-item" @click="handleGuestTabClick('/pages/profile/index')">
				<image class="guest-tab-icon" src="/static/tabbar/profile.png" mode="aspectFit"></image>
				<text class="guest-tab-text">个人中心</text>
			</view>
		</view>
		
		<!-- 隐私协议引导弹窗 -->
		<PrivacyGuideModal 
			:show="showPrivacyModal" 
			@agree="handlePrivacyAgree" 
			@disagree="handlePrivacyDisagree"
		/>
	</view>
</template>

<style>
	/* 引入FontAwesome - 确保图标正确显示 */
	@import url("../../static/styles/fontawesome.css");
	
	/* 全局样式变量 */
	.contract-app {
		flex: 1;
		background-color: #F7F9FC;
	}
	
	/* 内容区域 */
	.content {
		flex: 1;
	}
	
	/* 顶部导航栏 */
	.header {
		height: 300rpx;
		background-image: linear-gradient(to bottom, #00C28A, #00C28A 70%, rgba(0, 194, 138, 0.8));
		padding: 60rpx 32rpx 20rpx;
		flex-direction: row;
		align-items: flex-start;
		justify-content: center;
		position: relative;
		padding-top: calc(60rpx + var(--safe-top));
	}
	
	.header-dropdown-container {
		position: absolute;
		top: calc(60rpx + var(--safe-top));
		left: 32rpx;
		z-index: 100;
	}
	
	.header-dropdown {
		flex-direction: row;
		align-items: center;
		background-color: rgba(255, 255, 255, 0.2);
		padding: 8rpx 16rpx;
		border-radius: 30rpx;
		max-width: 280rpx;
	}
	
	.header-dropdown-text {
		color: #FFFFFF;
		font-size: 24rpx;
		margin-right: 8rpx;
		max-width: 220rpx;
		overflow: hidden;
		text-overflow: ellipsis;
		lines: 1;
	}
	
	.header-dropdown-icon {
		color: #FFFFFF;
		font-size: 20rpx;
	}
	
	.header-title {
		color: #FFFFFF;
		font-size: 32rpx;
		font-weight: 500;
	}
	
	/* ========== 身份切换弹窗样式 ========== */
	
	/* 遮罩层 */
	.identity-mask {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.5);
		z-index: 999;
	}
	
	/* 弹窗容器 */
	.identity-dropdown-container {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1000;
	}
	
	/* 弹窗主体 */
	.identity-dropdown {
		background-color: #FFFFFF;
		border-top-left-radius: 40rpx;
		border-top-right-radius: 40rpx;
		padding: 40rpx 32rpx;
		max-height: 80vh;
	}
	
	/* 弹窗标题 */
	.dropdown-header {
		align-items: center;
		margin-bottom: 24rpx;
		padding-bottom: 24rpx;
		border-bottom-width: 1rpx;
		border-bottom-color: #F8F8F8;
	}
	
	.dropdown-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #333333;
	}
	
	/* 分组标题 */
	.dropdown-section {
		margin-top: 32rpx;
		margin-bottom: 16rpx;
		padding-left: 12rpx;
	}
	
	.section-label {
		font-size: 26rpx;
		color: #999999;
		font-weight: 500;
	}
	
	/* 身份选项 */
	.identity-option {
		flex-direction: row;
		align-items: center;
		padding: 32rpx 28rpx;
		background-color: #FFFFFF;
		border-radius: 20rpx;
		margin-bottom: 20rpx;
		border-width: 1rpx;
		border-color: #EEEEEE;
		box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
	}
	
	.identity-option.active {
		background-color: rgba(0, 194, 138, 0.04);
		border-width: 2rpx;
		border-color: #00C28A;
	}
	
	.option-left {
		flex: 1;
		flex-direction: row;
		align-items: center;
		min-width: 0;
		margin-right: 20rpx;
	}
	
	.option-info {
		flex: 1;
		min-width: 0;
	}
	
	.option-name-row {
		flex-direction: row;
		align-items: center;
		margin-bottom: 8rpx;
	}
	
	.option-name {
		font-size: 30rpx;
		font-weight: 600;
		color: #333333;
		margin-right: 12rpx;
		lines: 1;
		text-overflow: ellipsis;
		flex: 1;
		min-width: 0;
	}
	
	/* 角色标签 - 蓝色系，与认证状态区分 */
	.option-role {
		background-color: rgba(24, 144, 255, 0.1);
		padding: 4rpx 12rpx;
		border-radius: 6rpx;
		flex-shrink: 0;
		margin-left: 12rpx;
	}
	
	.role-text-small {
		font-size: 20rpx;
		color: #1890FF;
		font-weight: 500;
	}
	
	.option-status-row {
		flex-direction: row;
