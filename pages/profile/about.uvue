<script>
	import { APP_NAME, APP_VERSION, APP_BUILD_NUMBER, APP_DESCRIPTION, APP_OFFICIAL_WEBSITE, APP_SERVICE_EMAIL, APP_SERVICE_PHONE, getCopyrightText } from '../../config/app.config';
	
	/**
	 * 关于页面
	 */
	export default {
		data() {
			return {
				appInfo: {
					name: APP_NAME,
					logo: '/static/logo.png',
					version: APP_VERSION,
					buildNumber: APP_BUILD_NUMBER,
					description: APP_DESCRIPTION,
					features: [
						'快速创建合同',
						'多人在线签署',
						'安全合规认证',
						'便捷合同管理',
						'实时通知提醒'
					],
					contact: {
						website: APP_OFFICIAL_WEBSITE,
						email: APP_SERVICE_EMAIL,
						phone: APP_SERVICE_PHONE
					},
					copyright: getCopyrightText()
				}
			}
		},
		methods: {
			// 返回上一页
			goBack(): void {
				uni.navigateBack();
			},
			
			// 复制文本
			copyText(text: string): void {
				uni.setClipboardData({
					data: text,
					success: function() {
						uni.showToast({
							title: '复制成功',
							icon: 'success'
						});
					}
				});
			},
			
			// 跳转到用户协议
			goToUserAgreement(): void {
				uni.navigateTo({
					url: '/pages/agreement/user'
				});
			},
			
			// 跳转到隐私政策
			goToPrivacyPolicy(): void {
				uni.navigateTo({
					url: '/pages/agreement/privacy'
				});
			},
			
			// 访问官网
			visitWebsite(): void {
				// H5/公众号环境打开官网；其它端复制地址兜底。
				// #ifdef H5
				window.location.href = this.appInfo.contact.website;
				// #endif
				// #ifndef H5
				this.copyText(this.appInfo.contact.website);
				// #endif
			}
		}
	}
</script>

<template>
	<view class="container">
		<!-- 关于我们内容 -->
		<view class="content-section">
			<view class="logo-section">
				<image class="app-logo" :src="appInfo.logo" mode="aspectFit"></image>
				<text class="app-name">{{appInfo.name}}</text>
				<text class="app-version">{{appInfo.version}} ({{appInfo.buildNumber}})</text>
			</view>
			
			<!-- 应用描述 -->
			<view class="app-description">
				<text class="description-text">{{appInfo.description}}</text>
			</view>
			
			<!-- 功能特点 -->
			<view class="feature-section">
				<view class="section-title">
					<text class="title-text">功能特点</text>
				</view>
				<view class="feature-list">
					<view v-for="(feature, index) in appInfo.features" :key="index" class="feature-item">
						<text class="feature-icon">•</text>
						<text class="feature-text">{{feature}}</text>
					</view>
				</view>
			</view>
			
			<!-- 联系我们 -->
			<view class="contact-section">
				<view class="section-title">
					<text class="title-text">联系我们</text>
				</view>
				<view class="contact-list">
					<view class="contact-item" @click="visitWebsite">
						<text class="contact-label">官方网站</text>
						<view class="contact-value-container">
							<text class="contact-value">{{appInfo.contact.website}}</text>
							<text class="contact-action">访问</text>
						</view>
					</view>
					<view class="contact-item" @click="copyText(appInfo.contact.email)">
						<text class="contact-label">电子邮箱</text>
						<view class="contact-value-container">
							<text class="contact-value">{{appInfo.contact.email}}</text>
							<text class="contact-action">复制</text>
						</view>
					</view>
					<view class="contact-item" @click="copyText(appInfo.contact.phone)">
						<text class="contact-label">客服热线</text>
						<view class="contact-value-container">
							<text class="contact-value">{{appInfo.contact.phone}}</text>
							<text class="contact-action">复制</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 用户协议和隐私政策 -->
			<view class="agreement-section">
				<view class="agreement-item" @click="goToUserAgreement">
					<text class="agreement-text">用户协议</text>
					<text class="icon icon-right"></text>
				</view>
				<view class="agreement-item" @click="goToPrivacyPolicy">
					<text class="agreement-text">隐私政策</text>
					<text class="icon icon-right"></text>
				</view>
			</view>
			
			<!-- 版权信息 -->
			<view class="copyright">
				<text class="copyright-text">{{appInfo.copyright}}</text>
			</view>
		</view>
	</view>
</template>

