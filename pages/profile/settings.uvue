		justify-content: center;
		z-index: 999;
	}
	
	.modal-container {
		width: 620rpx;
		background-color: #FFFFFF;
		border-radius: 20rpx;
		overflow: hidden;
		box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
	}
	
	.modal-header {
		padding: 40rpx 32rpx 32rpx 32rpx;
		align-items: center;
		justify-content: center;
		border-bottom: none;
	}
	
	.modal-title {
		font-size: 36rpx;
