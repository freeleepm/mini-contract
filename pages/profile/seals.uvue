.fa {
	font-family: 'Font Awesome 6 Free';
	font-size: 26rpx;
	font-style: normal;
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
	font-weight: 900;
}

.icon {
	font-family: 'Font Awesome 6 Free';
}

.icon-plus:before { content: "\f067"; }
