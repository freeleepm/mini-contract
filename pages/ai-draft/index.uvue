<template>
  <view class="page-container">
    <!-- 顶部区域 -->
    <view class="header-section">
      <view class="header-bg-decor"></view>
      <view class="header-content">
        <view class="header-text-group">
          <text class="header-title">AI 智能起草</text>
          <text class="header-subtitle">对话式合同生成，专业高效</text>
        </view>
        <view class="header-stats" v-if="templateList.length > 0">
          <view class="stat-item">
            <text class="stat-num">{{ templateList.length }}</text>
            <text class="stat-label">合同模板</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-num">{{ conversationList.length }}</text>
            <text class="stat-label">近期对话</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 内容滚动区域 -->
    <scroll-view class="content-scroll" scroll-y="true">
      <view class="content-wrapper">

        <!-- AI 生成服务显著说明，用于小程序用户告知与审核 -->
        <view class="ai-disclosure-card">
          <view class="ai-disclosure-badge">
            <text class="ai-disclosure-badge-text">AI生成</text>
          </view>
          <view class="ai-disclosure-content">
            <text class="ai-disclosure-title">人工智能生成服务</text>
            <text class="ai-disclosure-text">本功能使用人工智能生成合同内容，生成结果仅供参考，不构成法律意见，请您核对确认后使用。</text>
          </view>
        </view>

        <!-- 推荐话术 -->
        <view class="section">
          <view class="section-header">
            <view class="section-title-group">
              <text class="section-title">推荐话术</text>
              <text class="section-subtitle">选择一个话术快速开始</text>
            </view>
          </view>

          <view class="template-grid">
            <view
              v-for="(template, index) in templateList"
              :key="template.id"
              class="template-card"
              @click="handleTemplateClick(template)"
            >
              <view class="template-card-top">
                <view class="template-icon" :class="getIconColorClass(index)">
                  <text class="icon" :class="getIconName(index)"></text>
                </view>
                <view class="template-badge" v-if="template.useCount > 0">
                  <text class="badge-text">{{ template.useCount }}次</text>
                </view>
              </view>
              <text class="template-title">{{ template.title }}</text>
              <text class="template-desc">{{ template.description }}</text>
            </view>
          </view>
        </view>

        <!-- 最近对话 -->
        <view class="section">
          <view class="section-header">
            <view class="section-title-group">
              <text class="section-title">最近对话</text>
            </view>
            <view class="section-action" @click="handleViewAllHistory">
              <text class="action-text">查看全部</text>
              <text class="icon icon-chevron-right"></text>
            </view>
          </view>

          <view class="conversation-list" v-if="conversationList.length > 0">
            <view
              v-for="conversation in conversationList"
              :key="conversation.id"
              class="conversation-card"
              @click="handleConversationClick(conversation)"
            >
              <view class="conv-left">
                <view class="conv-indicator" :class="getConvStatusClass(conversation.status)"></view>
                <view class="conv-info">
                  <text class="conv-title">{{ conversation.title }}</text>
                  <view class="conv-meta">
                    <text class="conv-status" :class="getConvStatusClass(conversation.status)">{{ getStatusText(conversation.status) }}</text>
                    <text class="conv-dot">·</text>
                    <text class="conv-messages">{{ conversation.totalMessages }}条消息</text>
                  </view>
                </view>
              </view>
              <view class="conv-right">
                <text class="conv-time">{{ formatTime(conversation.lastMessageTime) }}</text>
                <text class="icon icon-chevron-right conv-arrow"></text>
              </view>
            </view>
          </view>

          <!-- 空状态 -->
          <view class="empty-state" v-else>
            <view class="empty-icon-wrapper">
              <text class="icon icon-chat-empty"></text>
            </view>
            <text class="empty-text">{{ loadError ? '加载失败' : '暂无对话记录' }}</text>
            <text class="empty-hint">{{ loadError ? '请检查网络连接' : '选择话术或点击下方按钮开始' }}</text>
            <view v-if="loadError" class="retry-btn" @click="loadData">
              <text class="icon icon-refresh"></text>
              <text class="retry-text">重试</text>
            </view>
          </view>
        </view>

        <view class="safe-bottom"></view>
      </view>
    </scroll-view>

    <!-- 底部按钮 -->
    <view class="fixed-footer">
      <view class="action-button" @click="handleStartNewChat">
        <text class="icon icon-plus btn-icon"></text>
        <text class="btn-text">开始新对话</text>
      </view>
    </view>
  </view>
</template>

<script>
import { getTemplateList, getConversationPage, createConversation, incrementTemplateUse } from '../../api/ai-draft/index.uts'

// 模板项接口定义
interface TemplateItem {
  id: number;
  title: string;
  description: string;
  useCount: number;
  contractType?: string;
  prompt?: string;
}

// 对话项接口定义
interface ConversationItem {
  id: number;
  title: string;
  lastMessageTime: string;
  status: number;
  totalMessages: number;
}

export default {
  data() {
    return {
      templateList: [] as TemplateItem[],
      conversationList: [] as ConversationItem[],
      loading: false,
      loadError: false,
      iconColors: ['blue', 'green', 'orange', 'purple', 'cyan', 'red'] as string[],
      iconNames: ['icon-file-contract', 'icon-cart', 'icon-handshake', 'icon-shield', 'icon-briefcase', 'icon-file-text'] as string[]
    }
  },
  onLoad() {
    this.loadData()
  },
  onShow() {
    if (!this.loading) {
      this.loadData()
    }
  },
  methods: {
    getIconColorClass(index: number): string {
      return this.iconColors[index % this.iconColors.length]
    },
    getIconName(index: number): string {
      return this.iconNames[index % this.iconNames.length]
    },
    getConvStatusClass(status: number): string {
      if (status === 0) return 'status-active'
      if (status === 1) return 'status-done'
      if (status === 2) return 'status-signed'
      return ''
    },
    async loadData() {
      this.loading = true
      this.loadError = false
      
      try {
        const templatesRes = await getTemplateList()
        if (templatesRes.code === 0 || templatesRes.code === 200) {
          this.templateList = (templatesRes.data || []) as TemplateItem[]
        } else {
          this.templateList = []
        }

        const conversationsRes = await getConversationPage({
          pageNo: 1,
          pageSize: 3
        })
        if (conversationsRes.code === 0 || conversationsRes.code === 200) {
          const data = (conversationsRes.data as { total?: number; list?: ConversationItem[] }) || { total: 0, list: [] }
          this.conversationList = (data.list || []) as ConversationItem[]
        } else {
          this.conversationList = []
        }
      } catch (error: any) {
        console.error('加载数据失败:', error)
        this.loadError = true
        uni.showToast({
          title: '加载失败，请检查网络',
          icon: 'none',
          duration: 2000
        })
      } finally {
        this.loading = false
      }
    },
    
    async handleTemplateClick(template: TemplateItem) {
      uni.showLoading({ title: '创建对话中...', mask: true })
      
      try {
        await incrementTemplateUse(template.id)
        const res = await createConversation({
          title: template.title,
          contractType: template.contractType
        })
        
        uni.hideLoading()
        
        if (res.code === 0 || res.code === 200) {
          uni.navigateTo({
            url: `/pages/ai-draft/chat?conversationId=${res.data}&prompt=${encodeURIComponent(template.prompt || template.description)}`,
            fail: () => {
              uni.showToast({ title: '页面跳转失败', icon: 'none' })
            }
          })
        } else {
          uni.showToast({ title: res.msg || '创建对话失败', icon: 'none', duration: 2000 })
        }
      } catch (error: any) {
        uni.hideLoading()
        uni.showToast({ title: '网络异常，请重试', icon: 'none', duration: 2000 })
      }
    },
    
    handleConversationClick(conversation: ConversationItem) {
      uni.navigateTo({
        url: `/pages/ai-draft/chat?conversationId=${conversation.id}`
      })
    },
    
    async handleStartNewChat() {
      uni.showLoading({ title: '创建中...', mask: true })
      
      try {
        const res = await createConversation({ title: '新对话' })
        uni.hideLoading()
        
        if (res.code === 0 || res.code === 200) {
          uni.navigateTo({
            url: `/pages/ai-draft/chat?conversationId=${res.data}`,
            fail: () => {
              uni.showToast({ title: '页面跳转失败', icon: 'none' })
            }
          })
        } else {
          uni.showToast({ title: res.msg || '创建失败', icon: 'none', duration: 2000 })
        }
      } catch (error) {
        uni.hideLoading()
        uni.showToast({ title: '网络异常，请重试', icon: 'none', duration: 2000 })
      }
    },
    
    handleViewAllHistory() {
      uni.navigateTo({ url: '/pages/ai-draft/history' })
    },
    
    getStatusText(status: number) {
      const statusMap: Record<number, string> = {
        0: '进行中',
        1: '已生成',
        2: '已签署'
      };
      return statusMap[status] || '未知';
    },
    
    formatTime(time: string): string {
      if (!time) return ''
      const date = new Date(time)
      const now = new Date()
      const diff = now.getTime() - date.getTime()
      
      if (diff < 60000) return '刚刚'
      if (diff < 3600000) return Math.floor(diff / 60000) + '分钟前'
      if (diff < 86400000) return Math.floor(diff / 3600000) + '小时前'
      return date.toLocaleDateString()
    }
  }
}
</script>

<style>
