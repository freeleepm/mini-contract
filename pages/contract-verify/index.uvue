<template>
    <view class="page-container">
        <scroll-view class="content-scroll" scroll-y="true">
            <view class="content-wrapper">
                
                <!-- 初始状态 -->
                <view class="verify-init-section" v-if="!verificationResult">
                    
                    <!-- 1. 上传区域：精致的虚线卡片 -->
                    <view class="upload-card" @click="chooseFile" :class="{ 'file-selected': selectedFileName }">
                        <view class="upload-inner">
                            <!-- 图标区 -->
                            <view class="upload-icon-box">
                                <text class="icon" :class="selectedFileName ? 'icon-file-pdf' : 'icon-cloud-upload'"></text>
                            </view>
                            
                            <!-- 文字区 -->
                            <view class="upload-text-area">
                                <text class="upload-title">{{ selectedFileName || '点击上传 PDF 合同' }}</text>
                                <text class="upload-desc" v-if="!selectedFileName">支持 50MB 以内的 PDF 文件</text>
                                <text class="upload-desc active" v-else>点击更换文件</text>
                            </view>
                        </view>
                        
                        <!-- 底部装饰条 -->
                        <view class="upload-bar"></view>
                    </view>

                    <!-- 2. 验证能力说明：清爽的列表 -->
                    <view class="section-container">
                        <view class="section-header-group">
                            <text class="section-head">验证内容</text>
                            <text class="section-desc">支持验证电子签名的有效性与文档完整性</text>
                        </view>
                        <view class="feature-list">
                            <view class="feature-row">
                                <view class="feature-icon blue">
                                    <text class="icon icon-file-check"></text>
                                </view>
                                <view class="feature-text">
                                    <text class="f-title">文件完整性</text>
                                    <text class="f-desc">校验文件 Hash 值，确保内容未被篡改</text>
                                </view>
                            </view>
                            <view class="feature-row">
                                <view class="feature-icon green">
                                    <text class="icon icon-signature"></text>
                                </view>
                                <view class="feature-text">
                                    <text class="f-title">数字签名</text>
                                    <text class="f-desc">验证签名数据的加密有效性</text>
                                </view>
                            </view>
                            <view class="feature-row">
                                <view class="feature-icon orange">
                                    <text class="icon icon-certificate"></text>
                                </view>
                                <view class="feature-text">
                                    <text class="f-title">证书校验</text>
                                    <text class="f-desc">验证 CA 证书的有效期与信任链</text>
                                </view>
                            </view>
                        </view>
                    </view>
                    
                    <!-- 剩余次数 -->
                    <view class="quota-info" v-if="remainingRequests !== null">
                        <text class="quota-label">今日剩余验证次数：</text>
                        <text class="quota-val">{{ remainingRequests }}</text>
                    </view>
                    
                </view>

                <!-- 验证结果状态 -->
                <view class="verify-result-section" v-else>
                    <!-- 1. 结果总览卡片 -->
                    <view class="result-summary-card">
                        <view class="status-badge" :class="statusClass">
                            <text class="icon" :class="statusIconClass"></text>
                        </view>
                        <text class="summary-title">{{ verificationResult.verificationStatusText }}</text>
                        <text class="summary-desc">{{ statusDescription }}</text>
                        <view class="summary-divider"></view>
                        <view class="verify-meta">
                            <text class="meta-label">验证时间</text>
                            <text class="meta-val">{{ getCurrentTime() }}</text>
                        </view>
                    </view>

                    <!-- 2. 验证详情 -->
                    <view class="section-container">
                        <text class="section-head">验证详情</text>
                        <view class="detail-list">
                            <view class="detail-item">
                                <view class="d-left">
                                    <text class="icon icon-file d-icon"></text>
                                    <text class="d-label">文件完整性</text>
                                </view>
                                <view class="d-right">
                                    <text class="status-tag" :class="verificationResult.hashResult.status ? 'tag-success' : 'tag-error'">
                                        {{ verificationResult.hashResult.status ? '通过' : '失败' }}
                                    </text>
                                </view>
                            </view>
                            <view class="detail-item">
                                <view class="d-left">
                                    <text class="icon icon-signature d-icon"></text>
                                    <text class="d-label">数字签名</text>
                                </view>
                                <view class="d-right">
                                    <text class="status-tag" :class="verificationResult.signatureResult.status ? 'tag-success' : 'tag-error'">
                                        {{ verificationResult.signatureResult.status ? '有效' : '无效' }}
                                    </text>
                                </view>
                            </view>
                            <view class="detail-item">
                                <view class="d-left">
                                    <text class="icon icon-certificate d-icon"></text>
                                    <text class="d-label">证书校验</text>
                                </view>
                                <view class="d-right">
                                    <text class="status-tag" :class="verificationResult.certificateResult.status ? 'tag-success' : 'tag-error'">
                                        {{ verificationResult.certificateResult.status ? '有效' : '无效' }}
                                    </text>
                                </view>
                            </view>
                        </view>
                    </view>

                    <!-- 3. 签署方信息 -->
                    <view class="section-container" v-if="verificationResult.signers && verificationResult.signers.length > 0">
                        <view class="section-head-row">
                            <text class="section-head">签署方</text>
                            <text class="head-badge">{{ verificationResult.signers.length }}</text>
                        </view>
                        
                        <view class="signer-list">
                            <view class="signer-block" v-for="(signer, index) in verificationResult.signers" :key="index">
                                <view class="signer-header">
                                    <view class="signer-avatar" :style="{ backgroundColor: getAvatarColor(index) }">
                                        <text class="avatar-text">{{ signer.name.substring(0, 1) }}</text>
                                    </view>
                                    <view class="signer-basic">
                                        <text class="signer-name">{{ signer.name }}</text>
                                        <view class="role-pill">
                                            <text class="role-text">{{ signer.role }}</text>
                                        </view>
                                    </view>
                                </view>
                                <view class="signer-meta">
                                    <text class="meta-key">签署时间</text>
                                    <text class="meta-value">{{ formatSignTime(signer.signTime) }}</text>
                                </view>
                            </view>
                        </view>
                    </view>

                    <!-- 4. 平台认证 -->
                    <view class="platform-auth" v-if="verificationResult.isPlatformSigned">
                        <text class="icon icon-shield-check auth-icon"></text>
                        <text class="auth-text">{{platformAuthText}}</text>
                    </view>
                </view>

                <view class="safe-bottom"></view>
            </view>
        </scroll-view>

        <!-- 底部固定按钮 -->
        <view class="fixed-footer">
            <view 
                v-if="!verificationResult"
                class="action-button primary"
                :class="{ 'disabled': !selectedFilePath || loading }"
                @click="handleVerify"
            >
                <text class="btn-text">{{ loading ? '正在验证...' : '开始验证' }}</text>
            </view>
            <view v-else class="action-button secondary" @click="handleReset">
                <text class="btn-text secondary-text">重新验证</text>
            </view>
        </view>
    </view>
</template>

<script>
import { verifyContract, getRemainingRequests, VerificationResult, VerificationStatus } from '@/api/verification/index.uts';
import { APP_PLATFORM_AUTH_TEXT } from '@/config/app.config';

export default {
    data() {
        return {
            // 品牌信息（从集中配置获取）
            platformAuthText: APP_PLATFORM_AUTH_TEXT,
            loading: false as boolean,
            selectedFilePath: '' as string,
            selectedFileName: '' as string,
            remainingRequests: null as number | null,
            verificationResult: null as VerificationResult | null,
            avatarColors: ['#00C28A', '#1890FF', '#FAAD14', '#F56C6C', '#722ED1', '#13C2C2'] as string[]
        }
    },
    computed: {
        statusClass(): string {
            if (!this.verificationResult) return '';
            switch (this.verificationResult.verificationStatus) {
                case VerificationStatus.PASSED: return 'is-success';
                case VerificationStatus.FAILED: return 'is-error';
                case VerificationStatus.NO_SIGNATURE: return 'is-warning';
                default: return '';
            }
        },
        statusIconClass(): string {
            if (!this.verificationResult) return 'icon-clock';
            switch (this.verificationResult.verificationStatus) {
                case VerificationStatus.PASSED: return 'icon-check';
                case VerificationStatus.FAILED: return 'icon-close';
                case VerificationStatus.NO_SIGNATURE: return 'icon-alert-triangle';
                default: return 'icon-clock';
            }
        },
        statusDescription(): string {
            if (!this.verificationResult) return '';
            switch (this.verificationResult.verificationStatus) {
                case VerificationStatus.PASSED: return '签名真实有效，文件未被篡改';
                case VerificationStatus.FAILED: return '验证失败，签名无效或文件已损坏';
                case VerificationStatus.NO_SIGNATURE: return '未检测到有效的数字签名';
                default: return '正在验证中...';
            }
        }
    },
    onLoad() {
        this.loadRemainingRequests();
    },
    methods: {
        async loadRemainingRequests() {
            try {
                const result = await getRemainingRequests();
                console.log('[合同验证] 获取剩余次数成功:', result);
                this.remainingRequests = result;
            } catch (e: any) {
                console.error('[合同验证] 获取剩余次数失败:', e.message || e);
                // 获取失败时不显示剩余次数
                this.remainingRequests = null;
            }
        },
        
        getAvatarColor(index: number): string {
            return this.avatarColors[index % this.avatarColors.length];
        },
        
        getCurrentTime(): string {
            const date = new Date();
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            const hours = String(date.getHours()).padStart(2, '0');
            const minutes = String(date.getMinutes()).padStart(2, '0');
            return `${year}-${month}-${day} ${hours}:${minutes}`;
        },
        
        formatSignTime(time: any): string {
            if (!time) return '--';
            try {
                const date = new Date(time);
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                return `${year}-${month}-${day} ${hours}:${minutes}`;
            } catch (e) {
                return '--';
            }
        },
        
        chooseFile() {
            // #ifdef APP-PLUS
            uni.chooseFile({
                count: 1,
                type: 'file',
                extension: ['.pdf'],
                success: (res: UniApp.ChooseFileSuccessCallbackResult) => {
                    if (res.tempFilePaths && res.tempFilePaths.length > 0) {
                        this.selectedFilePath = res.tempFilePaths[0];
                        this.selectedFileName = res.tempFiles[0].name || 'PDF文件';
                    }
                },
                fail: () => {
                    uni.showToast({ title: '选择文件失败', icon: 'none' });
                }
            });
            // #endif
            
            // #ifdef H5
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.pdf,application/pdf';
            input.onchange = (e: Event) => {
                const target = e.target as HTMLInputElement;
                if (target.files && target.files.length > 0) {
                    const file = target.files[0];
                    this.selectedFileName = file.name;
                    this.selectedFilePath = URL.createObjectURL(file);
                }
            };
            input.click();
            // #endif
        },
        
        async handleVerify() {
            if (!this.selectedFilePath || this.loading) return;
            
            this.loading = true;
            try {
                this.verificationResult = await verifyContract(this.selectedFilePath);
                this.loadRemainingRequests();
            } catch (e: any) {
                uni.showToast({ 
                    title: e.message || '验证失败，请稍后重试', 
                    icon: 'none' 
                });
            } finally {
                this.loading = false;
            }
        },
        
        handleReset() {
            this.verificationResult = null;
            this.selectedFilePath = '';
            this.selectedFileName = '';
        }
    }
}
</script>

