<script lang="uts">
	import { post } from '@/api/index'
	import { getSealToken, clearSealToken } from '@/utils/sealTokenManager'
	import { getPlatformName, isWechatLoginSupported } from '@/utils/platform/index'
	import { getWechatProvider } from '@/utils/platform/provider/wechat/index'
	import { officialAccount } from '@/utils/platform/provider/wechat/index'
	import { APP_NAME, getCopyrightText } from '@/config/app.config'

	export default {
		onLoad(options: any) {
			// 读取登录后回跳参数（用于签署链接的登录签署模式）
			// redirect: 登录成功后需要跳转的完整 URL（跨域回跳到 seal-core 签署页）
			// signMode: 签署模式标识 (secure = 登录签署)
			if (options && options.redirect) {
				this.redirectUrl = decodeURIComponent(options.redirect) ?? ''
				this.signMode = (options.signMode as string | null) ?? ''
				console.log('[Login] 检测到回跳参数:', this.redirectUrl, 'signMode:', this.signMode)
			}
			
			// 检查是否已登录
			try {
				const token = uni.getStorageSync('token');
				if (token) {
					// 已登录：如果有 redirect 参数，直接获取 seal-token 后回跳
					if (this.redirectUrl) {
						console.log('[Login] 已登录且有回跳参数，直接获取 seal-token 后回跳')
						this.handleRedirectAfterLogin()
						return
					}
					console.log('检测到用户已登录，自动跳转到首页');
					// 已登录，直接跳转到首页
					uni.switchTab({
						url: '/pages/index/index'
					});
				}
			} catch (e) {
				console.error('检查登录状态失败:', e);
			}
		},
		data() {
			return {
				// 品牌信息（从集中配置获取）
				appName: APP_NAME,
				copyrightText: getCopyrightText(),
				phone: '',
				password: '',
				showPassword: false,
				rememberPassword: false,
				currentYear: new Date().getFullYear(),
				errorMessage: '',
				isLoading: false,
				isWechatLoading: false,  // 微信登录加载状态
				platformName: '' as string,  // 当前平台名称
				redirectUrl: '' as string,  // 登录后回跳 URL（跨域回到 seal-core）
				signMode: '' as string      // 签署模式标识
			}
		},
		onShow() {
			// 获取平台信息
			this.platformName = getPlatformName()
			console.log('[Login] 当前平台:', this.platformName)
		},
	computed: {
		isLoginDisabled() {
			return !this.phone || !this.password;
		},
		// 是否显示微信登录按钮
		showWechatLogin(): boolean {
			return isWechatLoginSupported()
		}
	},
		methods: {
			// 处理登录
			async handleLogin(): Promise<void> {
				// 清除错误信息
				this.errorMessage = ''
				
				// 表单验证
				if (!this.phone || !this.password) {
					this.errorMessage = '请输入手机号和密码'
					return
				}
				
				if (!/^1[3-9]\d{9}$/.test(this.phone)) {
					this.errorMessage = '请输入正确的手机号'
					return
				}
				
				// 显示加载状态
				this.isLoading = true
				
				try {
					// 调用真实登录接口（明确指定不需要认证）
					const response = await post<any>('/api/v1/member/auth/login', {
						mobile: this.phone,
						password: this.password
					}, { isAuth: false })
					
					// 【重要】打印响应，用于调试确认token字段名
					console.log('登录成功，后端响应:', JSON.stringify(response))
					
					// 保存 member token 和用户信息到本地存储
					uni.setStorageSync('token', response.accessToken)
					uni.setStorageSync('refreshToken', response.refreshToken)
					uni.setStorageSync('userId', response.userId)
					
					// 🔧 关键修复：等待较长时间，确保后端的token已完全写入Redis/MySQL
					// 原因：后端创建token需要写入数据库和Redis，这个过程需要时间
					console.log('[Login] 等待500ms，确保后端token完全写入...')
					await new Promise(resolve => setTimeout(resolve, 500))
					
					// 🆕 登录成功后，使用 SealTokenManager 兑换 seal token
					// 参考 PC 端 SealTokenManager 实现：统一管理token缓存、有效期检查、自动刷新
					console.log('[Login] 开始兑换 Seal-Token（使用 SealTokenManager）...')
					let sealToken = ''
					try {
						// 先清除旧的缓存，确保获取新token
						clearSealToken()
						// 使用 SealTokenManager 获取新 token（会自动保存到缓存）
						sealToken = await getSealToken()
						console.log('[Login] ✅ Seal-Token 兑换成功（已缓存）')
					} catch (sealTokenError) {
						console.error('[Login] ⚠️ Seal-Token 兑换失败，但不影响登录:', sealTokenError)
						// 兑换失败不影响登录，用户可以进入系统，后续会自动重试
					}
					
					// 检查是否有回跳参数（签署链接登录签署模式）
					// 如果有 redirect URL，携带 seal-token 跳转回 seal-core 签署页
					if (this.redirectUrl && sealToken) {
						console.log('[Login] 🔄 检测到回跳参数，携带 seal-token 跳转回签署页')
						this.doRedirectWithToken(sealToken)
						return
					}
					
					// 登录成功，跳转到首页
					uni.showToast({
						title: '登录成功',
						icon: 'success',
						duration: 1500
					})
					
					setTimeout(() => {
						uni.switchTab({
							url: '/pages/index/index'
						})
					}, 1500)
					
			} catch (error) {
				// 错误已在request中统一处理，此处可留空或进行特定UI处理
				console.error('登录组件捕获到错误:', error)
				// 显示详细的错误信息，便于调试
				const errorMessage = (error as any)?.message || '登录失败';
				this.errorMessage = `登录失败: ${errorMessage}`;
				
				// 如果是账号未登录错误，提供更友好的提示
				if (errorMessage && errorMessage.includes('账号未登录')) {
					this.errorMessage = '登录接口异常，请联系系统管理员或检查后端服务';
				}
				} finally {
					this.isLoading = false
				}
			},
			
			// 切换密码可见性
			togglePasswordVisibility(): void {
				this.showPassword = !this.showPassword
			},
			
			// 切换记住密码
			toggleRememberPassword(): void {
				this.rememberPassword = !this.rememberPassword
			},
			
			// 跳转到注册页面
			goToRegister(): void {
				uni.navigateTo({
					url: '/pages/register/index'
				})
			},
			
			// 跳转到忘记密码页面（实际跳转到快速登录/注册页面）
			goToForgetPassword(): void {
				uni.navigateTo({
					url: '/pages/register/index'
				})
			},
			
			// 处理微信登录
			async handleWechatLogin(): Promise<void> {
				if (this.isWechatLoading) return
				
				this.isWechatLoading = true
				this.errorMessage = ''
				
				try {
					console.log('[Login] 开始微信登录，平台:', this.platformName)
					
					const wechatProvider = getWechatProvider()
					const result = await wechatProvider.login()
					
					if (result) {
						console.log('[Login] 微信登录成功')
						
						// 微信登录成功后也需要处理回跳逻辑
						if (this.redirectUrl) {
							await this.handleRedirectAfterLogin()
							return
						}
						
						uni.showToast({
							title: '登录成功',
							icon: 'success',
							duration: 1500
						})
						
						setTimeout(() => {
							uni.switchTab({
								url: '/pages/index/index'
							})
						}, 1500)
					} else {
						// 如果是公众号环境，login 返回 false 表示正在跳转授权页
						if (this.platformName !== 'WechatOfficialAccount') {
							console.log('[Login] 微信登录失败或用户取消')
						}
					}
				} catch (error) {
					console.error('[Login] 微信登录异常:', error)
					this.errorMessage = (error as any)?.message || '微信登录失败'
				} finally {
					this.isWechatLoading = false
				}
			},
			
			// 处理微信小程序手机号快捷登录
			async handlePhoneLogin(e: any): Promise<void> {
				if (this.isWechatLoading) return
				
				this.isWechatLoading = true
				this.errorMessage = ''
				
				try {
					console.log('[Login] 开始手机号快捷登录')
					
					const wechatProvider = getWechatProvider()
					if (wechatProvider.mobileLogin) {
						const result = await wechatProvider.mobileLogin(e)
						
						if (result) {
							console.log('[Login] 手机号快捷登录成功')
							
							// 手机号登录成功后也需要处理回跳逻辑
							if (this.redirectUrl) {
								await this.handleRedirectAfterLogin()
								return
							}
							
							uni.showToast({
								title: '登录成功',
								icon: 'success',
								duration: 1500
							})
							
							setTimeout(() => {
								uni.switchTab({
									url: '/pages/index/index'
								})
							}, 1500)
						} else {
							console.log('[Login] 手机号快捷登录失败或用户取消')
						}
					}
				} catch (error) {
					console.error('[Login] 手机号快捷登录异常:', error)
					this.errorMessage = (error as any)?.message || '登录失败'
				} finally {
					this.isWechatLoading = false
				}
			},
			
			// 处理支付宝登录
			handleAlipayLogin(): void {
				uni.showToast({
					title: '支付宝登录功能开发中',
					icon: 'none'
				})
			},
			
			/**
			 * 已登录状态下处理回跳逻辑
			 * 
			 * 支持两种回跳场景：
			 * 1. 跨域回跳（H5 模式）：redirect 是完整 URL（如 https://seal.example.com/h5/sign/document?...）
			 *    → 获取 seal-token → 携带 token 跳转回 seal-core 签署页
			 * 2. 应用内回跳（小程序/APP 模式）：redirect 是应用内页面路径（如 /pages/contract-sign/index?ref=xxx）
			 *    → 直接 navigateTo 到对应页面
			 */
			async handleRedirectAfterLogin(): Promise<void> {
				try {
					const isExternalUrl = this.redirectUrl.startsWith('http://') || this.redirectUrl.startsWith('https://')
					
					if (isExternalUrl) {
						// 跨域回跳：需要获取 seal-token 附加到 URL
						console.log('[Login] 已登录，获取 seal-token 用于跨域回跳...')
						const sealToken = await getSealToken()
						if (sealToken) {
							this.doRedirectWithToken(sealToken)
						} else {
							console.error('[Login] 获取 seal-token 失败，回退到首页')
							uni.switchTab({ url: '/pages/index/index' })
						}
					} else {
						// 应用内回跳：直接跳转到对应页面
						console.log('[Login] 应用内回跳:', this.redirectUrl)
						uni.redirectTo({ url: this.redirectUrl })
					}
				} catch (error) {
					console.error('[Login] 回跳处理失败:', error)
					uni.switchTab({ url: '/pages/index/index' })
				}
			},
			
			/**
			 * 携带 seal-token 跳转回外部 URL（跨域回跳到 seal-core）
			 * 
			 * 仅在 H5 环境下生效：使用 window.location.href 实现跨域跳转
			 * 原生 APP / 小程序环境下尝试应用内跳转，实在不行则回退到首页
			 * 
			 * @param sealToken 已获取的 seal-token
			 */
			doRedirectWithToken(sealToken: string): void {
				if (!this.redirectUrl) {
					uni.switchTab({ url: '/pages/index/index' })
					return
				}
				
				// 构建回跳 URL：在 redirect URL 上附加 token 参数
				const separator = this.redirectUrl.includes('?') ? '&' : '?'
				const redirectWithToken = `${this.redirectUrl}${separator}token=${encodeURIComponent(sealToken)}`
				
				console.log('[Login] 🚀 携带 seal-token 回跳到:', redirectWithToken)
				
				uni.showToast({
					title: '登录成功，正在跳转签署页...',
					icon: 'none',
					duration: 1500
				})
				
				// #ifdef H5
				// H5 环境：使用 window.location.href 跨域跳转回 seal-core
				setTimeout(() => {
					window.location.href = redirectWithToken
				}, 800)
				// #endif
				
				// #ifndef H5
				// 非 H5 环境（原生APP/小程序）：不支持跨域跳转，回退到首页
				console.warn('[Login] 非 H5 环境，不支持跨域回跳，跳转到首页')
				setTimeout(() => {
					uni.switchTab({ url: '/pages/index/index' })
				}, 1500)
				// #endif
			},
			
			// 跳转到用户协议页面
			goToUserAgreement(): void {
				uni.navigateTo({
					url: '/pages/agreement/user'
				})
			},
			
			// 跳转到隐私政策页面
			goToPrivacyPolicy(): void {
				uni.navigateTo({
					url: '/pages/agreement/privacy'
				})
			}
		}
	}
</script>

<template>
	<view class="login-container">
		<!-- 顶部背景与Logo区域 -->
		<view class="login-header">
			<view class="header-content">
				<image class="logo" src="/static/logo.png" mode="aspectFit"></image>
				<text class="app-slogan">安全·高效·便捷的电子合同平台</text>
			</view>
		</view>
		
		<!-- 登录表单卡片 -->
		<view class="login-form-container">
			<view class="login-card">
				<view class="card-header">
					<text class="card-title">账号登录</text>
					<text class="card-subtitle">{{appName}}</text>
				</view>
				
		<!-- 错误信息提示 -->
		<view class="error-message" v-if="errorMessage">
			<text class="fa fa-exclamation-circle error-icon"></text>
			<text class="error-text">{{ errorMessage }}</text>
		</view>
				
			<!-- 手机号输入框 -->
			<view class="input-group">
				<view class="input-prefix">
					<text class="fa fa-mobile input-icon"></text>
				</view>
				<input 
					class="input-field" 
					type="number" 
					placeholder="请输入手机号" 
					placeholder-class="input-placeholder"
					maxlength="11"
					v-model="phone"
				/>
				<view class="input-suffix" v-if="phone" @click="phone = ''">
					<text class="fa fa-times-circle input-icon clear-icon"></text>
				</view>
			</view>
			
			<!-- 密码输入框 -->
			<view class="input-group">
				<view class="input-prefix">
					<text class="fa fa-lock input-icon"></text>
				</view>
				<input 
					class="input-field" 
					type="text"
					:password="!showPassword"
					placeholder="请输入密码" 
					placeholder-class="input-placeholder"
					v-model="password"
				/>
				<view class="input-suffix" v-if="password" @click="password = ''">
					<text class="fa fa-times-circle input-icon clear-icon"></text>
				</view>
				<view class="input-suffix" @click="togglePasswordVisibility">
					<text class="fa input-icon" :class="showPassword ? 'fa-eye' : 'fa-eye-slash'"></text>
				</view>
			</view>
				
				<!-- 记住密码和忘记密码 -->
				<view class="form-options">
					<view class="remember-password" @click="toggleRememberPassword">
			<view class="checkbox" :class="{ checked: rememberPassword }">
				<text v-if="rememberPassword" class="fa fa-check check-icon"></text>
			</view>
						<text class="option-text">记住密码</text>
					</view>
					<text class="forget-password" @click="goToForgetPassword">验证码登录</text>
				</view>
				
				<!-- 登录按钮 -->
				<button 
					class="primary-button" 
					:disabled="isLoginDisabled" 
					:loading="isLoading"
					@click="handleLogin"
				>
					<text class="button-text">{{ isLoading ? '登录中...' : '登 录' }}</text>
				</button>
				
				<!-- 其他登录方式 -->
				<view class="other-login-methods">
					<view class="divider">
						<view class="divider-line"></view>
						<text class="divider-text">其他登录方式</text>
						<view class="divider-line"></view>
					</view>
					
					<view class="social-login">
						<!-- 社交登录按钮行 -->
						<view class="social-buttons-row">
							<!-- 微信登录按钮 -->
							<!-- #ifdef MP-WEIXIN -->
							<!-- 小程序环境：使用手机号快捷登录 -->
							<button 
								class="social-button wechat-button"
								open-type="getPhoneNumber"
								@getphonenumber="handlePhoneLogin"
							>
								<text class="fa-brands fa-weixin social-icon"></text>
								<text class="social-label">微信</text>
							</button>
							<!-- #endif -->
							<!-- #ifndef MP-WEIXIN -->
							<!-- 非小程序环境：使用普通微信登录 -->
							<view 
								class="social-button wechat-button" 
								@click="handleWechatLogin"
								v-if="showWechatLogin"
							>
								<text class="fa-brands fa-weixin social-icon"></text>
								<text class="social-label">微信</text>
							</view>
							<!-- #endif -->
							
							<!-- 支付宝登录按钮 -->
							<view class="social-button alipay-button" @click="handleAlipayLogin">
								<text class="fa-brands fa-alipay social-icon"></text>
								<text class="social-label">支付宝</text>
							</view>
						</view>
					</view>
				</view>
				
				<!-- 用户协议 -->
				<view class="agreement">
					<text class="agreement-text">登录即表示您已同意</text>
					<view @tap="goToUserAgreement" class="agreement-link-wrapper">
						<text class="agreement-link">《用户协议》</text>
					</view>
					<text class="agreement-text">和</text>
					<view @tap="goToPrivacyPolicy" class="agreement-link-wrapper">
						<text class="agreement-link">《隐私政策》</text>
					</view>
				</view>
			</view>
		</view>
		
		<!-- 底部版权信息 -->
		<view class="footer">
			<text class="copyright">{{copyrightText}}</text>
		</view>
	</view>
</template>

<style>
	/* FontAwesome基础样式 */
	@import url("../../static/styles/fontawesome.css");
	
	.fa {
		font-family: 'Font Awesome 6 Free';
		font-weight: 900;
		font-style: normal;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	
	.fa-brands {
		font-family: 'Font Awesome 6 Brands';
		font-weight: 400;
	}
	
	/* 页面容器 */
	.login-container {
		flex: 1;
		background-color: #F7F9FC;
		padding-top: 40rpx;
	}
	
	/* 顶部背景区域 */
	.login-header {
		height: 240rpx;
		position: relative;
		background: linear-gradient(135deg, #00C28A 0%, #00A876 100%);
		margin: 0 40rpx;
		border-radius: 20rpx 20rpx 0 0;
		box-shadow: 0 8rpx 24rpx rgba(0, 194, 138, 0.2);
	}
	
	.header-content {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		align-items: center;
		justify-content: center;
	}
	
	.logo {
		width: 100rpx;
		height: 100rpx;
		margin-bottom: 16rpx;
		border-radius: 16rpx;
	}
	
	.app-slogan {
		font-size: 22rpx;
		color: rgba(255, 255, 255, 0.95);
		letter-spacing: 1rpx;
	}
	
	/* 登录表单卡片容器 */
	.login-form-container {
		padding: 0 40rpx;
		margin-top: 0;
		position: relative;
	}
	
	.login-card {
		background-color: #FFFFFF;
		border-radius: 0 0 20rpx 20rpx;
		padding: 36rpx 40rpx 32rpx;
		box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
	}
	
	.card-header {
		margin-bottom: 28rpx;
		align-items: center;
	}
	
	.card-title {
		font-size: 34rpx;
		font-weight: 600;
		color: #303133;
		margin-bottom: 8rpx;
	}
	
	.card-subtitle {
		font-size: 24rpx;
		color: #909399;
	}
	
	/* 错误信息提示 */
	.error-message {
		background-color: #FEF0F0;
		padding: 16rpx 20rpx;
		border-radius: 10rpx;
		flex-direction: row;
		align-items: center;
		margin-bottom: 24rpx;
		border-left-width: 6rpx;
		border-left-color: #F56C6C;
	}
	
	.error-message .error-icon {
		font-size: 28rpx;
		color: #F56C6C;
		margin-right: 12rpx;
	}
	
	.error-text {
		flex: 1;
		font-size: 26rpx;
		color: #F56C6C;
		line-height: 40rpx;
	}
	
