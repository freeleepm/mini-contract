<script lang="uts">
// 实名认证接口响应类型
interface VerifyResponse {
    verifyStatus: number; // 0: 未认证, 1: 审核中, 2: 认证成功, 3: 认证失败
    failReason: string | null;
}

// 用户信息接口
interface UserInfo {
    id: number;
    nickname: string;
    avatar: string;
    mobile: string;
    verifyStatus: number; // 0: 未认证, 1: 审核中, 2: 认证成功, 3: 认证失败
    verifyFailReason?: string;
    // 其他字段...
}

// 导入API工具
import { post, get, uploadFileAdvanced, simpleUpload } from '../../../api/index';
import { API_BASE_URL, TENANT_ID, UPLOAD_CONFIG } from '../../../config/app.config';
import { recognizeIdCard } from '../../../api/member/verify';

const FACE_IMAGE_MAX_SIZE_MB = 1;
// 第三方实名接口对图片大小比较敏感，上传前压到 900KB 左右，给 1MB 限制留余量。
const FACE_IMAGE_UPLOAD_TARGET_BYTES = 900 * 1024;
const FACE_IMAGE_COMPRESSION_TIMEOUT_MS = 30000;
const ID_CARD_IMAGE_UPLOAD_TARGET_BYTES = 900 * 1024;
const H5_IMAGE_MAX_DIMENSION = 1280;

export default {
	data() {
		return {
			// 当前步骤
			currentStep: 1,
			totalSteps: 2,
			
			// 用户信息
			userInfo: {
				realName: '',
				idCardNumber: '',
				faceVerified: false,
                faceImage: '', // 存储照片URL
				idCardImageUrl: '' // 存储身份证照片URL
			},
			
			// 表单验证状态
			validation: {
				realName: {
					valid: true,
					message: ''
				},
				idCardNumber: {
					valid: true,
					message: ''
				}
			},
			
			// 认证状态 (pending: 审核中, success: 认证成功, failed: 认证失败, none: 未认证)
			verificationStatus: 'none',
			
			// 认证失败原因
			failedReason: '',

            // 人脸照片大小限制
            maxFaceImageSizeMB: FACE_IMAGE_MAX_SIZE_MB,
			
			// 是否正在提交
			isSubmitting: false,
            
            // 上传进度
            uploadProgress: 0,
            
            // 人脸识别指导弹窗
            faceGuidanceVisible: false,
            guidanceTips: [
                '请确保光线充足，面部清晰可见',
                '请直视摄像头，表情自然',
                '不要佩戴墨镜、帽子等遮挡面部的物品',
                `照片将自动压缩，建议大小不超过${FACE_IMAGE_MAX_SIZE_MB}MB`,
                '照片将用于实名认证，请确保真实有效'
            ],
            // 图标化的注意事项
            iconTips: [
                { icon: 'icon-hat', text: '不要戴帽子' },
                { icon: 'icon-sunglasses', text: '不要戴墨镜' },
                { icon: 'icon-users', text: '避免他人入镜' }
            ],
            
	            // 上传状态
	            uploadStatus: {
	                inProgress: false,
	                progress: 0,
	                error: false,
	                errorMessage: ''
	            },

	            // 当前压缩批次，用于处理 H5/微信环境下 compressImage 长时间无回调的情况
	            compressionAttemptId: 0,
            
            // 重试计数器，避免无限重试
            retryCount: 0,
            maxRetries: 3,
			
			// OCR识别相关
			ocrProcessing: false,
			ocrResult: null as any,
			showOcrGuidance: false,
			ocrGuidanceTips: [
				'请确保光线充足，身份证清晰可见',
				'将身份证放在平整的表面上',
				'确保身份证边框完整，无遮挡',
				'避免反光和阴影'
			]
		}
	},
	onLoad() {
		// 检查是否已经提交过认证
		this.checkVerificationStatus()
	},
	computed: {
		// 当前步骤是否可以继续
		canProceed(): boolean {
			if (this.currentStep === 1) {
				return this.validation.realName.valid && 
					   this.userInfo.realName.length > 0 && 
					   this.validation.idCardNumber.valid && 
					   this.userInfo.idCardNumber.length === 18
			} else if (this.currentStep === 2) {
				return this.userInfo.faceVerified && 
                       this.userInfo.faceImage.length > 0
			}
			return false
		},
		
		// 步骤指示器数组
		stepIndicators(): string[] {
			return ['填写信息', '人脸识别']
		}
	},
	methods: {
		// 返回上一页
		goBack(): void {
			uni.navigateBack()
		},
		
		// 开始OCR识别
		startOcrCapture(): void {
			console.log('[KYC-Personal][OCR] 点击身份证OCR入口, ocrProcessing=', this.ocrProcessing);
			if (this.ocrProcessing) return;
			this.showOcrGuidance = true;
		},
		
		// 确认OCR指导并开始拍照
		confirmOcrGuidanceAndCapture(): void {
			console.log('[KYC-Personal][OCR] 确认拍照指引，准备打开相机');
			this.showOcrGuidance = false;
			
			uni.showLoading({
				title: '准备拍照...'
			});
			
			this.chooseCameraImage(false, (filePath: string) => {
				console.log('[KYC-Personal][OCR] 已选择/拍摄身份证照片, filePath=', filePath);
				this.handleIdCardImageSelected(filePath);
			});
		},
		
		// 处理身份证图片选择
		async handleIdCardImageSelected(filePath: string): Promise<void> {
			console.log('[KYC-Personal][OCR] 开始处理身份证照片, filePath=', filePath);
			this.ocrProcessing = true;

			try {
				// 1. 压缩身份证图片，避免 OCR 图片在 OSS 中保留过大的原图。
				uni.showLoading({
					title: '正在压缩照片...'
				});
				const uploadPath = await this.compressImageToTarget(filePath, ID_CARD_IMAGE_UPLOAD_TARGET_BYTES, 70, 25);
				console.log('[KYC-Personal][OCR] 身份证照片压缩完成, uploadPath=', uploadPath);
				const timestamp = new Date().getTime();
				const randomPart = Math.floor(Math.random() * 10000);
				const idCardFileName = `idcard_${timestamp}_${randomPart}.jpg`;

				// 2. 上传图片
				uni.showLoading({
					title: '上传中...'
				});

				const imageUrl = await uploadFileAdvanced(uploadPath, {
					fileName: idCardFileName,
					directory: UPLOAD_CONFIG.DIRECTORIES.VERIFY,
					fileType: 'image/jpeg',
					onProgress: (percent: number) => {
						uni.showLoading({
							title: `上传中 ${percent}%`
						});
					}
				});
				console.log('[KYC-Personal][OCR] 身份证照片上传完成, imageUrl=', imageUrl);

				// 3. OCR识别
				uni.showLoading({
					title: '识别中...'
				});

				const ocrResult = await recognizeIdCard({
					imageUrl: imageUrl,
					side: 'front'
				});
				console.log('[KYC-Personal][OCR] OCR返回结果:', JSON.stringify(ocrResult));

				uni.hideLoading();

				// 4. 处理识别结果
				if (ocrResult.success) {
					this.ocrResult = ocrResult;

					// 自动填充表单
					if (ocrResult.name) {
						this.userInfo.realName = ocrResult.name;
						this.validateName();
					}
					if (ocrResult.idCard) {
						this.userInfo.idCardNumber = ocrResult.idCard;
						this.validateIdCard();
					}
					
					// 保存身份证图片URL
					this.userInfo.idCardImageUrl = imageUrl;
					
					uni.showToast({
						title: '识别成功',
						icon: 'success'
					});
				} else {
					uni.showToast({
						title: ocrResult.errorMessage || '识别失败，请手动输入',
						icon: 'none'
					});
				}
			} catch (error) {
				uni.hideLoading();
				console.error('OCR识别失败:', error);
				const errorMessage = (error as Error).message || '识别失败，请手动输入';
				uni.showToast({
					title: errorMessage,
					icon: 'none'
				});
			} finally {
				this.ocrProcessing = false;
			}
		},

			compressImageToTarget(filePath: string, targetBytes: number, quality: number, minQuality: number): Promise<string> {
				// #ifdef H5
				return this.compressImageToTargetByCanvas(filePath, targetBytes, quality, minQuality);
				// #endif

				// #ifndef H5
				return this.compressImageToTargetByUni(filePath, targetBytes, quality, minQuality);
				// #endif
			},

			compressImageToTargetByUni(filePath: string, targetBytes: number, quality: number, minQuality: number): Promise<string> {
				return new Promise((resolve, reject) => {
					const attemptId = this.compressionAttemptId + 1;
					this.compressionAttemptId = attemptId;
					const timeoutId = setTimeout(() => {
						if (this.compressionAttemptId !== attemptId) {
							return;
						}
						this.compressionAttemptId = attemptId + 1;
						reject(new Error('照片压缩超时，请重新拍摄'));
					}, FACE_IMAGE_COMPRESSION_TIMEOUT_MS);

					uni.getFileInfo({
						filePath,
						success: (originalInfo) => {
							if (originalInfo.size <= targetBytes) {
								clearTimeout(timeoutId);
								resolve(filePath);
								return;
							}

							uni.compressImage({
								src: filePath,
								quality,
								success: (res) => {
									if (this.compressionAttemptId !== attemptId) {
										return;
									}
									const compressedPath = res.tempFilePath;
									uni.getFileInfo({
										filePath: compressedPath,
										success: (compressedInfo) => {
											if (this.compressionAttemptId !== attemptId) {
												return;
											}
											if (compressedInfo.size <= targetBytes) {
												clearTimeout(timeoutId);
												resolve(compressedPath);
												return;
											}
											if (quality > minQuality) {
												clearTimeout(timeoutId);
												const nextQuality = quality > 45 ? 45 : minQuality;
												this.compressImageToTargetByUni(compressedPath, targetBytes, nextQuality, minQuality).then(resolve).catch(reject);
												return;
											}
											clearTimeout(timeoutId);
											reject(new Error('照片压缩后仍过大，请重新拍摄'));
										},
										fail: (error) => {
											clearTimeout(timeoutId);
											reject(error);
										}
									});
								},
								fail: (error) => {
									clearTimeout(timeoutId);
									reject(error);
								}
							});
						},
						fail: (error) => {
							clearTimeout(timeoutId);
							reject(error);
						}
					});
				});
			},

			compressImageToTargetByCanvas(filePath: string, targetBytes: number, quality: number, minQuality: number): Promise<string> {
				return new Promise((resolve, reject) => {
					const attemptId = this.compressionAttemptId + 1;
					this.compressionAttemptId = attemptId;
					const timeoutId = setTimeout(() => {
						if (this.compressionAttemptId !== attemptId) {
							return;
						}
						this.compressionAttemptId = attemptId + 1;
						reject(new Error('照片压缩超时，请重新拍摄'));
					}, FACE_IMAGE_COMPRESSION_TIMEOUT_MS);

					const finish = (path: string) => {
						if (this.compressionAttemptId !== attemptId) {
							return;
						}
						clearTimeout(timeoutId);
						resolve(path);
					};

					const fail = (error: any) => {
						if (this.compressionAttemptId !== attemptId) {
							return;
						}
						clearTimeout(timeoutId);
						reject(error instanceof Error ? error : new Error('照片压缩失败，请重新拍摄'));
					};

					const fetchFn = fetch as any;
					if (fetchFn == null) {
						fail(new Error('当前浏览器不支持图片读取，请重新拍摄较小照片'));
						return;
					}

					fetchFn(filePath)
						.then((response) => response.blob())
						.then((sourceBlob) => {
							if (sourceBlob.size <= targetBytes) {
								finish(filePath);
								return;
							}

							const urlObj = URL as any;
							if (urlObj == null || typeof urlObj.createObjectURL !== 'function') {
								fail(new Error('当前浏览器不支持图片压缩，请重新拍摄较小照片'));
								return;
							}
							const imageUrl = urlObj.createObjectURL(sourceBlob);
							const image = new Image() as any;
							image.onload = () => {
								try {
									const width = image.naturalWidth || image.width;
									const height = image.naturalHeight || image.height;
									if (!width || !height) {
										urlObj.revokeObjectURL(imageUrl);
										fail(new Error('照片读取失败，请重新拍摄'));
										return;
									}

									let targetWidth = width;
									let targetHeight = height;
									const maxSide = Math.max(width, height);
									if (maxSide > H5_IMAGE_MAX_DIMENSION) {
										const ratio = H5_IMAGE_MAX_DIMENSION / maxSide;
										targetWidth = Math.round(width * ratio);
										targetHeight = Math.round(height * ratio);
									}

										const documentObj = document as any;
										if (documentObj == null || typeof documentObj.createElement !== 'function') {
											urlObj.revokeObjectURL(imageUrl);
											fail(new Error('当前浏览器不支持图片压缩，请重新拍摄较小照片'));
											return;
										}
										const canvas = documentObj.createElement('canvas') as any;
									canvas.width = targetWidth;
									canvas.height = targetHeight;
									const context = canvas.getContext('2d');
									if (!context) {
										urlObj.revokeObjectURL(imageUrl);
										fail(new Error('浏览器不支持图片压缩，请重新拍摄较小照片'));
										return;
									}
									context.drawImage(image, 0, 0, targetWidth, targetHeight);
									urlObj.revokeObjectURL(imageUrl);

									const tryBlob = (currentQuality: number) => {
										canvas.toBlob((blob: any) => {
											if (!blob) {
												fail(new Error('照片压缩失败，请重新拍摄'));
												return;
											}
											if (blob.size <= targetBytes || currentQuality <= minQuality) {
												if (blob.size > targetBytes) {
													fail(new Error('照片压缩后仍过大，请重新拍摄'));
													return;
												}
												finish(urlObj.createObjectURL(blob));
												return;
											}
											const nextQuality = currentQuality > 45 ? 45 : minQuality;
											tryBlob(nextQuality);
										}, 'image/jpeg', currentQuality / 100);
									};

									tryBlob(quality);
								} catch (error) {
									urlObj.revokeObjectURL(imageUrl);
									fail(error);
								}
							};
							image.onerror = () => {
								urlObj.revokeObjectURL(imageUrl);
								fail(new Error('照片读取失败，请重新拍摄'));
							};
							image.src = imageUrl;
						})
						.catch(fail);
				});
			},

			// 检查认证状态
		checkVerificationStatus(): void {
            // 显示加载中
            uni.showLoading({
                title: '加载中...'
            })
            
            // 使用封装的API调用获取用户信息
            get('/api/v1/member/user/get')
                .then((userData: any) => {
                    uni.hideLoading()
                    
                    console.log('获取用户信息成功:', JSON.stringify(userData))
                    
                    // 根据API返回的认证状态设置页面状态
                    if (userData && userData.verifyStatus !== undefined) {
                        if (userData.verifyStatus === 2) {
                            // 认证成功
                            this.verificationStatus = 'success'
                            // 保存认证状态到本地存储（兼容旧版本）
                            uni.setStorageSync('kycStatus', 'true')
                        } else if (userData.verifyStatus === 3) {
                            // 认证失败
                            this.verificationStatus = 'failed'
                            this.failedReason = userData.verifyFailReason || '认证未通过，请重新提交'
                        } else if (userData.verifyStatus === 0) {
                            // 未认证，保持默认状态
                            this.verificationStatus = 'none'
                        } else if (userData.verifyStatus === 1) {
                            // 审核中状态
                            this.verificationStatus = 'pending'
                        }
                    }
                })
                .catch((err: Error) => {
                    uni.hideLoading()
                    console.error('获取用户信息失败:', err)
                    
                    // 如果API调用失败，尝试从本地存储获取状态（兼容旧版本）
                    const isVerified = uni.getStorageSync('kycStatus')
                    if (isVerified === 'true') {
                        this.verificationStatus = 'success'
                    }
                })
		},
		
		// 验证姓名
			validateName(): void {
				if (!this.userInfo.realName) {
					this.validation.realName.valid = false
				this.validation.realName.message = '请输入真实姓名'
				return
			}
			
			// 简单验证：姓名长度至少为2个字符
			if (this.userInfo.realName.length < 2) {
				this.validation.realName.valid = false
				this.validation.realName.message = '姓名长度不正确'
				return
			}
			
				this.validation.realName.valid = true
				this.validation.realName.message = ''
			},

			// 身份证号输入：保留前 17 位数字，第 18 位允许数字或 X
			handleIdCardInput(event: any): void {
				let rawValue = ''
				if (event != null && event.detail != null && event.detail.value != null) {
					rawValue = event.detail.value as string
				}
				const cleaned = rawValue.toUpperCase().replace(/[^0-9X]/g, '')
				const firstPart = cleaned.substring(0, 17).replace(/X/g, '')
				const lastPart = cleaned.length > 17 ? cleaned.substring(17, 18) : ''
				this.userInfo.idCardNumber = (firstPart + lastPart).substring(0, 18)
			},

			// 验证身份证号
			validateIdCard(): void {
			if (!this.userInfo.idCardNumber) {
				this.validation.idCardNumber.valid = false
				this.validation.idCardNumber.message = '请输入身份证号'
				return
			}
			
			// 简单验证：身份证号必须为18位
			if (this.userInfo.idCardNumber.length !== 18) {
				this.validation.idCardNumber.valid = false
				this.validation.idCardNumber.message = '身份证号必须为18位'
				return
			}
			
			// TODO: 实现更复杂的身份证号验证逻辑
			
			this.validation.idCardNumber.valid = true
			this.validation.idCardNumber.message = ''
		},
		
		// 下一步
		nextStep(): void {
			if (this.currentStep < this.totalSteps) {
				this.currentStep++
			}
		},
		
		// 上一步
		prevStep(): void {
			if (this.currentStep > 1) {
				this.currentStep--
			}
		},
		
		// 开始人脸识别
		startFaceVerification(): void {
            // 显示拍照指导弹窗
            this.showFaceGuidance()
		},

        // 显示人脸拍照指导弹窗
        showFaceGuidance(): void {
            this.faceGuidanceVisible = true
        },

        // 确认已阅读指导并开始拍照
        confirmGuidanceAndStartCamera(): void {
            this.faceGuidanceVisible = false
            
            // 显示加载中
            uni.showLoading({
                title: '准备人脸识别...'
            })
            
	            try {
	                this.chooseFaceImageWithFrontCamera()
	            } catch (error) {
	                uni.hideLoading()
	                console.error('启动相机失败:', error)
                uni.showToast({
                    title: '无法启动相机，请检查权限',
                    icon: 'none',
                    duration: 3000
                })
	            }
	        },

	        // 人脸认证优先请求前置摄像头。H5 使用 capture=user，App/小程序用 camera=front 尽量指定。
	        chooseFaceImageWithFrontCamera(): void {
	            // #ifdef H5
	            this.chooseFaceImageByH5Input()
	            // #endif

	            // #ifndef H5
	            this.chooseCameraImage(true, (filePath: string) => {
	                this.handleCameraSuccess({
	                    tempFilePaths: [filePath]
	                })
	            })
	            // #endif
	        },

	        // 小程序优先使用 chooseMedia；chooseImage 在微信基础库 2.21.0 后已停止维护。
	        chooseCameraImage(useFrontCamera: boolean, onSuccess: (filePath: string) => void): void {
	            console.log('[KYC-Personal][Media] chooseCameraImage start, useFrontCamera=', useFrontCamera)
	            this.ensureMediaPrivacyAuthorized(() => {
	            console.log('[KYC-Personal][Media] 隐私授权通过，准备调用媒体选择API')
	            // #ifdef MP-WEIXIN
	            const uniObj = uni as any
	            if (uniObj != null && typeof uniObj.chooseMedia === 'function') {
	                console.log('[KYC-Personal][Media] 使用 chooseMedia')
	                const mediaOptions: any = {
	                    count: 1,
	                    mediaType: ['image'],
	                    sourceType: ['camera'],
	                    sizeType: ['compressed'],
	                    camera: useFrontCamera ? 'front' : 'back',
	                    success: (res: any) => {
	                        console.log('[KYC-Personal][Media] chooseMedia success:', JSON.stringify(res))
	                        const tempFiles = res != null ? res.tempFiles : null
	                        let filePath = ''
	                        if (tempFiles != null && tempFiles.length > 0 && tempFiles[0] != null) {
	                            filePath = (tempFiles[0] as any).tempFilePath as string
	                        }
	                        if (!filePath && res != null && res.tempFilePaths != null && res.tempFilePaths.length > 0) {
	                            filePath = res.tempFilePaths[0] as string
	                        }
	                        if (!filePath) {
	                            this.handleCameraOpenFail(new Error('未获取到照片路径'))
	                            return
	                        }
	                        onSuccess(filePath)
	                    },
	                    fail: (error: any) => {
	                        console.warn('[KYC-Personal][Media] chooseMedia 打开相机失败:', error)
	                        if (this.isMediaAuthorizationError(error)) {
	                            this.handleCameraOpenFail(error)
	                            return
	                        }
	                        console.warn('[KYC-Personal][Media] chooseMedia 不可用，尝试 chooseImage 兼容模式')
	                        this.chooseImageCameraFallback(useFrontCamera, onSuccess)
	                    },
	                    complete: (res: any) => {
	                        console.log('[KYC-Personal][Media] chooseMedia complete:', JSON.stringify(res))
	                    }
	                }
	                uniObj.chooseMedia(mediaOptions)
	                return
	            }
	            // #endif

	            this.chooseImageCameraFallback(useFrontCamera, onSuccess)
	            })
	        },

	        ensureMediaPrivacyAuthorized(onGranted: () => void): void {
	            console.log('[KYC-Personal][Privacy] 检查微信隐私授权')
	            // #ifdef MP-WEIXIN
	            const wxObj = wx as any
	            if (wxObj != null && typeof wxObj.getPrivacySetting === 'function') {
	                wxObj.getPrivacySetting({
	                    success: (res: any) => {
	                        console.log('[KYC-Personal][Privacy] getPrivacySetting success:', JSON.stringify(res))
	                        if (res != null && res.needAuthorization === true && typeof wxObj.requirePrivacyAuthorize === 'function') {
	                            console.log('[KYC-Personal][Privacy] 需要隐私授权，调用 requirePrivacyAuthorize')
	                            wxObj.requirePrivacyAuthorize({
	                                success: () => {
	                                    console.log('[KYC-Personal][Privacy] requirePrivacyAuthorize success')
	                                    onGranted()
	                                },
	                                fail: (error: any) => {
	                                    console.error('[KYC-Personal][Privacy] requirePrivacyAuthorize fail:', JSON.stringify(error))
	                                    this.handleCameraOpenFail(error)
	                                }
	                            })
	                            return
	                        }
	                        onGranted()
	                    },
	                    fail: () => {
	                        console.warn('[KYC-Personal][Privacy] getPrivacySetting fail，继续尝试媒体API')
	                        onGranted()
	                    }
	                })
	                return
	            }
	            // #endif
	            console.log('[KYC-Personal][Privacy] 非微信或无隐私API，直接继续')
	            onGranted()
	        },

	        chooseImageCameraFallback(useFrontCamera: boolean, onSuccess: (filePath: string) => void): void {
	            console.log('[KYC-Personal][Media] 使用 chooseImage fallback, useFrontCamera=', useFrontCamera)
	            const cameraOptions: any = {
	                count: 1,
	                sizeType: ['compressed'],
	                sourceType: ['camera'],
	                quality: 85,
	                success: (res: any) => {
	                    console.log('[KYC-Personal][Media] chooseImage success:', JSON.stringify(res))
	                    if (res == null || res.tempFilePaths == null || res.tempFilePaths.length === 0) {
	                        this.handleCameraOpenFail(new Error('未获取到照片路径'))
	                        return
	                    }
	                    onSuccess(res.tempFilePaths[0] as string)
	                },
	                fail: (error: any) => {
	                    console.error('[KYC-Personal][Media] chooseImage fail:', JSON.stringify(error))
	                    this.handleCameraOpenFail(error)
	                },
	                complete: (res: any) => {
	                    console.log('[KYC-Personal][Media] chooseImage complete:', JSON.stringify(res))
	                }
	            }
	            if (useFrontCamera) {
	                cameraOptions.camera = 'front'
	            }
	            uni.chooseImage(cameraOptions)
	        },

	        isMediaAuthorizationError(error: any): boolean {
	            let errMsg = ''
	            if (error != null && (error as any).errMsg != null) {
	                errMsg = (error as any).errMsg as string
	            } else if (error != null && (error as Error).message != null) {
	                errMsg = (error as Error).message
	            }
	            const lowerMsg = errMsg.toLowerCase()
	            return lowerMsg.indexOf('cancel') >= 0
	                || lowerMsg.indexOf('privacy') >= 0
	                || lowerMsg.indexOf('requiredprivateinfos') >= 0
	                || lowerMsg.indexOf('declared') >= 0
	                || lowerMsg.indexOf('隐私') >= 0
	                || lowerMsg.indexOf('auth') >= 0
	                || lowerMsg.indexOf('authorize') >= 0
	                || lowerMsg.indexOf('permission') >= 0
	                || lowerMsg.indexOf('denied') >= 0
	                || lowerMsg.indexOf('scope.camera') >= 0
	        },

	        handleCameraOpenFail(error: any): void {
	            uni.hideLoading()
	            console.error('拍照失败:', error)
	            let errMsg = ''
	            if (error != null && (error as any).errMsg != null) {
	                errMsg = (error as any).errMsg as string
	            } else if (error != null && (error as Error).message != null) {
	                errMsg = (error as Error).message
	            }
	            const lowerMsg = errMsg.toLowerCase()
	            if (lowerMsg.indexOf('cancel') >= 0) {
	                uni.showToast({
	                    title: '已取消拍照',
	                    icon: 'none'
	                })
	                return
	            }
	            const permissionDenied = lowerMsg.indexOf('auth') >= 0
	                || lowerMsg.indexOf('authorize') >= 0
	                || lowerMsg.indexOf('permission') >= 0
	                || lowerMsg.indexOf('denied') >= 0
	                || lowerMsg.indexOf('scope.camera') >= 0
	            const privacyBlocked = lowerMsg.indexOf('privacy') >= 0
	                || lowerMsg.indexOf('requiredprivateinfos') >= 0
	                || lowerMsg.indexOf('declared') >= 0
	                || lowerMsg.indexOf('隐私') >= 0
	            if (privacyBlocked) {
	                const privacyMessage = errMsg
	                    ? `拍照上传需要先同意小程序隐私协议。\n\n微信返回：${errMsg}`
	                    : '拍照上传需要先同意小程序隐私协议；如果仍无法打开，请检查微信公众平台隐私协议是否已声明图片/相机用途。'
	                uni.showModal({
	                    title: '需要隐私授权',
	                    content: privacyMessage,
	                    showCancel: false
	                })
	                return
	            }
	            if (permissionDenied) {
	                uni.showModal({
	                    title: '需要相机权限',
	                    content: '实名认证需要拍摄身份证和人脸照片，请在设置中允许使用相机。',
	                    confirmText: '去设置',
	                    success: (res) => {
	                        if (res.confirm) {
	                            uni.openSetting({})
	                        }
	                    }
	                })
	                return
	            }
	            uni.showToast({
	                title: '无法打开相机，请检查权限后重试',
	                icon: 'none',
	                duration: 3000
	            })
	        },

	        chooseFaceImageByH5Input(): void {
	            const documentObj = document as any
	            if (documentObj == null || typeof documentObj.createElement !== 'function') {
	                uni.hideLoading()
	                this.showUploadError('当前浏览器不支持前置拍照，请检查权限后重试')
	                return
	            }

	            const input = documentObj.createElement('input') as any
	            input.type = 'file'
	            input.accept = 'image/*'
	            input.capture = 'user'
	            input.style.display = 'none'

	            input.onchange = () => {
	                const files = input.files
	                if (files == null || files.length === 0) {
	                    uni.hideLoading()
	                    return
	                }

	                const file = files[0]
	                const urlObj = URL as any
	                if (urlObj == null || typeof urlObj.createObjectURL !== 'function') {
	                    uni.hideLoading()
	                    this.showUploadError('当前浏览器不支持照片读取，请重试')
	                    return
	                }
	                const objectUrl = urlObj.createObjectURL(file)
	                this.handleCameraSuccess({
	                    tempFilePaths: [objectUrl]
	                })
	                if (input.parentNode != null) {
	                    input.parentNode.removeChild(input)
	                }
	            }

	            input.onerror = () => {
	                uni.hideLoading()
	                this.showUploadError('拍照失败，请重试')
	                if (input.parentNode != null) {
	                    input.parentNode.removeChild(input)
	                }
	            }

	            if (documentObj.body == null) {
	                uni.hideLoading()
	                this.showUploadError('当前浏览器不支持拍照上传，请重试')
	                return
	            }

	            uni.hideLoading()
	            documentObj.body.appendChild(input)
	            input.click()
	        },

		/**
		 * 从 chooser/相机 返回的临时路径解析图片扩展名（避免 H5 URL、blob、域名中带点导致误判）
		 */
		getSafeImageExtensionForPath(filePath: string): string {
			const pathOnly = (filePath.split('?')[0] ?? '').split('#')[0] ?? ''
			const slashIdx = pathOnly.lastIndexOf('/')
			const base = slashIdx >= 0 ? pathOnly.substring(slashIdx + 1) : pathOnly
			const dotIdx = base.lastIndexOf('.')
			let ext = 'jpg'
			if (dotIdx > 0 && dotIdx < base.length - 1) {
				ext = base.substring(dotIdx + 1).toLowerCase()
				/* 去掉路径里误当成扩展名的片段 */
				if (ext.indexOf('/') >= 0 || ext.indexOf('\\') >= 0 || ext.length > 8) {
					ext = 'jpg'
				}
			}
			if (!UPLOAD_CONFIG.ALLOWED_TYPES.IMAGE.includes(ext)) {
				/* 无扩展名或非常规格式：相机场景按 jpeg 处理 */
				ext = 'jpg'
			}
			return ext
		},

        // 处理相机拍照成功的回调
        handleCameraSuccess(res: any): void {
                        try {
                            // 获取临时文件路径
                            const tempFilePath = res.tempFilePaths[0]
                            console.log('拍照成功，临时文件路径:', tempFilePath)
                
                // 获取文件信息，验证文件大小
                uni.getFileInfo({
                    filePath: tempFilePath,
                    success: (fileInfo) => {
                        const fileExtension = this.getSafeImageExtensionForPath(tempFilePath)
                        console.log('解析后的上传扩展名:', fileExtension)

                        if (fileInfo.size > FACE_IMAGE_UPLOAD_TARGET_BYTES) {
                            console.log('人脸照片超过限制，尝试压缩:', fileInfo.size)
                            this.compressFaceImageAndUpload(tempFilePath, fileExtension, 55)
                            return
                        }
                        
                        // 开始上传流程
                        this.uploadFaceImage(tempFilePath, fileExtension)
                    },
                    fail: (error) => {
                        uni.hideLoading()
                        console.error('获取文件信息失败:', error)
                        this.showUploadError('无法获取照片信息，请重试')
                    }
                })
            } catch (processError) {
                console.error('处理照片时发生错误:', processError)
                uni.hideLoading()
                this.showUploadError('处理照片失败，请重试')
            }
        },

	        // 压缩人脸照片后上传：H5 使用 canvas，避免公众号环境 uni.compressImage 无回调导致超时。
	        compressFaceImageAndUpload(filePath: string, fileExtension: string, quality: number): void {
	            uni.showLoading({
	                title: '正在压缩照片...'
	            })

	            this.compressImageToTarget(filePath, FACE_IMAGE_UPLOAD_TARGET_BYTES, quality, 15)
	                .then((compressedPath: string) => {
	                    console.log('人脸照片压缩完成:', compressedPath)
	                    this.uploadFaceImage(compressedPath, fileExtension)
	                })
	                .catch((error: Error) => {
	                    uni.hideLoading()
	                    console.error('压缩照片失败:', error)
	                    const message = error.message || `照片超过${FACE_IMAGE_MAX_SIZE_MB}MB，请重新拍摄`
	                    this.showUploadError(message)
	                })
	        },

        // 上传人脸照片
        uploadFaceImage(filePath: string, fileExtension: string): void {
            // 重置上传状态
            this.uploadStatus.inProgress = true
            this.uploadStatus.progress = 0
            this.uploadStatus.error = false
            this.uploadStatus.errorMessage = ''
            
            // 确保文件名带有扩展名和随机性
                            const timestamp = new Date().getTime()
            const randomPart = Math.floor(Math.random() * 10000)
            const customFileName = `face_verify_${timestamp}_${randomPart}.${fileExtension}`
                            console.log('生成的自定义文件名:', customFileName)
                            
                            // 显示进度提示
                            uni.hideLoading()
                            uni.showLoading({
                title: '准备上传...'
                            })
                            
            // 使用前端直传模式上传照片
                            const uploadOptions: {
                                fileName?: string;
                                directory?: string;
                                fileType?: string;
                                onProgress?: (percent: number) => void;
                                expirationHours?: number;
                            } = {
                                fileName: customFileName,
                                directory: UPLOAD_CONFIG.DIRECTORIES.VERIFY,
                // 设置过期时间为24小时，确保未使用的照片会自动删除
                expirationHours: UPLOAD_CONFIG.EXPIRATION.VERIFY, 
                                onProgress: (percent: number) => {
                                    console.log('上传进度:', percent)
                    this.uploadStatus.progress = percent
                                    
                                    // 更新加载提示
                                    if (percent > 0 && percent < 100) {
                                        uni.hideLoading()
                                        uni.showLoading({
                                            title: `上传中 ${percent}%`
                                        })
                                    }
                                }
                            }
                            
            // 优先使用uploadFileAdvanced直传模式，自动处理各种上传异常
            uploadFileAdvanced(filePath, uploadOptions)
                            .then((fileUrl: string) => {
                                // 保存服务器返回的图片URL
                                console.log('照片上传成功，URL:', fileUrl)
                
                // 验证返回的URL是否有效
                if (!fileUrl || fileUrl.trim().length === 0) {
                    throw new Error('返回的文件URL无效')
                }
                                
                                // 验证返回的URL是否包含扩展名
                                if (!fileUrl.includes('.')) {
                                    console.warn('返回的URL不包含扩展名，尝试添加扩展名')
                                    fileUrl = `${fileUrl}.${fileExtension}`
                                }
                                
                // 更新上传状态
                this.uploadStatus.inProgress = false
                this.uploadStatus.progress = 100
                this.retryCount = 0 // 重置重试计数器
                
                // 仅表示文件上传成功；人脸与身份证是否一致由提交认证时后端 MemberVerifyService 核验
                                this.userInfo.faceImage = fileUrl
                                this.userInfo.faceVerified = true
                                
                                uni.hideLoading()
                                uni.showToast({
                                    title: '照片已上传，请提交认证完成核验',
                                    icon: 'success'
                                })
                            })
                            .catch((error: Error) => {
                                console.error('照片上传失败:', error)
                                uni.hideLoading()
                
                // 更新上传状态
                this.uploadStatus.inProgress = false
                this.uploadStatus.error = true
                this.uploadStatus.errorMessage = error.message || '未知错误'
                
                this.showUploadError('照片上传失败: ' + error.message)
            })
        },

        // 显示上传错误
        showUploadError(message: string): void {
                                uni.showToast({
                title: message,
                                    icon: 'none',
                                    duration: 3000
                                })
        },

        // 重试上传
        retryUpload(): void {
            // 检查是否已达到最大重试次数
            if (this.retryCount >= this.maxRetries) {
                        uni.showToast({
                    title: '已达到最大重试次数，请重新拍照',
                    icon: 'none',
                    duration: 3000
                })
                return
            }
            
            // 增加重试计数
            this.retryCount++
            
            // 开始重新拍照流程
            this.confirmGuidanceAndStartCamera()
		},
		
		// 提交认证
		submitVerification(): void {
			if (this.isSubmitting) return
			
			this.isSubmitting = true
			
			// 显示提交中
			uni.showLoading({
				title: '提交认证信息...'
			})
			
            // 验证表单数据
            if (!this.validateSubmitData()) {
                uni.hideLoading()
                this.isSubmitting = false
                return
            }
            
            // 准备请求参数（根据API文档）
            const requestData = {
                name: this.userInfo.realName,
                idCard: this.userInfo.idCardNumber,
                faceImage: this.userInfo.faceImage // 这里应该是服务器返回的URL
            }
            
            console.log('提交认证信息:', JSON.stringify(requestData))
            
            // 使用封装的API调用提交认证
            post('/api/v1/member/verify/submit', requestData)
                .then((verifyResult: any) => {
                    uni.hideLoading()
                    this.isSubmitting = false
                    
                    console.log('认证结果:', JSON.stringify(verifyResult))
                    
                    // 根据认证结果更新页面状态
                    if (verifyResult && verifyResult.verifyStatus !== undefined) {
                        if (verifyResult.verifyStatus === 2) {
                            // 认证成功
                            this.verificationStatus = 'success'
                            
                            uni.showToast({
                                title: '认证成功',
                                icon: 'success'
                            })
                            
                            // 保存认证状态到本地存储（兼容旧版本）
                            uni.setStorageSync('kycStatus', 'true')
                            
                            // 延迟返回上一页
                            setTimeout(() => {
                                uni.navigateBack()
                            }, 1500)
                        } else if (verifyResult.verifyStatus === 3) {
                            // 认证失败
                            this.verificationStatus = 'failed'
                            this.failedReason = verifyResult.failReason || '认证未通过，请重新提交'
                            
                            uni.showToast({
                                title: '认证失败',
                                icon: 'none'
                            })
                        } else if (verifyResult.verifyStatus === 1) {
                            // 审核中状态
                            this.verificationStatus = 'pending'
                            
                            uni.showToast({
                                title: '提交成功，等待审核',
                                icon: 'success'
                            })
                            
                            // 延迟返回上一页
                            setTimeout(() => {
                                uni.navigateBack()
                            }, 1500)
                        } else if (verifyResult.verifyStatus === 0) {
                            // 未认证（理论上不会出现此状态，但为了完整性添加）
                            this.verificationStatus = 'none'
                            
                            uni.showToast({
                                title: '认证未开始',
                                icon: 'none'
                            })
                        }
                    } else {
                        // 请求成功但数据异常
                        uni.showToast({
                            title: '提交失败: 返回数据格式错误',
                            icon: 'none'
                        })
                    }
                })
                .catch((err: Error) => {
                    uni.hideLoading()
                    this.isSubmitting = false
                    console.error('认证提交失败:', err)
                    
                    uni.showToast({
                        title: '提交失败: ' + err.message,
                        icon: 'none'
                    })
                })
		},
		
		// 验证提交数据
		validateSubmitData(): boolean {
            // 验证姓名
            if (!this.userInfo.realName || this.userInfo.realName.trim().length < 2) {
                uni.showToast({
                    title: '请输入正确的姓名',
                    icon: 'none'
                })
                return false
            }
            
            // 验证身份证号
            if (!this.userInfo.idCardNumber || !/^[1-9]\d{5}(18|19|20)\d{2}((0[1-9])|(1[0-2]))(([0-2][1-9])|10|20|30|31)\d{3}[0-9Xx]$/.test(this.userInfo.idCardNumber)) {
                uni.showToast({
                    title: '请输入正确的身份证号',
                    icon: 'none'
                })
                return false
            }
            
            // 验证是否有照片URL
            if (!this.userInfo.faceImage) {
                uni.showToast({
                    title: '请先完成人脸采集',
                    icon: 'none'
                })
                return false
            }
            
            // 验证图片URL格式是否正确
            if (!this.isValidImageUrl(this.userInfo.faceImage)) {
                uni.showToast({
                    title: '照片格式不正确，请重新拍摄',
                    icon: 'none'
                })
                return false
            }
            
            return true
        },

        // 验证图片URL是否合法
        isValidImageUrl(url: string): boolean {
            if (!url || typeof url !== 'string') {
                return false
            }
            
            // 检查是否是URL格式
            if (!url.startsWith('http://') && !url.startsWith('https://')) {
                return false
            }
            
            // 检查是否包含文件扩展名
            const hasImageExtension = /\.(jpg|jpeg|png|gif|webp)$/i.test(url)
            
            // 检查URL长度
            const validLength = url.length > 10 && url.length < 1024
            
            return hasImageExtension && validLength
		},
		
		// 重新提交认证
		resubmit(): void {
			// 重置认证状态
			this.verificationStatus = 'none'
			this.failedReason = ''
			this.currentStep = 1
            this.userInfo.faceVerified = false
            this.userInfo.faceImage = ''
		},

        // 是否为人脸照片大小导致的失败
        isFaceSizeFailure(): boolean {
            const reason = this.failedReason || ''
            return reason.indexOf('文件过大') >= 0 || reason.indexOf('照片文件过大') >= 0 || reason.indexOf('1MB') >= 0 || reason.indexOf('2MB') >= 0
        }
	}
}
</script>

<template>
	<view class="kyc-page-root">
		<scroll-view class="kyc-page-scroll" scroll-y="true" enable-back-to-top="true">
			<view class="kyc-container">
		<!-- 认证状态显示 -->
		<block v-if="verificationStatus !== 'none'">
			<view class="status-container">
				<view class="status-icon-container" :class="[
					verificationStatus === 'pending' ? 'pending' : '',
					verificationStatus === 'success' ? 'success' : '',
					verificationStatus === 'failed' ? 'failed' : ''
				]">
					<text class="icon" :class="[
						verificationStatus === 'pending' ? 'icon-spinner' : '',
						verificationStatus === 'success' ? 'icon-check' : '',
						verificationStatus === 'failed' ? 'icon-close' : ''
					]"></text>
				</view>

				<text class="status-title" :class="[
					verificationStatus === 'pending' ? 'pending' : '',
					verificationStatus === 'success' ? 'success' : '',
					verificationStatus === 'failed' ? 'failed' : ''
				]">
					{{ verificationStatus === 'pending' ? '认证审核中' : 
					   verificationStatus === 'success' ? '认证已通过' : '认证未通过' }}
				</text>

				<text class="status-desc" v-if="verificationStatus === 'pending'">
					您的认证信息已提交，正在审核中，请耐心等待
				</text>
				<text class="status-desc" v-else-if="verificationStatus === 'success'">
					您的实名认证已通过，可以使用所有功能
				</text>
				<view class="failed-detail-card" v-else-if="verificationStatus === 'failed'">
					<text class="failed-label">失败原因</text>
					<text class="failed-reason">{{ failedReason || '认证未通过，请重新提交' }}</text>
					<view class="failed-suggestion" v-if="isFaceSizeFailure()">
						<text class="suggestion-title">建议处理</text>
						<text class="suggestion-text">请重新拍摄人脸照片，系统会自动压缩到约{{maxFaceImageSizeMB}}MB以内后再上传。</text>
					</view>
					<view class="failed-suggestion" v-else>
						<text class="suggestion-title">建议处理</text>
						<text class="suggestion-text">请确认姓名、身份证号和本人正脸照片一致，光线充足且无遮挡后重新提交。</text>
					</view>
				</view>
				
				<view class="status-button-container" v-if="verificationStatus === 'failed'">
					<view class="resubmit-button" @click="resubmit">
						<text class="button-text">重新拍摄并提交</text>
					</view>
				</view>
			</view>
		</block>
		
		<!-- 认证表单 -->
		<block v-else>
			<!-- 步骤指示器 -->
			<view class="step-indicator">
				<view v-for="(step, index) in stepIndicators" :key="index" 
					  class="step-item" :class="{ 'active': index + 1 === currentStep, 'completed': index + 1 < currentStep }">
					<view class="step-circle">
						<text class="step-number" v-if="index + 1 >= currentStep">{{ index + 1 }}</text>
						<text class="icon icon-check step-check" v-else></text>
					</view>
					<text class="step-label">{{ step }}</text>
				</view>
				
				<view class="step-line"></view>
			</view>
			
			<!-- 步骤1：填写个人信息 -->
			<view class="step-content" v-if="currentStep === 1">
				<!-- OCR识别按钮 -->
				<view class="ocr-section">
					<view class="ocr-button" @click="startOcrCapture" :class="{ 'disabled': ocrProcessing }">
						<view class="ocr-icon-wrapper">
							<text class="fa fa-id-card ocr-icon"></text>
						</view>
						<view class="ocr-content">
							<text class="ocr-title">拍摄身份证自动识别</text>
							<text class="ocr-desc">{{ ocrProcessing ? '识别中...' : '点击拍摄并自动填充信息' }}</text>
						</view>
						<text class="fa fa-camera ocr-arrow"></text>
					</view>
					
					<!-- OCR识别结果提示 -->
					<view class="ocr-result-tip" v-if="ocrResult && ocrResult.success">
						<text class="fa fa-check-circle tip-icon"></text>
						<text class="tip-text">识别成功，信息已自动填充，请确认</text>
					</view>
				</view>
				
				<view class="form-group">
					<text class="form-label">真实姓名</text>
					<input class="form-input" v-model="userInfo.realName" placeholder="请输入您的真实姓名" 
						   @blur="validateName" />
					<text class="error-message" v-if="!validation.realName.valid">
						{{ validation.realName.message }}
					</text>
				</view>
				
					<view class="form-group">
						<text class="form-label">身份证号码</text>
						<input class="form-input" v-model="userInfo.idCardNumber" placeholder="请输入您的身份证号码"
							   type="idcard" maxlength="18" confirm-type="done"
							   @input="handleIdCardInput" @blur="validateIdCard" />
						<text class="error-message" v-if="!validation.idCardNumber.valid">
							{{ validation.idCardNumber.message }}
						</text>
				</view>
				
				<view class="form-tips">
					<text class="fa fa-info-circle tips-icon"></text>
					<text class="tips-text">请确保填写的信息真实有效，认证通过后将无法修改</text>
				</view>
				
				<view class="step-actions">
					<view class="action-button primary" 
						  :class="{ 'disabled': !canProceed }" 
						  @click="canProceed ? nextStep() : null">
						<text>下一步</text>
					</view>
				</view>
			</view>
			
			<!-- 步骤2：人脸识别 -->
			<view class="step-content" v-else-if="currentStep === 2">
				<view class="face-verify-container">
					<view class="face-icon-container">
						<text class="icon icon-user face-icon"></text>
					</view>
					<text class="face-title">人脸照片采集</text>
					<text class="face-desc">请本人正脸出镜拍摄；本页仅在确认照片已成功上传。是否与身份证匹配，将在您点击「提交认证」后由服务端做人脸核验。</text>
					
					<!-- 上传状态显示 -->
					<view class="upload-status-container" v-if="uploadStatus.inProgress">
						<text class="upload-status-text">上传中 {{ uploadStatus.progress }}%</text>
						<view class="progress-bar-bg">
							<view class="progress-bar-fill" :style="{ width: uploadStatus.progress + '%' }"></view>
						</view>
					</view>
					
					<!-- 错误状态显示 -->
					<view class="upload-error-container" v-else-if="uploadStatus.error">
						<view class="upload-error-icon">
							<text class="icon icon-exclamation-circle"></text>
						</view>
						<text class="upload-error-text">{{ uploadStatus.errorMessage }}</text>
						<view class="upload-error-action">
							<view class="retry-button" @click="retryUpload">
								<text class="icon icon-redo retry-icon"></text>
								<text class="retry-text">重新尝试</text>
							</view>
						</view>
					</view>
					
					<!-- 人脸验证按钮 -->
					<view class="face-button-container" v-if="!userInfo.faceVerified && !uploadStatus.inProgress && !uploadStatus.error">
						<view class="face-button" @click="startFaceVerification">
							<text class="icon icon-camera button-icon"></text>
							<text>拍摄人脸照片</text>
						</view>
					</view>
					
					<!-- 上传成功（非服务端人脸比对结果） -->
					<view class="face-verified" v-if="userInfo.faceVerified">
						<view class="face-verified-main">
							<text class="icon icon-check verified-icon"></text>
							<text class="verified-text">人脸照片已上传</text>
						</view>
						<text class="verified-hint">提交认证后，系统将把本照片与身份证信息做人脸比对；若照片非本人正脸，认证将失败。</text>
					</view>
					
					<!-- 拍照提示列表 -->
					<view class="face-tips">
						<text class="tips-title">拍照要求:</text>
						<view class="tips-item" v-for="(tip, index) in guidanceTips" :key="index">
							<text class="tips-dot">•</text>
							<text class="tips-content">{{ tip }}</text>
						</view>
					</view>
				</view>
				
					<view class="step-actions verify-actions">
						<view class="action-button secondary" @click="prevStep">
							<text>上一步</text>
						</view>
					<view class="action-button primary" 
						  :class="{ 'disabled': !canProceed }" 
						  @click="canProceed ? submitVerification() : null">
						<text>提交认证</text>
					</view>
				</view>
			</view>
		</block>
			<!-- 底部占位：移动端浏览器工具栏/主页条会盖住最后一截，需额外可滚动空白 -->
			<view class="kyc-scroll-spacer"></view>
			</view>
		</scroll-view>
		
		<!-- 固定层弹窗：放在 scroll-view 外，避免 H5 滚动失效 -->
		<block v-if="verificationStatus === 'none'">
			<!-- 人脸识别指导弹窗 -->
			<view class="modal-overlay" v-if="faceGuidanceVisible" @click="faceGuidanceVisible = false">
				<view class="modal-content" @click.stop>
					<view class="modal-header">
						<text class="modal-title">人脸拍摄指南</text>
					</view>
					<scroll-view class="modal-body-scroll" scroll-y="true">
						<view class="modal-body">
							<!-- 文字提示 -->
							<view class="guidance-item" v-for="(tip, index) in guidanceTips" :key="index">
								<text class="guidance-number">{{ index + 1 }}.</text>
								<text class="guidance-text">{{ tip }}</text>
							</view>
							
							<!-- 人脸轮廓示意图 -->
							<view class="face-outline-container">
								<view class="face-outline">
									<view class="face-outline-border"></view>
								</view>
								<text class="face-outline-tip">识别时请确保半米内无其他游客</text>
							</view>
							
							<!-- 图标化注意事项 -->
							<view class="icon-tips-container">
								<view class="icon-tip-item" v-for="(tip, index) in iconTips" :key="index">
									<view class="icon-tip-circle">
										<text class="icon" :class="tip.icon"></text>
										<view class="icon-tip-slash"></view>
									</view>
									<text class="icon-tip-text">{{ tip.text }}</text>
								</view>
							</view>
						</view>
					</scroll-view>
					<view class="modal-footer">
						<view class="modal-button" @click="confirmGuidanceAndStartCamera">
							<text>知道了，开始拍摄</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- OCR识别指导弹窗 -->
			<view class="modal-overlay" v-if="showOcrGuidance" @click="showOcrGuidance = false">
				<view class="modal-content" @click.stop>
					<view class="modal-header">
						<text class="modal-title">身份证拍摄指南</text>
					</view>
					<scroll-view class="modal-body-scroll" scroll-y="true">
						<view class="modal-body">
							<!-- 文字提示 -->
							<view class="guidance-item" v-for="(tip, index) in ocrGuidanceTips" :key="index">
								<text class="guidance-number">{{ index + 1 }}.</text>
								<text class="guidance-text">{{ tip }}</text>
							</view>
							
							<!-- 身份证示意图 -->
							<view class="idcard-demo-container">
								<view class="idcard-demo">
									<text class="demo-text">身份证正面</text>
								</view>
							</view>
						</view>
					</scroll-view>
					<view class="modal-footer">
						<view class="modal-button" @click="confirmOcrGuidanceAndCapture">
							<text>知道了，开始拍摄</text>
						</view>
					</view>
				</view>
			</view>
		</block>
	</view>
</template>

<style>
/* 整页可滚动：H5/小程序避免内容超高时底部按钮被挡在可视区域外 */
.kyc-page-root {
	flex: 1;
	flex-direction: column;
	width: 100%;
	min-height: 0;
}

.kyc-page-scroll {
	flex: 1;
	width: 100%;
	height: 0;
	min-height: 0;
}

/* #ifdef H5 */
/*
 * H5：移动端 100vh 往往大于「实际可见高度」（底部浏览器栏、工具条）。
 * 缩小 scroll 可视区并加大底部 spacer，避免最后一屏按钮只露出一截。
 */
.kyc-page-root {
	height: 100vh;
	flex-direction: column;
}
.kyc-page-scroll {
	flex: none;
	height: calc(100vh - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px) - 88px);
	max-height: calc(100vh - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px) - 88px);
}
/* #endif */

.kyc-container {
	width: 100%;
	background-color: #F8F8F8;
	padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
	padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.kyc-scroll-spacer {
	width: 100%;
	height: 200rpx;
	flex-shrink: 0;
}

/* #ifdef H5 */
.kyc-scroll-spacer {
	height: calc(180rpx + env(safe-area-inset-bottom, 0px) + 56px);
	min-height: 200rpx;
}
/* #endif */

/* 认证状态 */
.status-container {
	margin: 60rpx 40rpx;
	background-color: #FFFFFF;
	border-radius: 16rpx;
	padding: 40rpx;
	align-items: center;
	box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.status-icon-container {
	width: 120rpx;
	height: 120rpx;
	border-radius: 60rpx;
	align-items: center;
	justify-content: center;
	margin-bottom: 30rpx;
}

.status-icon-container.pending {
	background-color: rgba(250, 173, 20, 0.1);
}

.status-icon-container.success {
	background-color: rgba(0, 194, 138, 0.1);
}

.status-icon-container.failed {
	background-color: rgba(255, 77, 79, 0.1);
}

.status-icon-container .icon {
	font-size: 60rpx;
}

.status-icon-container.pending .icon {
	color: #FAAD14;
}

.status-icon-container.success .icon {
	color: #00C28A;
}

.status-icon-container.failed .icon {
	color: #FF4D4F;
}

.status-title {
	font-size: 36rpx;
	font-weight: bold;
	margin-bottom: 20rpx;
}

.status-title.pending {
	color: #FAAD14;
}

.status-title.success {
	color: #00C28A;
}

.status-title.failed {
	color: #FF4D4F;
}

.status-desc {
	font-size: 28rpx;
	color: #666666;
	text-align: center;
	margin-bottom: 40rpx;
}

.failed-detail-card {
	width: 100%;
	background-color: #FFF7F7;
	border-radius: 16rpx;
	padding: 24rpx;
	margin-bottom: 28rpx;
	border: 1rpx solid rgba(255, 77, 79, 0.18);
}

.failed-label {
	font-size: 24rpx;
	color: #FF4D4F;
	font-weight: bold;
	margin-bottom: 12rpx;
}

.failed-reason {
	font-size: 28rpx;
	color: #4A4A4A;
	line-height: 44rpx;
}

.failed-suggestion {
	margin-top: 20rpx;
	padding-top: 20rpx;
	border-top: 1rpx solid rgba(255, 77, 79, 0.14);
}

.suggestion-title {
	font-size: 24rpx;
	color: #303133;
	font-weight: bold;
	margin-bottom: 8rpx;
}

.suggestion-text {
	font-size: 26rpx;
	color: #666666;
	line-height: 40rpx;
}

.status-button-container {
	margin-top: 20rpx;
}

.resubmit-button {
	background-color: #00C28A;
	height: 80rpx;
	width: 360rpx;
	border-radius: 8rpx;
	align-items: center;
	justify-content: center;
}

.button-text {
	color: #FFFFFF;
	font-size: 28rpx;
}

/* 步骤指示器 */
.step-indicator {
	flex-direction: row;
	justify-content: space-between;
	padding: 40rpx 60rpx;
	background-color: #FFFFFF;
	position: relative;
	margin-top: 20rpx;
	margin-bottom: 20rpx;
}

.step-item {
	align-items: center;
	z-index: 1;
}

.step-circle {
	width: 50rpx;
	height: 50rpx;
	border-radius: 25rpx;
	background-color: #EEEEEE;
	align-items: center;
	justify-content: center;
	margin-bottom: 10rpx;
}

.step-item.active .step-circle {
	background-color: #00C28A;
}

.step-item.completed .step-circle {
	background-color: #00C28A;
}

.step-number {
	color: #999999;
	font-size: 24rpx;
}

.step-item.active .step-number {
	color: #FFFFFF;
}

.step-check {
	color: #FFFFFF;
	font-size: 24rpx;
}

.step-label {
	font-size: 24rpx;
	color: #999999;
}

.step-item.active .step-label {
	color: #00C28A;
	font-weight: bold;
}

.step-item.completed .step-label {
	color: #00C28A;
}

.step-line {
	position: absolute;
	height: 2rpx;
	background-color: #EEEEEE;
	top: 65rpx;
	left: 85rpx;
	right: 85rpx;
}

/* 表单样式 */
.step-content {
	margin: 20rpx 40rpx;
	background-color: #FFFFFF;
	border-radius: 20rpx;
	padding: 30rpx;
}

/* OCR识别区域 */
.ocr-section {
	margin-bottom: 30rpx;
}

.ocr-button {
	background-color: #FFFFFF;
	border-radius: 20rpx;
	padding: 30rpx;
	flex-direction: row;
	align-items: center;
	box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
	border-width: 2rpx;
	border-color: #0A2E5C;
	border-style: dashed;
}

.ocr-button:active {
	background-color: #F7F9FC;
}

.ocr-button.disabled {
	opacity: 0.6;
}

.ocr-icon-wrapper {
	width: 80rpx;
	height: 80rpx;
	border-radius: 40rpx;
	background-color: rgba(10, 46, 92, 0.1);
	align-items: center;
	justify-content: center;
	margin-right: 20rpx;
}

.ocr-icon {
	font-size: 40rpx;
	color: #0A2E5C;
}

.ocr-content {
	flex: 1;
}

.ocr-title {
	font-size: 30rpx;
	font-weight: 500;
	color: #333333;
	margin-bottom: 8rpx;
}

.ocr-desc {
	font-size: 24rpx;
	color: #999999;
}

.ocr-arrow {
	font-size: 28rpx;
	color: #999999;
}

.ocr-result-tip {
	flex-direction: row;
	align-items: center;
	background-color: rgba(0, 194, 138, 0.1);
	padding: 16rpx 20rpx;
	border-radius: 10rpx;
	margin-top: 20rpx;
}

.ocr-result-tip .tip-icon {
	font-size: 24rpx;
	color: #00C28A;
	margin-right: 10rpx;
}

.ocr-result-tip .tip-text {
	font-size: 24rpx;
	color: #00C28A;
	flex: 1;
}

.form-group {
	margin-bottom: 30rpx;
}

.form-label {
	font-size: 28rpx;
	color: #333333;
	margin-bottom: 12rpx;
	font-weight: 500;
}

.form-input {
	height: 90rpx;
	border-width: 1rpx;
	border-color: #E6E6E6;
	border-radius: 8rpx;
	padding: 0 20rpx;
	font-size: 28rpx;
	color: #333333;
	background-color: #FAFAFA;
}

.error-message {
	font-size: 24rpx;
	color: #FF4D4F;
	margin-top: 8rpx;
}

.form-tips {
	flex-direction: row;
	align-items: center;
	background-color: rgba(250, 173, 20, 0.1);
	padding: 16rpx 20rpx;
	border-radius: 8rpx;
}

.tips-icon {
	font-size: 24rpx;
	color: #FAAD14;
	margin-right: 10rpx;
}

.tips-text {
	font-size: 24rpx;
	color: #666666;
	flex: 1;
}

/* 人脸识别 */
.face-verify-container {
	align-items: center;
	padding: 30rpx 0;
}

.face-icon-container {
	width: 120rpx;
	height: 120rpx;
	border-radius: 60rpx;
	background-color: rgba(0, 194, 138, 0.1);
	align-items: center;
	justify-content: center;
	margin-bottom: 20rpx;
}

.face-icon {
	font-size: 60rpx;
	color: #00C28A;
}

.face-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #333333;
	margin-bottom: 12rpx;
}

.face-desc {
	font-size: 26rpx;
	color: #666666;
	margin-bottom: 40rpx;
	text-align: center;
}

/* 上传进度条 */
.upload-progress-container {
	width: 100%;
	margin-bottom: 30rpx;
}

.progress-text {
	font-size: 24rpx;
	color: #666666;
	margin-bottom: 10rpx;
	text-align: center;
}

.progress-bar-bg {
	width: 100%;
	height: 10rpx;
	background-color: #EEEEEE;
	border-radius: 5rpx;
	overflow: hidden;
}

.progress-bar-fill {
	height: 100%;
	background-color: #00C28A;
	border-radius: 5rpx;
	transition: width 0.3s;
}

.face-button-container {
	margin-bottom: 20rpx;
}

.face-button {
	background-color: #00C28A;
	color: #FFFFFF;
	font-size: 32rpx;
	height: 90rpx;
	width: 400rpx;
	border-radius: 8rpx;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.button-icon {
	font-size: 32rpx;
	margin-right: 10rpx;
}

.face-verified {
	flex-direction: column;
	align-items: stretch;
	background-color: rgba(0, 194, 138, 0.1);
	padding: 20rpx 40rpx;
	border-radius: 8rpx;
	width: 100%;
}

.face-verified-main {
	flex-direction: row;
	align-items: center;
}

.verified-icon {
	font-size: 32rpx;
	color: #00C28A;
	margin-right: 10rpx;
}

.verified-text {
	font-size: 28rpx;
	color: #00C28A;
}

.verified-hint {
	font-size: 24rpx;
	color: #606266;
	line-height: 36rpx;
	margin-top: 12rpx;
	padding-left: 42rpx;
}

/* 步骤导航按钮 */
.step-actions {
	flex-direction: column;
	justify-content: center;
	margin-top: 40rpx;
	margin-bottom: 24rpx;
	gap: 20rpx;
}

.step-actions.verify-actions {
	flex-direction: row;
	align-items: center;
	margin-top: 48rpx;
	gap: 18rpx;
}

.action-button {
	height: 90rpx;
	border-radius: 8rpx;
	align-items: center;
	justify-content: center;
	width: 100%;
}

.action-button text {
	font-size: 32rpx;
}

.action-button.primary {
	background-color: #00C28A;
}

.verify-actions .action-button.primary {
	flex: 1;
	width: 0;
	box-shadow: 0 8rpx 20rpx rgba(0, 194, 138, 0.18);
}

.action-button.primary text {
	color: #FFFFFF;
}

.action-button.secondary {
	background-color: #FFFFFF;
	border-width: 2rpx;
	border-color: #00C28A;
	border-style: solid;
}

.verify-actions .action-button.secondary {
	width: 210rpx;
	background-color: #F8FAFB;
	border-color: #DDE6EE;
}

.action-button.secondary text {
	color: #00C28A;
	font-weight: 500;
}

.verify-actions .action-button.secondary text {
	color: #5E6B75;
	font-size: 30rpx;
}

.action-button.secondary:active {
	background-color: rgba(0, 194, 138, 0.05);
}

.action-button.disabled {
	background-color: #CCCCCC;
	opacity: 0.7;
	box-shadow: none;
