<script lang="uts">
import { 
	getContractPage, 
	getContractStatistics,
	cancelContract,
	deleteContract,
	urgeContract,
	ContractStatus,
	getContractStatusName,
	getContractStatusColor
} from '../../api/contracts/index';
import type { PageParams, Contract, ContractListResponse } from '../../api/contracts/index';
import { downloadContractFile } from '../../api/utils/download.uts';
import { checkAuthAndRedirect } from '../../api/auth';
import { getSealPageUrl } from '../../api/seals/index';
import { 
	checkNetworkStatus, 
	testH5ServiceAvailability,
	ErrorType
} from '../../utils/network';
import { kycGuardMixin, KycStatus } from '../../utils/kyc-check';
import KycModal from '../../components/KycModal.uvue';

	// 定义 Tab 类型
	interface SmartTab {
		id: string;
		name: string;
		roleFilter: string | null;
		status: number | null;
		isOther?: boolean;
	}
	
	export default {
		// 引入实名认证守卫 Mixin
		mixins: [kycGuardMixin],
		
		// 注册组件
		components: {
			KycModal
		},
		
		data() {
			return {
				safeTop: 0,
			// 🔧 合同状态常量（注意：后端状态从1开始，不是0！）
			STATUS_DRAFT: 1,
			STATUS_SIGNING: 2,
			STATUS_COMPLETED: 3,
			STATUS_CANCELLED: 4,
			STATUS_REJECTED: 5,
			STATUS_EXPIRED: 6,
			STATUS_FORM_FILLING: 7,      // 表单填写中
			
			// 🔧 参与人状态常量
			PARTICIPANT_PENDING: 0,         // 待处理
			PARTICIPANT_FORM_FILLED: 1,     // 表单已填写
			PARTICIPANT_SIGNED: 2,          // 已签署
			PARTICIPANT_REJECTED: 3,        // 已拒绝
			PARTICIPANT_CANCELLED: 4,       // 已取消
				
		// 当前用户ID（用于权限判断）
		currentUserId: '' as string,
		
		// 🔧 头像颜色池（随机分配个性化颜色）
		avatarColors: [
			['#FF6B6B', '#EE5A6F'],  // 红色系
			['#4ECDC4', '#44A08D'],  // 青色系
			['#95E1D3', '#38B2AC'],  // 薄荷绿
			['#FFD93D', '#F6B93B'],  // 黄色系
			['#A8E6CF', '#56C596'],  // 绿色系
			['#FF8B94', '#FF6F91'],  // 粉红系
			['#70A1D7', '#5B8CC7'],  // 蓝色系
			['#B4A7D6', '#9B86BD'],  // 紫色系
			['#F7B731', '#EE9617'],  // 橙色系
			['#FC5C65', '#EB3B5A'],  // 红橙系
		] as string[][],
		
		// 列表页头像最多显示数量
		maxAvatarsShow: 4,

		// 悬浮菜单展开状态
		showFloatMenu: false,
				
				// 搜索相关
				searchText: '',
				showSearchBar: false,
				
		// 🔧 智能筛选标签（融合角色+状态）
			smartTabs: [
				{ 
					id: 'all', 
					name: '全部', 
					roleFilter: null, 
					status: null 
				},
				{ 
					id: 'wait-form', 
					name: '待填表', 
					roleFilter: null, 
					status: 7  // 表单填写中
				},
				{ 
					id: 'signing', 
					name: '签署中', 
					roleFilter: null, 
					status: 2  // 签署中（所有签署中的任务）
				},
				{ 
					id: 'completed', 
					name: '已完成', 
					roleFilter: null, 
					status: 3 
				},
				{ 
					id: 'draft', 
					name: '草稿', 
					roleFilter: null, 
					status: 1 
				},
				{ 
					id: 'other', 
					name: '其他', 
					roleFilter: null, 
					status: null,
					isOther: true  // 标记为"其他"，包含拒签、撤销、过期
				}
			] as SmartTab[],
				currentTab: 'all' as string,
				
				// 合同列表
			contractList: [] as Contract[],
				isLoading: false,
				
				// 分页
			pageSize: 20,
				currentPage: 1,
			total: 0,
				hasMore: true,
				
		// 下拉刷新
			isRefreshing: false,
			
			// Mixin 中的属性（显式声明以解决类型问题）
			verifyStatus: KycStatus.NOT_VERIFIED as number
		}
	},
	
	onLoad() {
		this.safeTop = this.getSafeTop();
		// 检查登录状态
		if (!checkAuthAndRedirect(false)) {
			return;
		}
		
		// 🔧 获取当前用户ID
		// TODO: 集成登录系统后，从登录态中获取
		try {
			const userInfo = uni.getStorageSync('userInfo');
			if (userInfo && userInfo.id) {
				this.currentUserId = String(userInfo.id);
				console.log('✅ 当前用户ID:', this.currentUserId);
			} else {
				// ⚠️ 临时方案：从后端获取或使用默认值
				// 实际项目中应该从登录态获取
				console.warn('⚠️ 未找到用户信息，使用默认用户ID: 1');
				this.currentUserId = '1';
			}
		} catch (error) {
			console.error('获取用户ID失败:', error);
			this.currentUserId = '1';
		}
		
		// 🔧 检查是否有从首页传递过来的状态筛选参数（在 onLoad 中先检查，避免先加载默认数据）
		// 如果没有状态筛选参数，需要加载默认数据
		this.checkAndApplyStatusFilter(true);
		
		// 检查实名认证状态
		(this as any).checkKycStatus();
	},
	
onShow() {
	this.safeTop = this.getSafeTop();
	// 切回页面时关闭浮动菜单
	this.showFloatMenu = false;
	// 🔧 检查是否有从首页传递过来的状态筛选参数（tabBar 页面从其他页面返回时也会触发）
	// 从其他页面返回时，不需要加载默认数据（避免覆盖已有数据）
	this.checkAndApplyStatusFilter(false);
},
	
		onReachBottom() {
			// 上拉加载更多
			if (this.hasMore && !this.isLoading) {
			this.loadMoreContracts();
			}
		},
	
		methods: {
			getSafeTop(): number {
				try {
					const sys: any = uni.getSystemInfoSync();
					let top = sys && sys.statusBarHeight ? Number(sys.statusBarHeight) : 0;
					const getMenuBtn: any = (uni as any).getMenuButtonBoundingClientRect;
					if (typeof getMenuBtn === 'function') {
						const rect: any = getMenuBtn();
						if (rect && rect.top) {
							top = Number(rect.top);
						}
					}
					return top;
				} catch (e) {
					return 0;
				}
			},
	/**
	 * 🔧 检查并应用状态筛选（从首页跳转时使用）
	 * @param shouldLoadDefault 如果没有状态筛选参数，是否加载默认数据
	 */
	checkAndApplyStatusFilter(shouldLoadDefault: boolean = false): void {
		try {
			const contractStatus = uni.getStorageSync('contractStatus');
			// 🔧 修复：将存储的值转换为数字进行比较，因为存储可能是字符串
			const statusValue = contractStatus !== null && contractStatus !== undefined && contractStatus !== '' 
				? Number(contractStatus) 
				: null;
			
			if (statusValue !== null && !isNaN(statusValue)) {
				console.log('📱 从首页跳转，状态筛选:', statusValue);
				
				// 根据状态找到对应的 Tab
				let targetTabId = 'all';
				if (statusValue === 2) {
					// 签署中 → 签署中 Tab
					targetTabId = 'signing';
				} else if (statusValue === 7) {
					// 表单填写中 → 待填表 Tab
					targetTabId = 'wait-form';
				} else if (statusValue === 3) {
					// 已完成 → 已完成 Tab
					targetTabId = 'completed';
				} else if (statusValue === 1) {
					// 草稿 → 草稿 Tab
					targetTabId = 'draft';
				}
				
				// 🔧 修复：无论当前Tab是否相同，都切换并刷新列表
				console.log('📱 切换到Tab:', targetTabId, '当前Tab:', this.currentTab);
				this.currentTab = targetTabId;
				this.currentPage = 1;
				this.contractList = [];
				this.hasMore = true;
				this.loadContractList(true);
				
				// 清除存储的状态，避免下次进入页面时重复切换
				uni.removeStorageSync('contractStatus');
			} else {
				// 如果没有状态筛选参数，且需要加载默认数据，才加载
				if (shouldLoadDefault && this.contractList.length === 0) {
					this.loadContractList(true);
				}
			}
		} catch (error) {
			console.error('读取状态筛选参数失败:', error);
			// 出错时，如果需要加载默认数据，才加载
			if (shouldLoadDefault && this.contractList.length === 0) {
				this.loadContractList(true);
			}
		}
	},
	
	/**
	 * 🆕 判断是否可以填写表单
	 * 条件：任务状态=表单填写中(7) 且 当前用户的参与人模式=TWO_STAGE 且 状态=PENDING(0)
	 */
	canFillForm(contract: Contract): boolean {
		// 状态检查：必须是表单填写中
		if (contract.status !== this.STATUS_FORM_FILLING) {
			return false;
		}
		
		// 优先使用后端已处理好的 currentUserParticipant 字段
		if (contract.currentUserParticipant) {
			const p = contract.currentUserParticipant;
			return p.flowMode === 'TWO_STAGE' && p.status === this.PARTICIPANT_PENDING;
		}
		
		// 降级方案：参与者检查
		if (!contract.participants || contract.participants.length === 0) {
			return false;
		}
		
		// 查找当前用户的参与者信息（使用 isCurrentUser 匹配，更准确）
		const myParticipant = contract.participants.find(
			(p: any) => p.isCurrentUser === true
		);
		
		if (!myParticipant) {
			return false;
		}
		
		// 必须是两阶段模式且状态为待处理
		return myParticipant.flowMode === 'TWO_STAGE' && myParticipant.status === this.PARTICIPANT_PENDING;
	},
	
	/**
	 * 🔧 判断是否可以签署
	 * 
	 * 签署权限规则：
	 * 1. FORM_FILLING(7)状态：任何人都不能签署！必须等所有人填完表
	 * 2. SIGNING(2)状态：状态为PENDING或FORM_FILLED的参与者可以签署
	 */
	canSign(contract: Contract): boolean {
		// 🔧 只有签署中状态才能签署，表单填写中不能签署！
		if (contract.status !== this.STATUS_SIGNING) {
			return false;
		}
		
		// 优先使用后端已处理好的 currentUserParticipant 字段
		if (contract.currentUserParticipant) {
			const p = contract.currentUserParticipant;
			// 🎯 SIGNING(2)阶段：状态为PENDING或FORM_FILLED的参与者都可以签署
			return p.status === this.PARTICIPANT_PENDING || 
			       p.status === this.PARTICIPANT_FORM_FILLED;
		}
		
		// 参与者检查
		if (!contract.participants || contract.participants.length === 0) {
			return false;
		}
		
		// 🔧 直接使用后端返回的isCurrentUser字段，支持userId和手机号两种匹配方式
		const myParticipant = contract.participants.find(
			(p: any) => p.isCurrentUser === true
		);
		
		if (!myParticipant) {
			return false;
		}
		
		// 🎯 SIGNING(2)阶段：状态为PENDING或FORM_FILLED的参与者都可以签署
		return myParticipant.status === this.PARTICIPANT_PENDING || 
		       myParticipant.status === this.PARTICIPANT_FORM_FILLED;
	},
		
	/**
	 * 🆕 判断当前用户是否在等待他人填写表单
	 * 
	 * 显示条件：
	 * 1. 任务状态=表单填写中(7)
	 * 2. 用户是DIRECT模式（无需填表）
	 *    OR
	 *    用户是TWO_STAGE模式 且 已填写表单(FORM_FILLED)
	 */
	isWaitingForOthersToFillForm(contract: Contract): boolean {
		// 状态检查：必须是表单填写中
		if (contract.status !== this.STATUS_FORM_FILLING) {
			return false;
		}
		
		let p: any = null;
		
		// 优先使用后端已处理好的 currentUserParticipant 字段
		if (contract.currentUserParticipant) {
			p = contract.currentUserParticipant;
		} else {
			// 降级方案：查找当前用户
			if (!contract.participants || contract.participants.length === 0) {
				return false;
			}
			p = contract.participants.find(
				(item: any) => item.isCurrentUser === true
			);
		}
		
		if (!p) {
			return false;
		}
		
		// 情况1：DIRECT模式的用户在表单填写阶段始终等待他人
		if (p.flowMode === 'DIRECT' && p.status === this.PARTICIPANT_PENDING) {
			return true;
		}
		
		// 情况2：TWO_STAGE模式用户已填写表单，但在等待他人填写
		if (p.flowMode === 'TWO_STAGE' && p.status === this.PARTICIPANT_FORM_FILLED) {
			return true;
		}
		
		return false;
	},
	
	/**
	 * 判断是否可以撤销
	 */
	canCancel(contract: Contract): boolean {
		if (contract.status !== this.STATUS_DRAFT && 
		    contract.status !== this.STATUS_SIGNING &&
		    contract.status !== this.STATUS_FORM_FILLING) {
			return false;
		}
		
		return String(contract.creator) === String(this.currentUserId);
	},
		
	/**
	 * 🔧 判断是否可以催签（支持表单填写和签署两个阶段）
	 * 
	 * 催签规则：
	 * 1. FORM_FILLING(7)阶段：催促填写表单
	 * 2. SIGNING(2)阶段：催促签署
	 */
	canUrge(contract: Contract): boolean {
		// 状态检查：必须是表单填写中或签署中
		if (contract.status !== this.STATUS_FORM_FILLING && contract.status !== this.STATUS_SIGNING) {
			return false;
		}
		
		// 权限检查：必须是创建者
		if (String(contract.creator) !== String(this.currentUserId)) {
			return false;
		}
		
		// 参与者检查
		if (!contract.participants || contract.participants.length === 0) {
			return false;
		}
		
		// 检查是否有人待处理（PENDING或FORM_FILLED状态都可以催促）
		const hasPendingParticipants = contract.participants.some(
			(p: any) => p.status === this.PARTICIPANT_PENDING || p.status === this.PARTICIPANT_FORM_FILLED
		);
		
		return hasPendingParticipants;
	},
		
		/**
		 * 判断是否可以下载
		 */
		canDownload(contract: Contract): boolean {
			if (contract.status !== this.STATUS_COMPLETED) return false;
			
			if (String(contract.creator) === String(this.currentUserId)) return true;
			
			const isParticipant = contract.participants?.some(
				(p: any) => String(p.userId) === String(this.currentUserId)
			);
			
			return isParticipant ?? false;
		},
		
		/**
		 * 切换智能标签（融合角色+状态）
		 */
		changeTab(tabId: string): void {
			if (this.currentTab === tabId) return;
			
			// 切换 Tab 时关闭浮动菜单
			this.showFloatMenu = false;
			
			console.log('🔀 切换标签:', tabId);
			this.currentTab = tabId;
			this.currentPage = 1;
			this.contractList = [];
			this.hasMore = true;
			this.loadContractList(true);
		},
		
		/**
		 * 切换搜索栏显示状态
		 */
			toggleSearchBar(): void {
			this.showSearchBar = !this.showSearchBar;
				if (!this.showSearchBar) {
					// 关闭搜索栏时，如果有搜索内容则清空并重新加载
					if (this.searchText) {
					this.searchText = '';
					this.refreshList();
					}
				}
			},
			
		/**
		 * 搜索合同
		 */
			searchContracts(): void {
			this.currentPage = 1;
			this.contractList = [];
			this.hasMore = true;
			this.loadContractList(true);
		},
		
	/**
	 * 刷新列表
	 */
		async refreshList(): Promise<void> {
		console.log('🔄 开始刷新列表');
		this.currentPage = 1;
		this.contractList = [];
		this.hasMore = true;
		this.isRefreshing = true;
		
		try {
			await this.loadContractList(false);
		} catch (error) {
			console.error('刷新列表失败:', error);
		} finally {
			// 确保刷新状态被重置
			this.isRefreshing = false;
			console.log('🔄 刷新完成，状态已重置');
		}
	},
		
		/**
		 * 加载更多
		 */
			loadMoreContracts(): void {
			if (this.isLoading) return;
				
			this.currentPage++;
			this.loadContractList(false);
			},
			
		/**
		 * 加载合同列表（真实API）
		 */
			async loadContractList(showLoading: boolean): Promise<void> {
			if (this.isLoading && !this.isRefreshing) return;
				
			this.isLoading = true;
				
				// ❌ 删除系统级loading，使用页面内自定义loading即可
				// if (showLoading) {
				// 	uni.showLoading({
				// 		title: '加载中'
				// 	});
				// }
				
				try {
					// 构建请求参数
				const params: PageParams = {
					pageNo: this.currentPage,
						pageSize: this.pageSize
					};
					
				// 🔧 根据当前智能标签设置筛选条件
				const currentTabConfig = this.smartTabs.find((tab: any) => tab.id === this.currentTab);
				if (currentTabConfig) {
					// 设置角色筛选
					if (currentTabConfig.roleFilter) {
						params.roleFilter = currentTabConfig.roleFilter;
					}
					
					// 设置状态筛选
					if (currentTabConfig.status !== null && currentTabConfig.status !== undefined) {
						params.status = currentTabConfig.status;
					}
					
					// "其他"标签：查询拒签(5)、撤销(4)、过期(6)
					if (currentTabConfig.isOther) {
						params.statusList = [4, 5, 6];  // 撤销、拒签、过期
					}
				}
				
				// 添加搜索关键字
				if (this.searchText) {
					params.name = this.searchText;
				}
				
		console.log('📤 请求合同列表，当前标签:', this.currentTab, '参数:', params);
		
		// 调用真实API
		const result: ContractListResponse = await getContractPage(params);
		
		console.log('✅ 合同列表返回:', result.list.length, '条');
		
		// 🔧 调试：检查每个合同的 participants 数据
		result.list.forEach((contract: Contract, index: number) => {
			const hasParticipants = contract.participants && contract.participants.length > 0;
			console.log(`  📋 合同${index + 1}(ID:${contract.id})`, 
				`状态:${contract.status}`, 
				`创建者:${contract.creator}`,
				`参与者:${hasParticipants ? contract.participants.length + '人' : '无数据❌'}`
			);
			if (!hasParticipants) {
				console.warn(`    ⚠️ 警告：合同 ${contract.id} 缺少 participants 数据！`);
			}
		});
			
			// 第一页清空列表，其他页追加数据
			if (this.currentPage === 1) {
				this.contractList = result.list;
			} else {
					this.contractList = [...this.contractList, ...result.list];
				}
				
			// 更新总数
			this.total = result.total;
			
			// 判断是否有更多数据
			this.hasMore = this.contractList.length < result.total;
			
			console.log(`✅ 已加载 ${this.contractList.length}/${result.total} 条数据`);
					
				} catch (error) {
					console.error('加载合同列表失败:', error);
					uni.showToast({
						title: '加载失败，请重试',
						icon: 'none'
					});
				} finally {
					this.isLoading = false;
					this.isRefreshing = false;
					// ❌ 删除系统级loading的隐藏调用
					// if (showLoading) {
					// 	uni.hideLoading();
					// }
				}
			},
			
		/**
		 * 查看合同详情
		 */
		viewContractDetail(contract: Contract): void {
			console.log('查看合同详情:', contract);
			
			// 跳转到合同详情页
			uni.navigateTo({
				url: `/pages/contract-detail/index?id=${contract.id}`
			});
		},
		
	/**
	 * 填写表单（先检测H5服务，再跳转H5表单页面）
	 * 
	 * 检测流程：
	 * 1. 检查用户网络状态
	 * 2. 获取 H5 表单填写 URL
	 * 3. 测试 H5 服务器可用性
	 * 4. 检测通过后才跳转
	 */
	async fillForm(contract: Contract, event: Event): Promise<void> {
		event.stopPropagation();
		
		console.log('[合同列表] 准备填写表单:', contract.id);
		
		// 检查认证状态（根据身份类型）
		try {
			const savedIdentity = uni.getStorageSync('currentIdentity');
			if (savedIdentity) {
				const identity = JSON.parse(savedIdentity) as { type?: string; id?: string | number; name?: string; verified?: boolean };
				if (identity) {
					// 个人身份需要检查个人实名认证
					if (identity.type === 'personal' && !identity.verified) {
						console.log('[合同列表] 个人未实名认证，显示提示弹窗');
						uni.showModal({
							title: '请先实名认证',
							content: '为保障合同的法律效力，填写表单前需要完成实名认证。',
							confirmText: '去认证',
							cancelText: '取消',
							success: (res) => {
								if (res.confirm) {
									uni.navigateTo({ url: '/pages/kyc/personal/index' });
								}
							}
						});
						return;
					}
					// 企业身份需要检查企业认证
					if (identity.type === 'enterprise' && !identity.verified) {
						console.log('[合同列表] 企业未认证，显示提示弹窗');
						uni.showModal({
							title: '企业未认证',
							content: '当前企业尚未完成认证，无法填写表单。是否前往认证？',
							confirmText: '去认证',
							cancelText: '取消',
							success: (res) => {
								if (res.confirm) {
									uni.navigateTo({
										url: `/pages/kyc/enterprise/index?id=${identity.id}&name=${encodeURIComponent(identity.name || '')}`
									});
								}
							}
						});
						return;
					}
				}
			}
		} catch (e) {
			console.warn('[合同列表] 检查认证状态失败:', e);
		}
		
		try {
			// 显示检测进度
			uni.showLoading({ 
				title: '正在检测服务...',
				mask: true 
			});
			
			// 步骤 1: 检查网络状态
			console.log('[合同列表] 步骤 1: 检查网络状态');
			const networkResult = await checkNetworkStatus();
			if (!networkResult.success) {
				uni.hideLoading();
				uni.showModal({
					title: '网络异常',
					content: networkResult.errorMessage || '请检查网络连接后重试',
					showCancel: false
				});
				return;
			}
			console.log('[合同列表] ✓ 网络状态正常');
			
			// 步骤 2: 获取 H5 表单填写 URL
			console.log('[合同列表] 步骤 2: 获取 H5 表单填写 URL');
			uni.showLoading({ 
				title: '正在连接服务...',
				mask: true 
			});
			
			let formUrl: string;
			try {
				formUrl = await getSealPageUrl('form', contract.id);
				console.log('[合同列表] ✓ H5 URL 获取成功');
			} catch (error) {
				uni.hideLoading();
				console.error('[合同列表] ✗ H5 URL 获取失败:', error);
				
				uni.showModal({
					title: '服务异常',
					content: '无法连接到表单服务\n请稍后重试或联系技术支持',
					showCancel: false
				});
				return;
			}
			
			// 步骤 3: 测试 H5 服务器可用性（关键步骤）
			console.log('[合同列表] 步骤 3: 测试 H5 服务器可用性');
			uni.showLoading({ 
				title: '正在检测服务状态...',
				mask: true 
			});
			
			const serviceResult = await testH5ServiceAvailability(formUrl, 8000);
			
			uni.hideLoading();
			
			if (!serviceResult.available) {
				console.error('[合同列表] ✗ H5 服务不可用');
				
				uni.showModal({
					title: '签署服务暂时不可用',
					content: serviceResult.errorMessage || 'H5签署服务暂时无法访问\n请稍后重试或联系技术支持',
					showCancel: false
				});
				return;
			}
			
			console.log('[合同列表] ✓ H5 服务可用');
			console.log('[合同列表] ✓ 所有检测通过，跳转到表单填写页面');
			
			// 步骤 4: 所有检测通过，跳转到表单填写页面
			uni.navigateTo({
				url: `/pages/contract-form/h5-fill?taskId=${contract.id}`
			});
			
		} catch (error) {
			uni.hideLoading();
			console.error('[合同列表] 表单填写前检测失败:', error);
			
			uni.showModal({
				title: '检测失败',
				content: '无法完成服务检测\n请稍后重试',
				showCancel: false
			});
		}
	},
	
	/**
	 * 签署合同（先检测H5服务，再跳转签署页面）
	 * 
	 * 检测流程：
	 * 1. 检查用户网络状态
	 * 2. 获取 H5 签署 URL
	 * 3. 测试 H5 服务器可用性
	 * 4. 检测通过后才跳转
	 */
	async signContract(contract: Contract, event: Event): Promise<void> {
		event.stopPropagation();
		
		console.log('[合同列表] 准备签署合同:', contract.id);
		
		// 检查认证状态（根据身份类型）
		try {
			const savedIdentity = uni.getStorageSync('currentIdentity');
			if (savedIdentity) {
				const identity = JSON.parse(savedIdentity) as { type?: string; id?: string | number; name?: string; verified?: boolean };
				if (identity) {
					// 个人身份需要检查个人实名认证
					if (identity.type === 'personal' && !identity.verified) {
						console.log('[合同列表] 个人未实名认证，显示提示弹窗');
						uni.showModal({
							title: '请先实名认证',
							content: '为保障合同的法律效力，签署合同前需要完成实名认证。',
							confirmText: '去认证',
							cancelText: '取消',
							success: (res) => {
								if (res.confirm) {
									uni.navigateTo({ url: '/pages/kyc/personal/index' });
								}
							}
						});
						return;
					}
					// 企业身份需要检查企业认证
					if (identity.type === 'enterprise' && !identity.verified) {
						console.log('[合同列表] 企业未认证，显示提示弹窗');
						uni.showModal({
							title: '企业未认证',
							content: '当前企业尚未完成认证，无法签署合同。是否前往认证？',
							confirmText: '去认证',
							cancelText: '取消',
							success: (res) => {
								if (res.confirm) {
									uni.navigateTo({
										url: `/pages/kyc/enterprise/index?id=${identity.id}&name=${encodeURIComponent(identity.name || '')}`
									});
								}
							}
						});
						return;
					}
				}
			}
		} catch (e) {
			console.warn('[合同列表] 检查认证状态失败:', e);
		}
		
		try {
			// 显示检测进度
			uni.showLoading({ 
				title: '正在检测签署服务...',
				mask: true 
			});
			
			// 步骤 1: 检查网络状态
			console.log('[合同列表] 步骤 1: 检查网络状态');
			const networkResult = await checkNetworkStatus();
			if (!networkResult.success) {
				uni.hideLoading();
				uni.showModal({
					title: '网络异常',
					content: networkResult.errorMessage || '请检查网络连接后重试',
					showCancel: false
				});
				return;
			}
			console.log('[合同列表] ✓ 网络状态正常');
			
			// 步骤 2: 获取 H5 签署 URL
			console.log('[合同列表] 步骤 2: 获取 H5 签署 URL');
			uni.showLoading({ 
				title: '正在连接签署服务...',
				mask: true 
			});
			
			let signUrl: string;
			try {
				signUrl = await getSealPageUrl('sign', contract.id);
				console.log('[合同列表] ✓ H5 URL 获取成功');
			} catch (error) {
				uni.hideLoading();
				console.error('[合同列表] ✗ H5 URL 获取失败:', error);
				
				uni.showModal({
					title: '服务异常',
					content: '无法连接到签署服务\n请稍后重试或联系技术支持',
					showCancel: false
				});
				return;
			}
			
			// 步骤 3: 测试 H5 服务器可用性（关键步骤）
			console.log('[合同列表] 步骤 3: 测试 H5 服务器可用性');
			uni.showLoading({ 
				title: '正在检测服务状态...',
				mask: true 
			});
			
			const serviceResult = await testH5ServiceAvailability(signUrl, 8000);
			
			uni.hideLoading();
			
			if (!serviceResult.available) {
				console.error('[合同列表] ✗ H5 服务不可用');
				
				uni.showModal({
					title: '签署服务暂时不可用',
					content: serviceResult.errorMessage || 'H5签署服务暂时无法访问\n请稍后重试或联系技术支持',
					showCancel: false
				});
				return;
			}
			
			console.log('[合同列表] ✓ H5 服务可用');
			console.log('[合同列表] ✓ 所有检测通过，跳转到签署页面');
			
			// 步骤 4: 所有检测通过，跳转到签署页面
			uni.navigateTo({
				url: `/pages/contract-sign/h5-sign?taskId=${contract.id}`
			});
			
		} catch (error) {
			uni.hideLoading();
			console.error('[合同列表] 签署前检测失败:', error);
			
			uni.showModal({
				title: '检测失败',
				content: '无法完成签署前检测\n请稍后重试',
				showCancel: false
			});
		}
	},
		
		/**
		 * 催签
		 */
		async urgeSign(contract: Contract, event: Event): Promise<void> {
			event.stopPropagation();
			
			try {
				console.log('催签合同:', contract);
				
				// 显示加载
				uni.showLoading({
					title: '发送中...'
				});
				
				// 调用催签API
				await urgeContract(contract.id);
				
				uni.hideLoading();
				
				// 成功提示
				uni.showToast({
					title: '已发送催签通知',
					icon: 'success'
				});
				
			} catch (error) {
				uni.hideLoading();
				console.error('催签失败:', error);
				uni.showToast({
					title: '催签失败',
					icon: 'none'
				});
			}
		},
		
		/**
		 * 撤销合同
		 */
		async revokeContract(contract: Contract, event: Event): Promise<void> {
			event.stopPropagation();
				
				uni.showModal({
				title: '撤销合同',
				content: '确定要撤销该合同吗？撤销后将无法恢复。',
				success: async (res) => {
						if (res.confirm) {
						try {
							console.log('撤销合同:', contract);
							
							// 显示加载
							uni.showLoading({
								title: '撤销中...'
							});
							
							// 调用撤销API
							await cancelContract(contract.id);
							
							uni.hideLoading();
							
							// 成功提示
							uni.showToast({
								title: '合同已撤销',
								icon: 'success'
							});
							
							// 刷新列表
							this.refreshList();
							
						} catch (error) {
							uni.hideLoading();
							console.error('撤销失败:', error);
							uni.showToast({
								title: '撤销失败',
								icon: 'none'
							});
						}
					}
				}
			});
		},
		
	/**
	 * 下载合同
	 */
	async downloadContract(contract: Contract, event: Event): Promise<void> {
		event.stopPropagation();
		
		try {
			console.log('📥 下载合同:', contract);
			
			// 使用已签署的文件URL或原文件URL
			const fileUrl = contract.signedFileUrl || contract.fileUrl;
			
			if (!fileUrl) {
				uni.showToast({
					title: '文件不存在',
					icon: 'none',
					duration: 2000
				});
				return;
			}
			
			// 生成文件名
			const fileName = `${contract.name || '合同'}_${contract.id}.pdf`;
			
			// 使用统一的下载工具
			await downloadContractFile(fileUrl, fileName);
			
		} catch (error) {
			console.error('❌ 下载合同失败:', error);
			uni.showToast({
				title: '下载失败',
				icon: 'none',
				duration: 2000
			});
		}
	},
		
	/**
	 * 切换悬浮菜单显示
	 */
		toggleFloatMenu() {
			this.showFloatMenu = !this.showFloatMenu;
		},

	/**
	 * 悬浮菜单点击处理
	 */
		handleFloatMenuClick(action : string) {
			this.showFloatMenu = false;
			if (action == 'batch') {
				uni.navigateTo({ url: '/pages/batch-create/index' });
			} else if (action == 'single') {
				this.navigateToCreate();
			}
		},

	/**
	 * 导航到创建页面（需要先验证实名认证，并检测H5服务）
	 */
		async navigateToCreate(): Promise<void> {
			// 先检查实名认证（使用 Mixin 中的方法）
			if (!(this as any).checkCanProceed()) {
				return
			}
			
			// 检查企业认证状态（如果当前是企业身份）
			try {
				const savedIdentity = uni.getStorageSync('currentIdentity');
				if (savedIdentity) {
					const identity = JSON.parse(savedIdentity) as { type?: string; id?: string | number; name?: string; verified?: boolean };
					if (identity && identity.type === 'enterprise' && !identity.verified) {
						console.log('[合同管理] 企业未认证，显示提示弹窗');
						uni.showModal({
							title: '企业未认证',
							content: '当前企业尚未完成认证，无法发起合同。是否前往认证？',
							confirmText: '去认证',
							cancelText: '取消',
							success: (res) => {
								if (res.confirm) {
									uni.navigateTo({
										url: `/pages/kyc/enterprise/index?id=${identity.id}&name=${encodeURIComponent(identity.name || '')}`
									});
								}
							}
						});
						return;
					}
				}
			} catch (e) {
				console.warn('[合同管理] 检查企业认证状态失败:', e);
			}
			
			try {
				uni.showLoading({ title: '正在检测服务...', mask: true });
				
				// 步骤 1: 检查网络状态
				const networkResult = await checkNetworkStatus();
				if (!networkResult.success) {
					uni.hideLoading();
					uni.showModal({
						title: '网络异常',
						content: networkResult.errorMessage || '请检查网络连接后重试',
						showCancel: false
					});
					return;
				}
				
				// 步骤 2: 获取 H5 创建合同 URL
				uni.showLoading({ title: '正在连接服务...', mask: true });
				
				// 获取当前选择的企业ID
				let enterpriseId: number | undefined = undefined;
				try {
					const savedIdentity = uni.getStorageSync('currentIdentity');
					if (savedIdentity) {
						const identity = JSON.parse(savedIdentity) as { type?: string; id?: number } | null;
						if (identity && identity.type === 'enterprise' && identity.id) {
							enterpriseId = identity.id;
						}
					}
				} catch (e) {
					console.warn('[合同管理] 获取当前身份信息失败:', e);
				}
				
				let createUrl: string;
				try {
					createUrl = await getSealPageUrl('create', undefined, { type: 'template', enterpriseId });
				} catch (error) {
					uni.hideLoading();
					uni.showModal({
						title: '服务异常',
						content: '无法连接到创建服务\n请稍后重试或联系技术支持',
						showCancel: false
					});
					return;
				}
				
				// 步骤 3: 测试 H5 服务器可用性
				uni.showLoading({ title: '正在检测服务状态...', mask: true });
				const serviceResult = await testH5ServiceAvailability(createUrl, 8000);
				
				uni.hideLoading();
				
				if (!serviceResult.available) {
					uni.showModal({
						title: '签署服务暂时不可用',
						content: serviceResult.errorMessage || 'H5签署服务暂时无法访问\n请稍后重试或联系技术支持',
						showCancel: false
					});
					return;
				}
				
				// 步骤 4: 所有检测通过，跳转到 H5 创建页面
				uni.navigateTo({
					url: '/pages/contract-create/h5-create?type=template'
				});
				
			} catch (error) {
				uni.hideLoading();
				uni.showModal({
					title: '检测失败',
					content: '无法完成服务检测\n请稍后重试',
					showCancel: false
				});
			}
		},
			
		/**
		 * 清除搜索条件
		 */
			clearSearch(): void {
				this.searchText = '';
				this.refreshList();
			},
			
		/**
		 * 清除所有过滤条件
		 */
			clearAllFilters(): void {
				this.searchText = '';
				this.currentTab = 'all'; // 🔧 重置为"全部"标签
				this.refreshList();
			},
			
		/**
		 * 获取状态显示名称（基础版本）
		 */
		getStatusName(status: ContractStatus): string {
			return getContractStatusName(status);
		},
		
		/**
		 * 🆕 获取智能状态名称（根据当前用户角色显示不同文本）
		 * 
		 * 核心原则：让用户清楚知道是"待我操作"还是"等待他人操作"
		 * - 表单填写：待填写 / 他人填写中
		 * - 签署：待签署 / 他人签署中
		 */
		getSmartStatusName(contract: Contract): string {
			// 表单填写中状态
			if (contract.status === this.STATUS_FORM_FILLING) {
				// 只有明确需要自己填写表单时才显示"待填写"
				if (this.canFillForm(contract)) {
					return '待填写';
				}
				// 🔧 其他所有情况（发起人/已填完/DIRECT模式等）都显示"他人填写中"
				return '他人填写中';
			}
			
			// 签署中状态
			if (contract.status === this.STATUS_SIGNING) {
				// 只有明确需要自己签署时才显示"待签署"
				if (this.canSign(contract)) {
					return '待签署';
				}
				// 🔧 其他所有情况（发起人/已签署等）都显示"他人签署中"
				return '他人签署中';
			}
			
			// 其他状态使用默认名称
			return getContractStatusName(contract.status);
		},
		
		/**
		 * 🆕 判断当前用户是否在等待他人签署
		 */
		isWaitingForOthersToSign(contract: Contract): boolean {
			// 状态检查：必须是签署中
			if (contract.status !== this.STATUS_SIGNING) {
				return false;
			}
			
			let p: any = null;
			
			// 优先使用后端已处理好的 currentUserParticipant 字段
			if (contract.currentUserParticipant) {
				p = contract.currentUserParticipant;
			} else {
				// 降级方案：查找当前用户
				if (!contract.participants || contract.participants.length === 0) {
					return false;
				}
				p = contract.participants.find(
					(item: any) => item.isCurrentUser === true
				);
			}
			
			if (!p) {
				return false;
			}
			
			// 当前用户已签署，等待他人
			return p.status === this.PARTICIPANT_SIGNED;
		},
		
		/**
		 * 获取状态颜色
		 */
		getStatusColor(status: ContractStatus): string {
			return getContractStatusColor(status);
		},
		
		/**
		 * 获取状态浅色背景
		 */
		getStatusBgColor(status: ContractStatus): string {
			const bgMap = new Map<number, string>();
			bgMap.set(1, 'rgba(144, 147, 153, 0.1)');  // 草稿 - 灰
			bgMap.set(2, 'rgba(24, 144, 255, 0.1)');   // 签署中 - 蓝
			bgMap.set(3, 'rgba(0, 194, 138, 0.1)');    // 已完成 - 绿
			bgMap.set(4, 'rgba(144, 147, 153, 0.1)');  // 已撤销 - 灰
			bgMap.set(5, 'rgba(245, 108, 108, 0.1)');  // 已拒签 - 红
			bgMap.set(6, 'rgba(250, 173, 20, 0.1)');   // 已过期 - 橙
			bgMap.set(7, 'rgba(250, 173, 20, 0.1)');   // 填写中 - 橙
			const bg = bgMap.get(status as number);
			return bg != null ? bg : 'rgba(144, 147, 153, 0.1)';
		},
		
	/**
	 * 格式化时间显示
	 */
	formatDate(dateString: string | null): string {
		if (!dateString) return '';
		
		try {
			// 如果是时间戳（数字），则转换为日期
			let date: Date;
			if (/^\d+$/.test(dateString)) {
				date = new Date(parseInt(dateString));
			} else {
				// ISO格式或其他字符串格式
				date = new Date(dateString);
			}
			
			// 检查日期是否有效
			if (isNaN(date.getTime())) {
				return dateString;
			}
			
			const year = date.getFullYear();
			const month = String(date.getMonth() + 1).padStart(2, '0');
			const day = String(date.getDate()).padStart(2, '0');
			const hours = String(date.getHours()).padStart(2, '0');
			const minutes = String(date.getMinutes()).padStart(2, '0');
			
			return `${year}-${month}-${day} ${hours}:${minutes}`;
		} catch (error) {
			console.error('日期格式化失败:', error);
			return dateString || '';
		}
		},
	
	/**
	 * 🔧 获取参与人姓名
	 */
	getParticipantName(participant: any): string {
		return participant.userName || participant.nickname || '未知';
	},
	
	/**
	 * 🔧 根据用户ID获取头像颜色（随机但固定）
	 */
	getAvatarColor(userId: any): string[] {
		// 将用户ID转换为数字
		const id = String(userId || '0');
		let hash = 0;
		for (let i = 0; i < id.length; i++) {
			hash = id.charCodeAt(i) + ((hash << 5) - hash);
		}
		// 使用 hash 值选择颜色
		const index = Math.abs(hash) % this.avatarColors.length;
		return this.avatarColors[index];
	},
		}
	}
</script>

<template>
	<view class="contract-manage">
		<!-- 顶部导航栏 -->
		<view class="header" :style="{ '--safe-top': safeTop + 'px' }">
			<!-- 导航栏 -->
			<view class="nav-bar">
				<view class="nav-left"></view>
				<view class="nav-title">
					<text class="page-title">合同管理</text>
				</view>
				<view class="nav-right">
					<view class="action-btn search-btn" @click="toggleSearchBar">
						<text class="fa fa-search"></text>
					</view>
				</view>
			</view>
			
			<!-- 搜索框 -->
			<view v-if="showSearchBar" class="search-container">
				<view class="search-input-wrapper">
					<text class="fa fa-search search-prefix-icon"></text>
					<input 
						class="search-input" 
						type="text" 
						:value="searchText"
						@input="searchText = $event.detail.value"
						placeholder="搜索合同名称" 
						confirm-type="search"
						@confirm="searchContracts"
						focus="true"
					/>
					<view v-if="searchText" class="clear-button" @click="searchText = ''">
						<text class="fa fa-times"></text>
					</view>
				</view>
				<view class="search-cancel" @click="toggleSearchBar">
					<text class="cancel-text">取消</text>
				</view>
			</view>
			
			<!-- 🔧 智能筛选标签（单层导航） -->
			<view class="smart-tabs-wrapper">
				<scroll-view 
					class="smart-tabs" 
					direction="horizontal"
					:show-scrollbar="false"
				>
					<view 
						v-for="(tab, index) in smartTabs" 
						:key="index"
						class="tab-item"
						:class="{ active: currentTab === tab.id }"
						@click="changeTab(tab.id)"
					>
						<text class="tab-text">{{ tab.name }}</text>
						<view v-if="currentTab === tab.id" class="active-indicator"></view>
					</view>
				</scroll-view>
				<!-- 🔧 右侧渐变遮罩，提示可滚动 -->
				<view class="scroll-indicator"></view>
			</view>
			
			<!-- 过滤器指示器 -->
			<view v-if="searchText" class="filter-indicator">
				<view class="filter-tag">
					<text class="filter-tag-text">{{ searchText }}</text>
					<text class="fa fa-times filter-tag-close" @click="clearSearch"></text>
				</view>
				<view class="filter-clear" @click="clearAllFilters">
					<text class="filter-clear-text">清除全部</text>
				</view>
			</view>
		</view>
		
		<!-- 合同列表 -->
		<scroll-view 
			class="contract-list"
			scroll-y="true"
			@scrolltolower="loadMoreContracts"
			:refresher-enabled="true"
			:refresher-triggered="isRefreshing"
			@refresherrefresh="refreshList"
			refresher-background="#F7F9FC"
		>
			<!-- 列表内容 -->
			<view v-if="contractList.length > 0" class="list-content">
				<view 
					v-for="(contract, index) in contractList" 
					:key="contract.id"
					class="contract-item"
					hover-class="contract-item-hover"
					@click="viewContractDetail(contract)"
				>
					<!-- 合同标题行（标题 + 状态标签） -->
					<view class="contract-header">
						<view class="contract-title-container">
							<text class="contract-title">{{ contract.name }}</text>
						</view>
						<view class="status-tag" :style="{ backgroundColor: getStatusBgColor(contract.status), borderColor: getStatusColor(contract.status) }">
							<text class="status-tag-text" :style="{ color: getStatusColor(contract.status) }">{{ getSmartStatusName(contract) }}</text>
						</view>
					</view>
					
					<!-- 合同信息 -->
					<view class="contract-info">
						<view class="info-row">
							<view class="info-item">
								<text class="fa fa-clock info-icon"></text>
								<text class="info-label">创建时间：</text>
								<text class="info-value">{{ formatDate(contract.createTime) }}</text>
							</view>
						</view>
						<view class="info-row" v-if="contract.deadline">
							<view class="info-item">
								<text class="fa fa-calendar info-icon"></text>
								<text class="info-label">截止时间：</text>
								<text class="info-value">{{ formatDate(contract.deadline) }}</text>
							</view>
						</view>
					<!-- 🎨 参与者信息区域（整合参与人数和头像） -->
					<view class="participants-section" v-if="contract.participants && contract.participants.length > 0">
						<view class="participants-header">
							<text class="participants-count">参与方（{{ contract.participants.length }}方）</text>
						</view>
						<view class="participants-avatars">
							<!-- 显示前几个参与者头像 -->
							<view 
								v-for="(participant, index) in contract.participants.slice(0, maxAvatarsShow)" 
								:key="index"
								class="avatar-item"
								:style="{ 
									background: `linear-gradient(135deg, ${getAvatarColor(participant.userId)[0]} 0%, ${getAvatarColor(participant.userId)[1]} 100%)`,
									zIndex: contract.participants.length - index
								}"
							>
								<text class="avatar-text">{{ getParticipantName(participant).substring(0, 1) }}</text>
							</view>
							<!-- 如果参与者超过最大显示数量，显示 +N -->
							<view 
								v-if="contract.participants.length > maxAvatarsShow" 
								class="avatar-item avatar-more"
							>
								<text class="avatar-text">+{{ contract.participants.length - maxAvatarsShow }}</text>
							</view>
						</view>
					</view>
					</view>
					
			<!-- 合同操作按钮 -->
			<view class="contract-actions">
				<!-- 🆕 填写表单按钮：只有两阶段模式且状态为PENDING的参与人才显示 -->
				<view 
					v-if="canFillForm(contract)" 
					class="action-button fill-form"
					@click.stop="fillForm(contract, $event)"
				>
					<text class="fa fa-edit action-icon"></text>
					<text class="action-text">填写表单</text>
				</view>
				
				<!-- 🔧 签署按钮：只有待签署的参与者才能看到 -->
				<view 
					v-if="canSign(contract)" 
					class="action-button sign"
					@click.stop="signContract(contract, $event)"
				>
					<text class="fa fa-signature action-icon"></text>
					<text class="action-text">去签署</text>
				</view>
				
				<!-- 🆕 等待对方填表提示：DIRECT模式用户在表单填写阶段看到 -->
				<view 
					v-if="isWaitingForOthersToFillForm(contract)" 
					class="action-button waiting"
				>
					<text class="fa fa-hourglass-half action-icon"></text>
					<text class="action-text">待他人</text>
				</view>
					
					<!-- 🔧 催签按钮：只有创建者才能催签 -->
					<view 
						v-if="canUrge(contract)" 
						class="action-button urge"
						@click.stop="urgeSign(contract, $event)"
					>
						<text class="fa fa-bell action-icon"></text>
						<text class="action-text">催签</text>
					</view>
					
					<!-- 🔧 撤销按钮：只有创建者才能撤销 -->
					<view 
						v-if="canCancel(contract)" 
						class="action-button revoke"
						@click.stop="revokeContract(contract, $event)"
					>
						<text class="fa fa-undo action-icon"></text>
						<text class="action-text">撤销</text>
					</view>
					
					<!-- 🔧 下载按钮：参与者和创建者都可以下载已完成的合同 -->
					<view 
						v-if="canDownload(contract)" 
						class="action-button download"
						@click.stop="downloadContract(contract, $event)"
					>
							<text class="fa fa-download action-icon"></text>
							<text class="action-text">下载</text>
						</view>
					</view>
				</view>
			</view>
			
			<!-- 空状态 -->
			<view v-else-if="!isLoading && !isRefreshing" class="empty-state">
			<view class="empty-icon-wrapper">
				<view class="empty-icon-bg"></view>
				<text class="fa fa-file-contract empty-icon"></text>
			</view>
				<text class="empty-title">暂无合同</text>
			<text class="empty-desc">您还没有创建任何合同</text>
			<text class="empty-tip">点击右下角 + 按钮开始创建您的第一份合同</text>
			</view>
			
			<!-- 加载状态 -->
			<view v-if="isLoading && !isRefreshing && contractList.length === 0" class="loading-state">
				<view class="loading-spinner"></view>
				<text class="loading-text">加载中...</text>
			</view>
			
			<!-- 加载更多状态 -->
			<view v-if="contractList.length > 0 && !isLoading && !hasMore" class="list-end">
				<view class="end-line"></view>
				<text class="end-text">已经到底啦</text>
				<view class="end-line"></view>
			</view>
			
			<!-- 加载更多中 -->
			<view v-if="contractList.length > 0 && isLoading && currentPage > 1" class="loading-more">
				<view class="loading-spinner small"></view>
				<text class="loading-more-text">加载更多中...</text>
			</view>
		</scroll-view>
		
		<!-- 悬浮操作菜单 -->
		<view class="float-menu-mask" v-if="showFloatMenu" @click="showFloatMenu = false"></view>
		<view class="float-menu" v-if="showFloatMenu">
			<view class="float-menu-item" @click="handleFloatMenuClick('batch')">
				<text class="icon icon-copy float-menu-icon"></text>
				<text class="float-menu-label">批量发起</text>
			</view>
			<view class="float-menu-item" @click="handleFloatMenuClick('single')">
				<text class="icon icon-plus-circle float-menu-icon"></text>
				<text class="float-menu-label">发起合同</text>
			</view>
		</view>
		<view class="float-button create" @click="toggleFloatMenu">
			<text class="fa float-icon" :class="showFloatMenu ? 'fa-times' : 'fa-plus'"></text>
		</view>
		
		<!-- 实名认证提示弹窗 - 使用统一组件 -->
		<kyc-modal 
			:visible="showKycModal"
			description="为保障合同的法律效力，创建合同前需要完成实名认证。"
			@close="closeKycModal"
			@confirm="goToKyc"
		/>
	</view>
</template>

