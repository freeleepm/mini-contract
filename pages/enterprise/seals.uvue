<template>
  <view class="container">
    <!-- 顶部背景装饰 -->
    <view class="header-bg"></view>
    
    <!-- 企业信息卡片 -->
    <view class="enterprise-section">
      <view class="enterprise-card">
        <view class="enterprise-logo">
          <image class="enterprise-logo-img" :src="enterpriseLogo" mode="aspectFill"></image>
        </view>
        <view class="enterprise-info">
          <view class="name-row">
            <text class="enterprise-name">{{ enterpriseName }}</text>
            <view class="enterprise-status" v-if="isVerified">
              <text class="status-icon fa fa-circle-check"></text>
              <text class="status-text">已认证</text>
            </view>
          </view>
          <text class="enterprise-credit-code" v-if="enterpriseCreditCode">社会信用代码：{{ enterpriseCreditCode }}</text>
        </view>
      </view>
    </view>
    
    <!-- 内容区域 -->
    <scroll-view class="content-section" scroll-y="true" @scrolltolower="loadMore">
      <!-- 统计与操作栏 -->
      <view class="action-bar">
        <view class="stat-info">
          <text class="stat-label">全部印章</text>
          <text class="stat-count">{{ total }}</text>
        </view>
        
        <!-- 已移除顶部的“新建印章”按钮，改用右下角悬浮按钮 -->
      </view>
      
      <!-- 印章列表 -->
      <view class="seal-list" v-if="sealList.length > 0">
        <view class="seal-item" v-for="(seal, index) in sealList" :key="seal.id">
          <!-- 动态添加 disabled 类 -->
          <view class="seal-card" :class="{'seal-card-default': seal.isDefault, 'seal-card-disabled': seal.status === 1}">
            <!-- 卡片主体 -->
            <view class="card-main">
              <!-- 左侧图片 -->
              <view class="seal-img-wrapper">
                <view class="seal-img-box">
                  <image 
                    class="seal-img" 
                    :src="seal.image" 
                    mode="aspectFit"
                    @error="handleImageError(seal)"
                    @load="handleImageLoad(seal)"
                  ></image>
                  <!-- 🆕 禁用状态底部封条 -->
                  <view class="disabled-strip" v-if="seal.status === 1">
                    <text class="disabled-strip-text">已禁用</text>
                  </view>
                </view>
                <!-- 禁用状态下，可以考虑隐藏类型标签，或者保持显示但颜色变灰。目前保持显示 -->
                <view class="seal-type-badge" :class="getSealTypeClass(seal.type)">
                  <text class="type-badge-text">{{ getSealTypeText(seal.type) }}</text>
                </view>
              </view>
              
              <!-- 右侧信息 -->
              <view class="seal-details">
                <view class="seal-header">
                  <text class="seal-title">{{ seal.name }}</text>
                  <!-- 移除重复的状态标签，使用水印代替 -->
                </view>
                
                <view class="seal-meta-row">
                  <view class="meta-item">
                    <text class="meta-label">授权人数</text>
                    <text class="meta-value-highlight">{{ seal.grantCount || 0 }}</text>
                  </view>
                  <view class="meta-item" style="align-items: flex-end;">
                    <text class="meta-label">创建时间</text>
                    <text class="meta-value">{{ formatDate(seal.createTime) }}</text>
                  </view>
                </view>
              </view>
              
              <!-- 已移除外部的水印 -->
            </view>
            
            <!-- 底部操作栏 -->
            <view class="card-actions">
              <view 
                class="action-item"
                @click="toggleSealStatus(seal, seal.status === 1 ? 0 : 1)"
              >
                <view class="action-content">
                  <text class="action-icon fa" :class="[seal.status === 1 ? 'fa-circle-check' : 'fa-ban', seal.status === 1 ? 'text-primary' : 'text-danger']"></text>
                  <text class="action-text" :class="seal.status === 1 ? 'text-primary' : 'text-danger'">{{ seal.status === 1 ? '启用' : '禁用' }}</text>
                </view>
              </view>
              
              <view class="action-line"></view>
              
              <view class="action-item" @click="authSeal(seal)">
                <view class="action-content">
                  <text class="action-icon fa fa-user-gear text-gray-dark"></text>
                  <text class="action-text text-gray-dark">授权管理</text>
                </view>
              </view>
              
              <view class="action-line"></view>
              
              <view class="action-item" @click="deleteSeal(seal)">
                <view class="action-content">
                  <text class="action-icon fa fa-trash-can text-gray-dark"></text>
                  <text class="action-text text-gray-dark">删除</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 无印章提示 -->
      <view class="empty-state" v-if="sealList.length === 0 && !loading">
        <image class="empty-image" src="/static/icons/template.png" mode="aspectFit"></image>
        <text class="empty-title">暂无企业印章</text>
        <text class="empty-desc">创建企业印章，在合同签署时使用</text>
        <!-- 已移除空状态下的按钮 -->
      </view>
      
      <!-- 加载中提示 -->
      <view class="loading-state" v-if="loading">
        <view class="loading-spinner"></view>
      </view>
      
      <!-- 底部安全距离 -->
      <view class="safe-area-bottom"></view>
    </scroll-view>
    
    <!-- 右下角悬浮创建按钮 -->
    <view class="fab-btn" @click="createSeal">
      <text class="fa fa-plus fab-icon"></text>
    </view>
  </view>
</template>

<script>
import { 
  getEnterpriseSealPage, 
  deleteEnterpriseSeal,
  getEnterpriseDetail,
  updateSeal
} from '../../api/enterprise/index';

export default {
  data() {
    return {
      enterpriseId: 0,
      enterpriseName: "企业名称",
      enterpriseCreditCode: "", // 统一社会信用代码
      enterpriseLogo: "/static/icons/blue-icon.png",
      isVerified: false, // 企业认证状态
      searchText: '',
      loading: true,
      sealList: [] as any[],
      pageNo: 1,
      pageSize: 20,
      hasMore: false,
      total: 0,
      shouldRefresh: false
    };
  },
  async onLoad(options) {
    console.log('[企业印章] ========== onLoad 开始 ==========');
    console.log('[企业印章] onLoad options:', JSON.stringify(options));
    
    // 🔧 兼容多种参数名：id、enterpriseId
    let enterpriseIdFromOptions: number = 0;
    
    if (options) {
      // 优先使用 id 参数（主要跳转方式）
      if (options.id) {
        enterpriseIdFromOptions = Number(options.id);
        console.log('[企业印章] 从 options.id 获取企业ID:', enterpriseIdFromOptions);
      }
      // 兼容 enterpriseId 参数
      else if (options.enterpriseId) {
        enterpriseIdFromOptions = Number(options.enterpriseId);
        console.log('[企业印章] 从 options.enterpriseId 获取企业ID:', enterpriseIdFromOptions);
      }
    }
    
    if (enterpriseIdFromOptions > 0) {
      this.enterpriseId = enterpriseIdFromOptions;
      console.log('[企业印章] ✅ 使用URL参数的企业ID:', this.enterpriseId);
      // 加载企业详情
      await this.loadEnterpriseDetail();
    } else {
      // 如果没有传入企业ID，则从缓存或全局状态获取
      console.log('[企业印章] URL参数中无有效企业ID，尝试从缓存获取...');
      const currentEnterprise = uni.getStorageSync('currentEnterprise');
      console.log('[企业印章] Storage currentEnterprise:', currentEnterprise);
      
      if (currentEnterprise) {
        try {
          const enterpriseData = typeof currentEnterprise === 'string' 
            ? JSON.parse(currentEnterprise) 
            : currentEnterprise;
            
          console.log('[企业印章] 解析后的企业数据:', JSON.stringify(enterpriseData));
          
          if (enterpriseData && enterpriseData.id) {
            this.enterpriseId = enterpriseData.id;
            this.enterpriseName = enterpriseData.name || "企业名称";
            this.enterpriseCreditCode = enterpriseData.creditCode || "";
            this.enterpriseLogo = enterpriseData.logo || "/static/icons/blue-icon.png";
            this.isVerified = enterpriseData.status === 2; // 2=已认证(VERIFIED)
            console.log('[企业印章] ✅ 从缓存获取企业ID:', this.enterpriseId);
          } else {
            console.warn('[企业印章] ⚠️ 缓存中的企业数据无效');
          }
        } catch (e) {
          console.error('[企业印章] ❌ 解析企业信息失败:', e);
        }
      } else {
        console.warn('[企业印章] ⚠️ 缓存中无企业信息');
      }
    }
    
    console.log('[企业印章] ========== onLoad 结束，最终 enterpriseId:', this.enterpriseId, '==========');
  },
  
  onShow() {
    // 页面显示时自动刷新列表
    console.log('[企业印章] ========== onShow ==========');
    console.log('[企业印章] onShow enterpriseId:', this.enterpriseId);
    
    if (!this.enterpriseId || this.enterpriseId <= 0) {
      console.error('[企业印章] ❌ onShow 时 enterpriseId 无效，无法加载列表');
      uni.showToast({
        title: '企业信息获取失败',
        icon: 'none'
      });
      return;
    }
    
    this.loadSealList(true);
  },
  
  onPullDownRefresh() {
    // 下拉刷新
    this.loadSealList(true).then(() => {
      uni.stopPullDownRefresh();
    });
  },
  
  mounted() {
    // 监听印章创建成功的全局事件
    uni.$on('refreshEnterpriseSealList', this.handleRefreshEvent);
    console.log('[企业印章] 已注册刷新事件监听');
  },
  
  beforeUnmount() {
    // 页面销毁前移除事件监听
    uni.$off('refreshEnterpriseSealList', this.handleRefreshEvent);
    console.log('[企业印章] 已移除刷新事件监听');
  },
  
  methods: {
    // 处理印章列表刷新事件
    handleRefreshEvent() {
      console.log('[企业印章] 收到刷新事件标记');
      // 这里不直接调用加载，因为返回页面时会触发 onShow
      // 如果需要可以在这里设置一个标记，但目前 onShow 每次都刷，所以不用额外处理
    },
    
    // 加载企业详情
    async loadEnterpriseDetail() {
      try {
        console.log('[企业印章] 开始加载企业详情, enterpriseId:', this.enterpriseId);
        
        // request 函数已经自动解包，返回的直接就是 Enterprise 对象
        const enterprise = await getEnterpriseDetail(this.enterpriseId);
        
        console.log('[企业印章] 获取到企业数据:', JSON.stringify(enterprise));
        
        if (enterprise) {
          // 直接使用 enterprise，不需要 .data
          this.enterpriseName = enterprise.name || "企业名称";
          this.enterpriseCreditCode = enterprise.creditCode || "";
          this.enterpriseLogo = enterprise.logo || "/static/icons/blue-icon.png";
          this.isVerified = enterprise.status === 2; // 2表示已认证(VERIFIED)
          
          console.log('[企业印章] 数据已赋值:', {
            name: this.enterpriseName,
            creditCode: this.enterpriseCreditCode,
            logo: this.enterpriseLogo,
            isVerified: this.isVerified
          });
          
          // 强制刷新视图
          this.$forceUpdate();
        } else {
          console.error('[企业印章] 企业数据为空');
        }
      } catch (error) {
        console.error('[企业印章] 获取企业详情失败:', error);
        uni.showToast({
          title: '获取企业信息失败',
          icon: 'none'
        });
      }
    },
    
    // 加载印章列表
    async loadSealList(isRefresh = false) {
      console.log('[企业印章] ========== loadSealList 开始 ==========');
      console.log('[企业印章] isRefresh:', isRefresh, ', enterpriseId:', this.enterpriseId);
      
      // 🔧 安全检查：确保 enterpriseId 有效
      if (!this.enterpriseId || this.enterpriseId <= 0) {
        console.error('[企业印章] ❌ enterpriseId 无效，跳过加载');
        this.loading = false;
        this.sealList = [];
        return;
      }
      
      if (isRefresh) {
        this.pageNo = 1;
        // 注意：这里不清空 sealList，避免闪烁，等到数据回来再替换
      }
      
      this.loading = true;
      
      try {
        const params: { enterpriseId: number; pageNo: number; pageSize: number; name?: string } = {
          enterpriseId: this.enterpriseId,
          pageNo: this.pageNo,
          pageSize: this.pageSize
        };

        console.log('[企业印章] loadSealList 请求参数:', JSON.stringify(params));
        
        if (this.searchText) {
          params.name = this.searchText;
        }
        
        // 获取印章列表
        const response = await getEnterpriseSealPage(params);

        console.log('[企业印章] loadSealList 响应:', JSON.stringify(response));
        
        if (response && Array.isArray(response.list)) {
          console.log('[企业印章] ✅ 获取到数据: list.length=', response.list.length, ', total=', response.total);
          // 数据映射
          const mappedList = response.list.map(seal => {
            const imageUrl = seal.sealData || seal.image;
            return {
              ...seal,
              image: imageUrl
            };
          });
          
          if (isRefresh) {
            this.sealList = mappedList;
          } else {
            // 合并列表
            this.sealList = [...this.sealList, ...mappedList];
          }
          
          this.total = response.total || 0;
          this.hasMore = this.sealList.length < this.total;
          
          console.log(`[企业印章] 加载成功：当前页 ${mappedList.length} 条，列表总数 ${this.sealList.length} 条，总记录 ${this.total} 条`);
          
          // 只有在确实还有更多数据时，才增加页码
          if (this.hasMore) {
            this.pageNo++;
          }
        } else {
            console.warn('[企业印章] ⚠️ 响应数据格式异常或为空');
            // 处理空数据情况
            if (isRefresh) {
                this.sealList = [];
            }
            this.hasMore = false;
        }
      } catch (error) {
        console.error('[企业印章] ❌ 获取印章列表失败:', error);
        uni.showToast({
          title: '获取印章列表失败',
          icon: 'none'
        });
      } finally {
        this.loading = false;
        console.log('[企业印章] ========== loadSealList 结束 ==========');
      }
    },
    
    // 加载更多
    loadMore() {
      if (this.hasMore && !this.loading) {
        this.loadSealList();
      }
    },
    
    // 处理搜索
    handleSearch() {
      this.loadSealList(true);
    },
    
    // 创建印章
    createSeal() {
      // 🔐 检查企业认证状态
      if (!this.isVerified) {
        // 从缓存获取认证状态详情
        let verifyStatus = 0;
        try {
          const currentEnterprise = uni.getStorageSync('currentEnterprise');
          if (currentEnterprise) {
            const enterpriseData = (typeof currentEnterprise === 'string' 
              ? JSON.parse(currentEnterprise) 
              : currentEnterprise) as UTSJSONObject | null;
            verifyStatus = enterpriseData != null ? ((enterpriseData['status'] as number | null) ?? 0) : 0;
          }
        } catch (e) {
          console.warn('[企业印章] 获取认证状态失败:', e);
        }
        
        let content = '创建企业印章需要先完成企业认证，请先完成认证后再创建印章。';
        if (verifyStatus === 1) {
          content = '企业认证正在审核中，请耐心等待审核通过后再创建印章。';
        } else if (verifyStatus === 3) {
          content = '企业认证被拒绝，请重新提交认证后再创建印章。';
        }
        
        uni.showModal({
          title: '需要企业认证',
          content: content,
          confirmText: verifyStatus === 1 ? '我知道了' : '去认证',
          cancelText: '取消',
          success: (res) => {
            if (res.confirm && verifyStatus !== 1) {
              uni.navigateTo({
                url: '/pages/kyc/enterprise/index'
              });
            }
          }
        });
        return;
      }
      
      uni.navigateTo({
        url: `/pages/enterprise/seal-create?enterpriseId=${this.enterpriseId}&enterpriseName=${encodeURIComponent(this.enterpriseName)}`
      });
    },
    
    // 授权印章
    authSeal(seal) {
      // 传递 enterpriseId 参数给授权管理页面
      uni.navigateTo({
        url: `/pages/enterprise/seal-authorize?id=${seal.id}&enterpriseId=${this.enterpriseId}`
      });
    },
    
    // 切换印章状态（启用/禁用）
    async toggleSealStatus(seal, newStatus) {
      const statusText = newStatus === 0 ? '启用' : '禁用';
      const confirmText = newStatus === 0 
        ? `确定要启用印章"${seal.name}"吗？启用后将可以正常使用和授权。`
        : `确定要禁用印章"${seal.name}"吗？禁用后将无法使用，已授权的用户也无法使用此印章。`;
      
      uni.showModal({
        title: `${statusText}印章`,
        content: confirmText,
        confirmColor: newStatus === 0 ? '#00C28A' : '#FF4D4F',
        success: async (res) => {
          if (res.confirm) {
            try {
              // 调用 updateSeal API 更新印章状态
              await updateSeal({
                id: seal.id,
                name: seal.name,
                type: seal.type,
                sealData: seal.sealData, // 后端字段名为 sealData
                status: newStatus,
                enterpriseId: seal.enterpriseId
              });
              
              uni.showToast({
                title: `${statusText}成功`,
                icon: 'success'
              });
              
              // 重新加载印章列表
              this.loadSealList(true);
            } catch (error) {
              console.error(`${statusText}印章失败:`, error);
              uni.showToast({
                title: `${statusText}失败`,
                icon: 'none'
              });
            }
          }
        }
      });
    },
    
    // 删除印章
    deleteSeal(seal) {
      uni.showModal({
        title: '删除印章',
        content: `确定要删除印章"${seal.name}"吗？删除后不可恢复。`,
        confirmColor: '#FF4D4F',
        success: async (res) => {
          if (res.confirm) {
            try {
              // deleteEnterpriseSeal 返回 Promise<boolean>
              const success = await deleteEnterpriseSeal(seal.id);
              
              if (success) {
                uni.showToast({
                  title: '删除成功',
                  icon: 'success'
                });
                
                // 重新加载印章列表
                this.loadSealList(true);
              } else {
                uni.showToast({
                  title: '删除失败',
                  icon: 'none'
                });
              }
            } catch (error) {
              console.error('删除印章失败:', error);
              uni.showToast({
                title: '删除印章失败',
                icon: 'none'
              });
            }
          }
        }
      });
    },
    
    // 格式化日期
    formatDate(timestamp) {
      if (!timestamp) return '';
      
      const date = new Date(timestamp);
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    },
    
    // 获取印章类型文本
    getSealTypeText(type) {
      switch (type) {
        case 1: return '公章';
        case 2: return '财务章';
        case 3: return '合同章';
        case 4: return '法人章';
        case 11: return '个人签名';
        case 12: return '个人印章';
        default: return '其他';
      }
    },
    
    getSealTypeClass(type) {
      switch (type) {
        case 1: return 'tag-official';
        case 2: return 'tag-finance';
        case 3: return 'tag-contract';
        case 4: return 'tag-legal';
        case 11: return 'tag-personal';
        case 12: return 'tag-personal';
        default: return 'tag-other';
      }
    },
    
    // 处理图片加载错误
    handleImageError(seal) {
      console.error(`[企业印章] 图片加载失败: ${seal.name}, URL: ${seal.image}`);
    },
    
    // 处理图片加载成功
    handleImageLoad(seal) {
      // console.log(`[企业印章] 图片加载成功: ${seal.name}`);
    }
  }
};
</script>

<style lang="scss">
/* 根容器 */
.container {
  flex: 1;
  background-color: #F7F8FA;
  display: flex;
  flex-direction: column;
}

/* 企业信息卡片区域 - 白色背景 */
.enterprise-section {
  background-color: #FFFFFF;
  padding: 30rpx 30rpx 30rpx; /* 增加顶部 padding */
  border-bottom: 1rpx solid #F0F2F5;
  margin-top: 20rpx; /* 增加顶部 margin，拉开与导航栏距离 */
}

.enterprise-card {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.enterprise-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx; /* 稍微减小圆角 */
  overflow: hidden;
  background-color: #F5F7FA;
  border: 1rpx solid #EEF0F4;
  margin-right: 24rpx;
}

.enterprise-logo-img {
  width: 100rpx;
  height: 100rpx;
}

.enterprise-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.enterprise-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  line-height: 1.4;
  margin-right: 12rpx;
}

.enterprise-status {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #E8FFEA;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.status-icon {
  font-size: 18rpx;
