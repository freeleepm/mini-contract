<template>
	<view class="sign-entry-page">
		<view class="entry-card">
			<text class="entry-title">正在打开合同签署</text>
			<text class="entry-desc">请稍候，系统正在校验签署链接</text>
		</view>
	</view>
</template>

<script lang="uts">
	import { get } from '@/api/index'
	import { checkAuthAndRedirect } from '@/api/auth'
	import { getSealToken, clearSealToken } from '@/utils/sealTokenManager'
	import { buildSignShareConfig, buildDefaultShareConfig } from '../../utils/share'

	export default {
		data() {
			return {
				contractId: '' as string,
				refCode: '' as string
			}
		},

		onLoad(options: any) {
			if (options && options.ref) {
				this.refCode = String(options.ref)
				this.handleSignLinkEntry()
				return
			}

			if (options && options.id) {
				this.contractId = String(options.id)
				const redirectPath = `/pages/contract-sign/index?id=${this.contractId}`
				if (!checkAuthAndRedirect(false, redirectPath)) {
					return
				}
				this.openH5Sign(this.contractId)
				return
			}

			this.showEntryError('缺少合同ID或签署链接参数')
		},

		// #ifdef MP-WEIXIN
		onShareAppMessage() : any {
			if (this.contractId) {
				const config = buildSignShareConfig(this.contractId, '合同签署', '')
				return {
					title: config.title,
					path: config.path,
					imageUrl: config.imageUrl
				}
			}
			const defaultConfig = buildDefaultShareConfig()
			return {
				title: defaultConfig.title,
				path: defaultConfig.path,
				imageUrl: defaultConfig.imageUrl
			}
		},
		// #endif

		methods: {
			openH5Sign(taskId: string): void {
				uni.redirectTo({
					url: `/pages/contract-sign/h5-sign?taskId=${encodeURIComponent(taskId)}`
				})
			},

			async handleSignLinkEntry(): Promise<void> {
				const redirectPath = `/pages/contract-sign/index?ref=${encodeURIComponent(this.refCode)}`
				if (!checkAuthAndRedirect(false, redirectPath)) {
					return
				}

				uni.showLoading({ title: '正在验证链接...' })
				try {
					const data = await get<any>(`/api/v1/seal/auth/by-ref?ref=${encodeURIComponent(this.refCode)}`)
					uni.hideLoading()

					if (!data || (!data.success && data.linkType !== 'SECURE_SIGN')) {
						this.showEntryError((data && data.errorMsg) ? data.errorMsg : '签署链接已过期或无效')
						return
					}

					if (!data.sealToken) {
						clearSealToken()
						await getSealToken()
					}

					const taskId = data.taskId ? String(data.taskId) : ''
					if (!taskId) {
						this.showEntryError('签署链接未关联有效合同')
						return
					}

					this.contractId = taskId
					if (data.linkType === 'PREVIEW_LINK') {
						uni.redirectTo({
							url: `/pages/contract-detail/index?id=${encodeURIComponent(taskId)}`
						})
						return
					}

					this.openH5Sign(taskId)
				} catch (error: any) {
					uni.hideLoading()
					console.error('[合同签署] 链接验证失败:', error)
					this.showEntryError((error && error.message) ? error.message : '网络异常，请稍后重试')
				}
			},

			showEntryError(message: string): void {
				uni.showModal({
					title: '无法打开合同',
					content: message,
					showCancel: false,
					success: () => {
						const pages = getCurrentPages()
						if (pages.length > 1) {
							uni.navigateBack()
						} else {
							uni.switchTab({ url: '/pages/index/index' })
						}
					}
				})
			}
		}
	}
</script>

<style>
	.sign-entry-page {
		flex: 1;
		align-items: center;
		justify-content: center;
		padding: 48rpx;
		background-color: #F7F9FC;
	}

	.entry-card {
		width: 100%;
		padding: 48rpx 36rpx;
		align-items: center;
		background-color: #FFFFFF;
		border-radius: 24rpx;
	}

	.entry-title {
		font-size: 34rpx;
		font-weight: 600;
		color: #1F2937;
	}

	.entry-desc {
		margin-top: 18rpx;
		font-size: 26rpx;
		color: #64748B;
	}
</style>
