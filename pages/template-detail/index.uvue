<script lang="uts">
	import { getTemplateDetail } from '../../api/templates/index';
	import type { TemplateDetail } from '../../api/templates/index';
	import { getSealPageUrl } from '../../api/seals/index';
	import { formatDateTime } from '../../utils/date';
	import { checkNetworkStatus, testH5ServiceAvailability } from '../../utils/network';
	import { getKycStatus, KycStatus } from '../../utils/kyc-check';
	import KycModal from '../../components/KycModal.uvue';
	import TemplateQrcodeModal from '../../components/TemplateQrcodeModal.uvue';
	import { buildTemplateShareConfig, buildDefaultShareConfig } from '../../utils/share';
	
	export default {
		components: {
			KycModal,
			TemplateQrcodeModal
		},
		data() {
			return {
				// 模板ID
				templateId: '',
				// 模板详情
				templateDetail: null as TemplateDetail | null,
				// 加载状态
				isLoading: false,
			// H5预览页面URL
			viewUrl: '',
			// PDF预览图加载状态
			imageLoading: true,
			// 用户认证状态
			verifyStatus: KycStatus.NOT_VERIFIED as number,
			// 是否显示认证弹窗
			showKycModal: false,
			// 二维码弹窗
			showQrcodeModal: false
			}
		},
		onLoad(options: any) {
		// 检查实名认证状态
		this.checkKycStatus();
		
			// 从路由参数中获取模板ID
			if (options && options.id) {
				this.templateId = options.id;
				console.log('加载模板详情，ID:', this.templateId);
				// 获取模板详情
				this.getTemplateDetail();
			} else {
				uni.showToast({
					title: '模板ID不存在',
					icon: 'none'
				});
				// 延迟返回
				setTimeout(() => {
					uni.navigateBack();
				}, 1500);
			}
		},
		// #ifdef MP-WEIXIN
		onShareAppMessage() : any {
			if (this.templateDetail != null) {
				const detail = this.templateDetail!;
				const config = buildTemplateShareConfig(
					this.templateId,
					detail.name ?? '合同模板'
				);
				return {
					title: config.title,
					path: config.path,
					imageUrl: config.imageUrl
				};
			}
			const defaultConfig = buildDefaultShareConfig();
			return {
				title: defaultConfig.title,
				path: defaultConfig.path,
				imageUrl: defaultConfig.imageUrl
			};
		},
		// #endif
		methods: {
			// 检查实名认证状态
			async checkKycStatus(): Promise<void> {
				try {
					const status = await getKycStatus();
					this.verifyStatus = status;
				} catch (error) {
					console.error('检查实名认证状态失败:', error);
				}
			},
			
			// 检查是否可以执行需要认证的操作
			checkCanProceed(): boolean {
				if (this.verifyStatus === KycStatus.VERIFIED) {
					return true;
				}
				// 显示认证提示
				this.showKycModal = true;
				return false;
			},
			
			// 关闭认证提示弹窗
			closeKycModal(): void {
				this.showKycModal = false;
			},
			
			// 前往实名认证
			goToKyc(): void {
				this.showKycModal = false;
				uni.navigateTo({
					url: '/pages/kyc/personal/index'
				});
			},
			
			// 获取模板详情
			async getTemplateDetail(): Promise<void> {
				if (this.isLoading) return;
				
				this.isLoading = true;
				
				uni.showLoading({
					title: '加载中'
				});
				
				try {
					// 使用真实API
					const detail = await getTemplateDetail(this.templateId);
					
					this.templateDetail = detail;
					
					console.log('模板详情加载成功:', detail);
				} catch (error) {
					console.error('获取模板详情失败:', error);
					uni.showToast({
						title: '加载失败，请重试',
						icon: 'none'
					});
				} finally {
					this.isLoading = false;
					uni.hideLoading();
				}
			},
			
	// 打开二维码弹窗
	openQrcodeModal(): void {
		this.showQrcodeModal = true;
	},

 	// 预览模板（带字段位置标记）
 	async handlePreview(): Promise<void> {
 		if (!this.templateDetail) return;
 		
 		console.log('[模板详情] 🆕 准备使用新的模板预览模式:', {
 			id: this.templateId,
 			name: this.templateDetail.name,
 			content: this.templateDetail.content,
 			fieldCount: this.getAllFields().length
 		});
 		
 		// 构建模板预览 H5 URL - 使用新的 template-preview 模式
 		const fileUrl = this.templateDetail.content || this.templateDetail.previewUrl;
 		
 		if (!fileUrl) {
 			uni.showToast({
 				title: '模板文件不存在',
 				icon: 'none'
 			});
 			return;
 		}

		try {
			uni.showLoading({ title: '正在检测服务...', mask: true });
			
			// 步骤 1: 检查网络状态
			const networkResult = await checkNetworkStatus();
			if (!networkResult.success) {
				uni.hideLoading();
				uni.showModal({
					title: '网络异常',
					content: networkResult.errorMessage || '请检查网络连接后重试',
					showCancel: false
				});
				return;
			}
			
			// 步骤 2: 生成 H5 预览 URL
			uni.showLoading({ title: '正在连接服务...', mask: true });
			
			// 使用新的 getSealPageUrl 函数，传入 template-preview 模式
			// ✅ getSealPageUrl 现在是异步函数，需要 await
			// 🔧 修复：传递 templateId 参数（而不是 fileUrl）
			try {
				this.viewUrl = await getSealPageUrl('template-preview', undefined, {
					templateId: Number(this.templateId)
				});
			} catch (error) {
				uni.hideLoading();
				uni.showModal({
					title: '服务异常',
					content: '无法连接到预览服务\n请稍后重试或联系技术支持',
					showCancel: false
				});
				return;
			}
			
			console.log('[模板详情] ✅ 生成H5模板预览URL:', this.viewUrl);
			
			// 步骤 3: 校验 H5 URL 格式
			uni.showLoading({ title: '正在检测服务状态...', mask: true });
			const serviceResult = await testH5ServiceAvailability(this.viewUrl, 8000);
			
			uni.hideLoading();
			
			if (!serviceResult.available) {
				uni.showModal({
					title: '预览服务暂时不可用',
					content: serviceResult.errorMessage || 'H5预览服务暂时无法访问\n请稍后重试或联系技术支持',
					showCancel: false
				});
				return;
			}
			
			// 步骤 4: 跳转到 WebView 页面
			uni.navigateTo({
				url: `/pages/template-preview/h5-preview?url=${encodeURIComponent(this.viewUrl)}`
			});
		} catch (error) {
			uni.hideLoading();
			uni.showModal({
				title: '打开失败',
				content: '无法打开预览\n请稍后重试',
				showCancel: false
			});
		}
 	},
			
		handleBatchLaunch() {
			if (!this.templateDetail) return;
			uni.navigateTo({
				url: `/pages/batch-create/index?templateId=${this.templateId}`
			});
		},

		// 使用此模板创建合同（先检测H5服务，再跳转）
		async handleUseTemplate(): Promise<void> {
			if (!this.templateDetail) return;
		
		// 先检查实名认证状态
		if (!this.checkCanProceed()) {
			console.log('[模板详情] 未完成实名认证，显示提示弹窗');
			return;
		}
		
		// 检查企业认证状态（如果当前是企业身份）
		try {
			const savedIdentity = uni.getStorageSync('currentIdentity');
			if (savedIdentity && typeof savedIdentity === 'string') {
				const identity = JSON.parse(savedIdentity) as { type?: string; id?: string | number; name?: string; verified?: boolean };
				if (identity && identity.type === 'enterprise' && !identity.verified) {
					console.log('[模板详情] 企业未认证，显示提示弹窗');
					uni.showModal({
						title: '企业未认证',
						content: '当前企业尚未完成认证，无法发起合同。是否前往认证？',
						confirmText: '去认证',
						cancelText: '取消',
						success: (res) => {
							if (res.confirm) {
								uni.navigateTo({
									url: `/pages/kyc/enterprise/index?id=${identity.id}&name=${encodeURIComponent(identity.name || '')}`
								});
							}
						}
					});
					return;
				}
			}
		} catch (e) {
			console.warn('[模板详情] 检查企业认证状态失败:', e);
		}
			
			console.log('[模板详情] 使用模板创建合同:', this.templateId);
			
			try {
				uni.showLoading({ title: '正在检测服务...', mask: true });
				
				// 步骤 1: 检查网络状态
				const networkResult = await checkNetworkStatus();
				if (!networkResult.success) {
					uni.hideLoading();
					uni.showModal({
						title: '网络异常',
						content: networkResult.errorMessage || '请检查网络连接后重试',
						showCancel: false
					});
					return;
				}
				
				// 步骤 2: 获取 H5 创建合同 URL
				uni.showLoading({ title: '正在连接服务...', mask: true });
				
				// 获取当前选择的企业ID
				let enterpriseId: number | undefined = undefined;
				try {
					const savedIdentity = uni.getStorageSync('currentIdentity');
					if (savedIdentity && typeof savedIdentity === 'string') {
						const identity = JSON.parse(savedIdentity) as { type?: string; id?: number };
						if (identity && identity.type === 'enterprise' && identity.id) {
							enterpriseId = identity.id;
						}
					}
				} catch (e) {
					console.warn('[模板详情] 获取当前身份信息失败:', e);
				}
				
				let createUrl: string;
				try {
					createUrl = await getSealPageUrl('create', undefined, { templateId: Number(this.templateId), enterpriseId });
				} catch (error) {
					uni.hideLoading();
					uni.showModal({
						title: '服务异常',
						content: '无法连接到创建服务\n请稍后重试或联系技术支持',
						showCancel: false
					});
					return;
				}
				
				// 步骤 3: 测试 H5 服务器可用性
				uni.showLoading({ title: '正在检测服务状态...', mask: true });
				const serviceResult = await testH5ServiceAvailability(createUrl, 8000);
				
				uni.hideLoading();
				
				if (!serviceResult.available) {
					uni.showModal({
						title: '签署服务暂时不可用',
						content: serviceResult.errorMessage || 'H5签署服务暂时无法访问\n请稍后重试或联系技术支持',
						showCancel: false
					});
					return;
				}
				
				// 步骤 4: 所有检测通过，跳转到H5创建合同页面
				uni.navigateTo({
					url: `/pages/contract-create/h5-create?templateId=${this.templateId}`
				});
				
			} catch (error) {
				uni.hideLoading();
				uni.showModal({
					title: '检测失败',
					content: '无法完成服务检测\n请稍后重试',
					showCancel: false
				});
			}
		},
			
			// 格式化时间
			formatTime(dateTime: string | null): string {
				return formatDateTime(dateTime);
			},
			
			// 获取签署方类型显示文字
		getSignatoryTypeText(type: string): string {
			return type === 'enterprise' ? '企业' : '个人';
		},
		
		// 获取所有字段列表（从签署方中提取）
		getAllFields(): any[] {
			const allFields: any[] = [];
			if (this.templateDetail && this.templateDetail.signatories) {
				this.templateDetail.signatories.forEach((signatory: any, index: number) => {
					if (signatory.fields && signatory.fields.length > 0) {
						signatory.fields.forEach((field: any) => {
							allFields.push({
								...field,
								signatoryIndex: index,
								signatoryName: signatory.name,
								signatoryType: signatory.type
							});
						});
					}
				});
			}
			return allFields;
		},
		
		// 计算字段标记的样式位置
		getFieldMarkerStyle(field: any): object {
			// 将后端返回的坐标转换为CSS样式对象
			// 注意：这里需要根据实际的PDF尺寸和显示尺寸进行缩放
			// 假设PDF宽度为595pt（A4），显示宽度为690rpx（屏幕宽度-60rpx边距）
			const scaleX = 690 / 595;
			const scaleY = scaleX; // 保持比例
			
			const left = (field.positionX || 0) * scaleX;
			const top = (field.positionY || 0) * scaleY;
			const width = (field.width || 100) * scaleX;
			const height = (field.height || 30) * scaleY;
			
			return {
				left: `${left}rpx`,
				top: `${top}rpx`,
				width: `${width}rpx`,
				height: `${height}rpx`
			};
		},
		
		// 根据签署方索引获取颜色类
		getSignatoryColorClass(signatoryIndex: number): string {
			if (signatoryIndex === 0) {
				return 'signatory-1';
			} else if (signatoryIndex === 1) {
				return 'signatory-2';
			} else {
				return 'signatory-other';
			}
		},
		
		// 显示字段详情
		showFieldDetail(field: any): void {
			const message = `字段名称：${field.name}\n所属签署方：${field.signatoryName}\n所在页码：第 ${field.pageNumber} 页\n字段类型：${field.type}\n是否必填：${field.required ? '是' : '否'}`;
			
			uni.showModal({
				title: '字段详情',
				content: message,
				showCancel: false,
				confirmText: '知道了'
			});
		},
		
		// 获取PDF预览图URL
		getPreviewImageUrl(): string {
			if (!this.templateDetail) return '';
			
			// 优先级：
			// 1. previewImage - 专门的PDF预览图（高清）
			// 2. image - 模板缩略图
			// 3. thumbnail - 小缩略图
			// 4. content - PDF文件URL（某些情况下可能是图片格式）
			return this.templateDetail.previewImage 
				|| this.templateDetail.image 
				|| this.templateDetail.thumbnail 
				|| '';
		},
		
		// PDF预览图加载完成
		onImageLoad(): void {
			console.log('[模板详情] PDF预览图加载完成');
			this.imageLoading = false;
		},
		
		// PDF预览图加载失败
		onImageError(): void {
			console.error('[模板详情] PDF预览图加载失败');
			this.imageLoading = false;
					uni.showToast({
				title: 'PDF预览图加载失败',
				icon: 'none',
				duration: 2000
			});
			}
		}
	}
</script>

<template>
	<view class="template-detail">
		<!-- 内容区域 -->
		<scroll-view scroll-y="true" class="content">
			<!-- 加载中 -->
			<view v-if="isLoading" class="loading-container">
				<view class="loading-spinner"></view>
				<text class="loading-text">加载中...</text>
			</view>
			
			<!-- 模板详情 -->
			<view v-else-if="templateDetail" class="detail-content">
				<!-- 模板基本信息 -->
				<view class="template-info-card">
					<view class="template-header">
						<view class="template-title-row">
							<text class="template-title">{{ templateDetail.name }}</text>
							<view v-if="templateDetail.isOfficial" class="official-badge">
								<text class="icon icon-check-circle badge-icon"></text>
								<text class="badge-text">官方</text>
			</view>
			</view>
						<text v-if="templateDetail.description" class="template-desc">{{ templateDetail.description }}</text>
		</view>
		
					<!-- 模板元信息 -->
					<view class="template-meta">
						<view class="meta-item">
							<text class="icon icon-folder meta-icon"></text>
							<text class="meta-text">{{ templateDetail.categoryName || '未分类' }}</text>
				</view>
						<view class="meta-item">
							<text class="icon icon-chart-line meta-icon"></text>
							<text class="meta-text">{{ templateDetail.usageCount || 0 }} 次使用</text>
			</view>
					<view v-if="templateDetail.isHot" class="meta-item hot-tag">
						<text class="icon icon-fire meta-icon"></text>
						<text class="meta-text">热门</text>
				</view>
			</view>
				
				<!-- 二维码操作栏 -->
				<view v-if="templateDetail.qrcodeEnabled" class="qr-action-bar" @click="openQrcodeModal">
					<view class="qr-action-left">
						<text class="fa fa-qrcode qr-action-icon"></text>
						<view class="qr-action-info">
							<text class="qr-action-title">模板二维码</text>
							<text class="qr-action-desc">扫码即可使用此模板创建合同</text>
						</view>
					</view>
					<view class="qr-action-right">
						<text class="qr-action-btn-text">查看</text>
						<text class="fa fa-chevron-right qr-action-arrow"></text>
					</view>
				</view>
		</view>
		
			<!-- 模板预览（字段位置可视化） -->
			<view class="template-preview-card">
				<view class="preview-header-row">
					<view class="preview-header">
						<text class="icon icon-file-pdf section-icon"></text>
						<text class="section-title">字段位置预览</text>
							</view>
					<view class="preview-actions" v-if="templateDetail.content">
						<view class="view-pdf-btn" @click="handlePreview">
							<text class="icon icon-expand view-pdf-icon"></text>
							<text class="view-pdf-text">查看完整PDF</text>
						</view>
						</view>
					</view>
				<text class="preview-tip">在PDF预览图上直观查看字段位置 · 点击字段查看详情</text>
				
				<!-- PDF预览图容器（带字段标记） -->
				<view class="pdf-preview-container" v-if="getPreviewImageUrl()">
					<view class="pdf-page-wrapper">
						<!-- PDF预览图 -->
						<image 
							class="pdf-page-image" 
							:src="getPreviewImageUrl()" 
							mode="widthFix"
							@load="onImageLoad"
							@error="onImageError"
						></image>
						
						<!-- 加载提示 -->
						<view class="image-loading" v-if="imageLoading">
							<text class="loading-spinner"></text>
							<text class="loading-text">加载PDF预览中...</text>
					</view>
						
						<!-- 字段标记叠加层 -->
						<view class="fields-overlay" v-if="!imageLoading && getAllFields().length > 0">
							<view 
								v-for="(field, index) in getAllFields()" 
								:key="'field-' + index"
								class="field-marker"
								:class="getSignatoryColorClass(field.signatoryIndex)"
								:style="getFieldMarkerStyle(field)"
								@click="showFieldDetail(field)"
							>
								<view class="field-marker-border"></view>
								<view class="field-marker-label">
									<text class="field-label-text">{{ field.name }}</text>
					</view>
				</view>
				</view>
			</view>
			
				<!-- 字段快速浏览列表 -->
				<view class="fields-quick-list" v-if="getAllFields().length > 0">
					<text class="quick-list-title">
						<text class="icon icon-clipboard-list"></text>
						字段清单（{{ getAllFields().length }}个）
					</text>
					<view class="fields-grid">
					<view
								v-for="(field, index) in getAllFields()" 
								:key="'quick-' + index"
								class="quick-field-chip"
								@click="showFieldDetail(field)"
							>
								<view class="quick-field-dot" :class="getSignatoryColorClass(field.signatoryIndex)"></view>
								<text class="quick-field-name">{{ field.name }}</text>
								<text class="quick-field-page">P{{ field.pageNumber }}</text>
						</view>
								</view>
					</view>
						</view>
						
			<!-- 无预览图提示 -->
			<view class="no-preview-container" v-else>
				<text class="icon icon-file-pdf no-preview-icon"></text>
				<text class="no-preview-text">暂无PDF预览图</text>
				<text class="no-preview-hint">点击右上角"查看完整PDF"按钮查看</text>
						</view>
						
			<!-- 字段图例 -->
			<view class="field-legend" v-if="getAllFields().length > 0">
				<text class="legend-title">
					<text class="icon icon-info-circle"></text>
					颜色说明：
				</text>
				<view class="legend-items">
						<view class="legend-item">
							<view class="legend-color signatory-1"></view>
							<text class="legend-text">第一签署方</text>
					</view>
						<view class="legend-item">
							<view class="legend-color signatory-2"></view>
							<text class="legend-text">第二签署方</text>
				</view>
						<view class="legend-item">
							<view class="legend-color signatory-other"></view>
							<text class="legend-text">其他签署方</text>
			</view>
					</view>
				</view>
					</view>
					
				<!-- 模板变量说明（如果有） -->
				<view v-if="templateDetail.variables && templateDetail.variables.length > 0" class="template-variables-card">
					<text class="section-title">需要填写的信息</text>
					<view class="variables-list">
						<view v-for="(variable, index) in templateDetail.variables" :key="index" class="variable-item">
							<view class="variable-header">
								<text class="variable-name">{{ variable.name }}</text>
								<view v-if="variable.required" class="required-tag">
									<text class="required-text">必填</text>
						</view>
							</view>
							<text v-if="variable.placeholder" class="variable-placeholder">{{ variable.placeholder }}</text>
							</view>
						</view>
					</view>
					
				<!-- 签署方信息（如果有） -->
				<view v-if="templateDetail.signatories && templateDetail.signatories.length > 0" class="template-signatories-card">
					<text class="section-title">签署方信息</text>
					<view class="signatories-list">
						<view v-for="(signatory, index) in templateDetail.signatories" :key="index" class="signatory-item">
							<view class="signatory-header">
								<view class="signatory-name-row">
									<text class="signatory-name">{{ signatory.name }}</text>
									<view class="signatory-type-tag">
										<text class="signatory-type-text">{{ getSignatoryTypeText(signatory.type) }}</text>
							</view>
						</view>
								<view v-if="signatory.needSign" class="sign-badge">
									<text class="icon icon-signature sign-icon"></text>
									<text class="sign-text">需要签署</text>
							</view>
						</view>
						
							<!-- 签署方关联字段 -->
							<view v-if="signatory.fields && signatory.fields.length > 0" class="signatory-fields">
							<text class="fields-title">需要填写/签署的位置：</text>
							<view class="fields-list">
								<view v-for="(field, fidx) in signatory.fields" :key="fidx" class="field-chip">
									<text class="icon icon-edit field-icon"></text>
									<text class="field-name">{{ field.name }}</text>
									<text class="field-page">第{{ field.pageNumber }}页</text>
							</view>
						</view>
							</view>
						</view>
						</view>
					</view>
					
				<!-- 模板更新时间 -->
				<view class="template-time-card">
					<view class="time-item">
						<text class="icon icon-clock time-icon"></text>
						<text class="time-text">更新于 {{ formatTime(templateDetail.updateTime) }}</text>
					</view>
				</view>
			</view>
		</scroll-view>
		
	<!-- 底部固定操作栏 -->
	<view class="bottom-bar" v-if="templateDetail">
		<!-- 批量发起按钮 -->
		<view class="bottom-button secondary" @click="handleBatchLaunch">
			<text class="icon icon-copy btn-icon"></text>
			<text class="btn-text-secondary">批量发起</text>
		</view>
		<!-- 使用模版按钮 -->
		<view class="bottom-button primary" @click="handleUseTemplate">
			<text class="icon icon-plus-circle btn-icon"></text>
			<text class="btn-text">使用此模版</text>
		</view>
	</view>
	
	<!-- 实名认证提示弹窗 - 使用统一组件 -->
	<kyc-modal 
		:visible="showKycModal"
		description="为保障合同的法律效力，使用模板创建合同前需要完成实名认证。"
		@close="closeKycModal"
		@confirm="goToKyc"
	/>
	
	<!-- 二维码弹窗 -->
	<TemplateQrcodeModal 
		:visible="showQrcodeModal"
		:templateName="templateDetail != null ? templateDetail!.name : ''"
		:baseTemplateId="templateDetail != null ? String(templateDetail!.baseTemplateId ?? templateDetail!.id) : ''"
		@update:visible="(val: boolean) => { showQrcodeModal = val }"
		@close="showQrcodeModal = false"
	/>
	</view>
</template>

<style>
/* FontAwesome基础样式 */
.fa {
