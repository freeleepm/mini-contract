	gap: 24rpx;
}

.legend-item {
	flex-direction: row;
		align-items: center;
	}
	
.legend-color {
	width: 32rpx;
	height: 20rpx;
	border-radius: 4rpx;
	margin-right: 8rpx;
	border-width: 2rpx;
	border-style: solid;
}

