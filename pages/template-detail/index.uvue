}

/* 预览卡片头部 */
.preview-header {
	display: flex;  /* 确保flex布局生效 */
	flex-direction: row;
	align-items: center;
}

.preview-header .section-title {
	display: inline-block;  /* 覆盖默认的block，使其参与flex布局 */
