/* 字段标记叠加层 */
.fields-overlay {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
		bottom: 0;
	pointer-events: none;
}

.field-marker {
	position: absolute;
	pointer-events: all;
	cursor: pointer;
	transition: all 0.2s ease;
}

.field-marker:active {
	transform: scale(1.05);
}

/* 字段标记边框 */
.field-marker-border {
	position: absolute;
	top: 0;
		left: 0;
		right: 0;
	bottom: 0;
	border-width: 3rpx;
	border-style: solid;
	border-radius: 6rpx;
	background-color: rgba(255, 255, 255, 0.1);
}

/* 字段标记标签 */
.field-marker-label {
	position: absolute;
	bottom: 100%;
	left: 0;
	min-width: 120rpx;
	padding: 4rpx 12rpx;
	background-color: rgba(0, 0, 0, 0.75);
	border-radius: 6rpx;
	margin-bottom: 6rpx;
	white-space: nowrap;
}

.field-label-text {
	font-size: 22rpx;
		color: #FFFFFF;
	font-weight: 500;
}

