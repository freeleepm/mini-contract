<script lang="uts">
import { 
	getContract, 
	cancelContract, 
	deleteContract,
	downloadContract,
	ContractStatus,
	ParticipantStatus,
	getContractStatusName,
	getContractStatusColor,
	getParticipantStatusName,
	generateSignLink
} from '../../api/contracts/index';
import type { Contract, GenerateSignLinkParams } from '../../api/contracts/index';
// 已不再需要单独调用模板接口，模板名称从签署任务中获取
// import { getTemplateDetail } from '../../api/templates/index';
import { downloadContractFile } from '../../api/utils/download.uts';
import { post } from '../../api/index';
import { getSealPageUrl } from '../../api/seals/index';
import { buildViewShareConfig, buildSignShareConfig } from '../../utils/share';
import { buildShareTitle } from '../../config/app.config';
import { 
	checkNetworkStatus, 
	testH5ServiceAvailability
} from '../../utils/network';
	
	export default {
		data() {
			return {
				// 合同ID
				contractId: '',
			
				// 合同详情数据
			contract: null as Contract | null,
			
			// 🔧 合同状态常量（注意：后端状态从1开始，不是0！）
			STATUS_DRAFT: 1,
			STATUS_SIGNING: 2,
			STATUS_COMPLETED: 3,
			STATUS_CANCELLED: 4,
			STATUS_REJECTED: 5,
			STATUS_EXPIRED: 6,
			STATUS_FORM_FILLING: 7,      // 表单填写中
			
		// 🔧 参与人状态常量（与后端 SealSignTaskParticipantStatusEnum 保持一致）
		PARTICIPANT_PENDING: 0,         // 待处理
		PARTICIPANT_FORM_FILLED: 1,     // 表单已填写
		PARTICIPANT_SIGNED: 2,          // 已签署
		PARTICIPANT_REJECTED: 3,        // 已拒绝
		PARTICIPANT_CANCELLED: 4,       // 已取消
			
		// 当前用户ID（用于权限判断）
		currentUserId: '' as string,
		// 当前用户手机号（用于"历史手机号"标识判断）
		currentUserMobile: '' as string,
		
	// 🎨 头像颜色池（优雅的中性色系 + 柔和色调）
	avatarColors: [
		['#8B9DC3'],  // 优雅蓝灰
		['#9BA3AF'],  // 经典灰
		['#8BA3A3'],  // 雾霾蓝
		['#A8B5C7'],  // 浅石板蓝
		['#97A7B3'],  // 中性蓝灰
		['#9CA9B3'],  // 冷灰蓝
		['#8D9BA8'],  // 铁灰蓝
		['#A2B1C2'],  // 柔和蓝
	] as string[][],
		
		// 加载状态
		loading: true,
		
		// 模板名称
		templateName: '',
		
		// 🔧 首次加载标记（避免 onShow 重复调用接口）
		isFirstLoad: true,
		
		// 🔗 分享弹窗显示状态
		showSharePopup: false
	}
},
	
	onLoad(options: any) {
		// 🔧 获取当前用户ID和手机号
		try {
			const userInfo = uni.getStorageSync('userInfo');
			if (userInfo && userInfo.id) {
				this.currentUserId = String(userInfo.id);
				this.currentUserMobile = (userInfo.mobile as string | null) ?? '';
				console.log('✅ 当前用户ID:', this.currentUserId);
			} else {
				console.warn('⚠️ 未找到用户信息，使用默认用户ID: 1');
				this.currentUserId = '1';
			}
		} catch (error) {
			console.error('获取用户ID失败:', error);
			this.currentUserId = '1';
		}
		
		// 从路由参数中获取合同ID
		if (options && options.id) {
		this.contractId = options.id;
		console.log('加载合同详情，ID:', this.contractId);
		this.loadContractDetail();
		} else {
			uni.showToast({
				title: '合同ID不存在',
				icon: 'none'
		});
			// 延迟返回
				setTimeout(() => {
				uni.navigateBack();
			}, 1500);
			}
		},
	
// #ifdef MP-WEIXIN
onShareAppMessage() : any {
	// 根据合同状态决定分享类型：签署中的合同用「邀请签署」，其他用「查看合同」
	if (this.contract != null) {
		const contract = this.contract!;
		const title = (contract as any).title ?? '合同';
		const id = this.contractId;
		const creatorName = (contract as any).creatorName ?? '';
		
		// 签署中的合同使用签署邀请分享
		const status = (contract as any).status;
		if (status === this.STATUS_SIGNING || status === this.STATUS_FORM_FILLING) {
			const config = buildSignShareConfig(id, title, creatorName);
			return {
				title: config.title,
				path: config.path,
				imageUrl: config.imageUrl
			};
		}
		
		// 其他状态使用查看分享
		const config = buildViewShareConfig(id, title);
		return {
			title: config.title,
			path: config.path,
			imageUrl: config.imageUrl
		};
	}
	// 合同未加载时的默认分享
	return {
		title: buildShareTitle('查看合同详情'),
		path: '/pages/share/landing?type=app'
	};
},
// #endif

onShow() {
	// 🔧 页面显示时刷新数据（仅在非首次加载时，即从其他页面返回时）
	if (this.isFirstLoad) {
		// 首次加载，由 onLoad 处理，这里跳过
		this.isFirstLoad = false;
		console.log('📱 首次加载，跳过 onShow 中的接口调用');
	} else if (this.contractId) {
		// 从其他页面返回，刷新数据
		console.log('📱 页面重新显示（从其他页面返回），刷新合同详情');
		this.loadContractDetail();
	}
},
	
		methods: {
		/**
		 * 加载合同详情
		 */
		async loadContractDetail(): Promise<void> {
			try {
				this.loading = true;
				
				uni.showLoading({
					title: '加载中'
				});
				
			// 调用真实API获取合同详情
			const detail: Contract = await getContract(this.contractId);
			
			console.log('合同详情:', JSON.stringify(detail));
			console.log('参与人信息:', detail.participants);
			console.log('参与人数量:', detail.participants ? detail.participants.length : 0);
			
			// 🔧 详细打印每个参与人的信息（包括状态诊断）
			if (detail.participants && detail.participants.length > 0) {
				console.log(`📋 发现 ${detail.participants.length} 个参与人`);
				detail.participants.forEach((p: any, index: number) => {
					console.log(`\n👤 参与人${index + 1}:`, JSON.stringify(p));
					console.log(`  - userId: ${p.userId}`);
					console.log(`  - name: ${p.name || p.nickname || '未知'}`);
					console.log(`  - mobile: ${p.mobile || '无'}`);
					console.log(`  - status: ${p.status} (类型: ${typeof p.status}) ← 后端字段名`);
					console.log(`  - signTime: ${p.signTime || '无'}`);
					console.log(`  - order: ${p.order}`);
					console.log(`  - rejectReason: ${p.rejectReason || '无'}`);
					
					// 🔧 显示状态映射结果
					const statusName = this.getParticipantStatus(p.status);
					console.log(`  - ✅ 状态名称: ${statusName}`);
					
					if (statusName === '未知') {
						console.warn(`⚠️ 警告：参与人 ${index + 1} 的状态值 "${p.status}" (类型: ${typeof p.status}) 无法识别！`);
						console.warn(`  预期值: 0(待签署), 1(已签署), 2(已拒绝), 3(已取消)`);
					}
					
					console.log(`  - 所有字段:`, Object.keys(p).join(', '));
				});
				console.log(`\n✅ 参与人信息加载完成\n`);
			}
			
			this.contract = detail;
				
			// 🔧 优化：模板名称直接从签署任务中获取（后端已包含 templateName 字段）
			if ((detail as any).templateName) {
				this.templateName = (detail as any).templateName;
				console.log('模板名称:', this.templateName);
			} else if (detail.templateId) {
				// 兜底方案：如果后端没有返回 templateName，显示模板ID
				this.templateName = `模板 ${detail.templateId}`;
				console.log('未获取到模板名称，使用兜底方案');
			}
				
				uni.hideLoading();
				
				} catch (error) {
				console.error('加载合同详情失败:', error);
				
				uni.hideLoading();
				
				uni.showModal({
					title: '加载失败',
					content: '合同详情加载失败，请重试',
					showCancel: true,
					confirmText: '重试',
					cancelText: '返回',
					success: (res) => {
						if (res.confirm) {
							// 重试
							this.loadContractDetail();
						} else {
							// 返回
							uni.navigateBack();
						}
					}
					});
				} finally {
				this.loading = false;
			}
		},
		
	/**
	 * 🆕 填写表单（先检测H5服务，再跳转H5表单页面）
	 * 
	 * 检测流程：
	 * 1. 检查用户网络状态
	 * 2. 获取 H5 表单填写 URL
	 * 3. 测试 H5 服务器可用性
	 * 4. 检测通过后才跳转
	 */
	async handleFillForm(): Promise<void> {
		if (!this.contract) return;
		
		console.log('[合同详情] 准备填写表单:', this.contract.id);
		
		// 检查认证状态（根据身份类型）
		try {
			const savedIdentity = uni.getStorageSync('currentIdentity');
			if (savedIdentity) {
				const identity = JSON.parse(savedIdentity) as { type?: string; id?: string | number; name?: string; verified?: boolean };
				if (identity) {
					// 个人身份需要检查个人实名认证
					if (identity.type === 'personal' && !identity.verified) {
						console.log('[合同详情] 个人未实名认证，显示提示弹窗');
						uni.showModal({
							title: '请先实名认证',
							content: '为保障合同的法律效力，填写表单前需要完成实名认证。',
							confirmText: '去认证',
							cancelText: '取消',
							success: (res) => {
								if (res.confirm) {
									uni.navigateTo({ url: '/pages/kyc/personal/index' });
								}
							}
						});
						return;
					}
					// 企业身份需要检查企业认证
					if (identity.type === 'enterprise' && !identity.verified) {
						console.log('[合同详情] 企业未认证，显示提示弹窗');
						uni.showModal({
							title: '企业未认证',
							content: '当前企业尚未完成认证，无法填写表单。是否前往认证？',
							confirmText: '去认证',
							cancelText: '取消',
							success: (res) => {
								if (res.confirm) {
									uni.navigateTo({
										url: `/pages/kyc/enterprise/index?id=${identity.id}&name=${encodeURIComponent(identity.name || '')}`
									});
								}
							}
						});
						return;
					}
				}
			}
		} catch (e) {
			console.warn('[合同详情] 检查认证状态失败:', e);
		}
		
		try {
			// 显示检测进度
			uni.showLoading({ 
				title: '正在检测服务...',
				mask: true 
			});
			
			// 步骤 1: 检查网络状态
			const networkResult = await checkNetworkStatus();
			if (!networkResult.success) {
				uni.hideLoading();
				uni.showModal({
					title: '网络异常',
					content: networkResult.errorMessage || '请检查网络连接后重试',
					showCancel: false
				});
				return;
			}
			
			// 步骤 2: 获取 H5 表单填写 URL
			uni.showLoading({ 
				title: '正在连接服务...',
				mask: true 
			});
			
			let formUrl: string;
			try {
				formUrl = await getSealPageUrl('form', this.contract.id);
			} catch (error) {
				uni.hideLoading();
				uni.showModal({
					title: '服务异常',
					content: '无法连接到表单服务\n请稍后重试或联系技术支持',
					showCancel: false
				});
				return;
			}
			
			// 步骤 3: 测试 H5 服务器可用性
			uni.showLoading({ 
				title: '正在检测服务状态...',
				mask: true 
			});
			
			const serviceResult = await testH5ServiceAvailability(formUrl, 8000);
			
			uni.hideLoading();
			
			if (!serviceResult.available) {
				uni.showModal({
					title: '签署服务暂时不可用',
					content: serviceResult.errorMessage || 'H5签署服务暂时无法访问\n请稍后重试或联系技术支持',
					showCancel: false
				});
				return;
			}
			
			// 步骤 4: 所有检测通过，跳转到表单填写页面
			uni.navigateTo({
				url: `/pages/contract-form/h5-fill?taskId=${this.contract.id}`
			});
			
		} catch (error) {
			uni.hideLoading();
			uni.showModal({
				title: '检测失败',
				content: '无法完成服务检测\n请稍后重试',
				showCancel: false
			});
		}
	},
	
	/**
	 * 签署合同（先检测H5服务，再跳转H5签署页面）
	 * 
	 * 检测流程：
	 * 1. 检查用户网络状态
	 * 2. 获取 H5 签署 URL
	 * 3. 测试 H5 服务器可用性
	 * 4. 检测通过后才跳转
	 */
async handleSign(): Promise<void> {
	if (!this.contract) return;
	
	console.log('[合同详情] 准备签署合同:', this.contract.id);
	
	// 检查认证状态（根据身份类型）
	try {
		const savedIdentity = uni.getStorageSync('currentIdentity');
		if (savedIdentity) {
			const identity = JSON.parse(savedIdentity) as { type?: string; id?: string | number; name?: string; verified?: boolean };
			if (identity) {
				// 个人身份需要检查个人实名认证
				if (identity.type === 'personal' && !identity.verified) {
					console.log('[合同详情] 个人未实名认证，显示提示弹窗');
					uni.showModal({
						title: '请先实名认证',
						content: '为保障合同的法律效力，签署合同前需要完成实名认证。',
						confirmText: '去认证',
						cancelText: '取消',
						success: (res) => {
							if (res.confirm) {
								uni.navigateTo({ url: '/pages/kyc/personal/index' });
							}
						}
					});
					return;
				}
				// 企业身份需要检查企业认证
				if (identity.type === 'enterprise' && !identity.verified) {
					console.log('[合同详情] 企业未认证，显示提示弹窗');
					uni.showModal({
						title: '企业未认证',
						content: '当前企业尚未完成认证，无法签署合同。是否前往认证？',
						confirmText: '去认证',
						cancelText: '取消',
						success: (res) => {
							if (res.confirm) {
								uni.navigateTo({
									url: `/pages/kyc/enterprise/index?id=${identity.id}&name=${encodeURIComponent(identity.name || '')}`
								});
							}
						}
					});
					return;
				}
			}
		}
	} catch (e) {
		console.warn('[合同详情] 检查认证状态失败:', e);
	}
	
	try {
		// 显示检测进度
		uni.showLoading({ 
			title: '正在检测签署服务...',
			mask: true 
		});
		
		// 步骤 1: 检查网络状态
		const networkResult = await checkNetworkStatus();
		if (!networkResult.success) {
			uni.hideLoading();
			uni.showModal({
				title: '网络异常',
				content: networkResult.errorMessage || '请检查网络连接后重试',
				showCancel: false
			});
			return;
		}
		
		// 步骤 2: 获取 H5 签署 URL
		uni.showLoading({ 
			title: '正在连接签署服务...',
			mask: true 
		});
		
		let signUrl: string;
		try {
			signUrl = await getSealPageUrl('sign', this.contract.id);
		} catch (error) {
			uni.hideLoading();
			uni.showModal({
				title: '服务异常',
				content: '无法连接到签署服务\n请稍后重试或联系技术支持',
				showCancel: false
			});
			return;
		}
		
		// 步骤 3: 测试 H5 服务器可用性
		uni.showLoading({ 
			title: '正在检测服务状态...',
			mask: true 
		});
		
		const serviceResult = await testH5ServiceAvailability(signUrl, 8000);
		
		uni.hideLoading();
		
		if (!serviceResult.available) {
			uni.showModal({
				title: '签署服务暂时不可用',
				content: serviceResult.errorMessage || 'H5签署服务暂时无法访问\n请稍后重试或联系技术支持',
				showCancel: false
			});
			return;
		}
		
		// 步骤 4: 所有检测通过，跳转到签署页面
		uni.navigateTo({
			url: `/pages/contract-sign/h5-sign?taskId=${this.contract.id}`
		});
		
	} catch (error) {
		uni.hideLoading();
		uni.showModal({
			title: '检测失败',
			content: '无法完成服务检测\n请稍后重试',
			showCancel: false
		});
	}
},
		
		/**
		 * 撤销合同
		 */
		async handleCancel(): Promise<void> {
			if (!this.contract) return;
			
			uni.showModal({
				title: '撤销合同',
				content: '确定要撤销该合同吗？撤销后将无法恢复。',
				success: async (res) => {
					if (res.confirm) {
						try {
							uni.showLoading({
								title: '撤销中...'
							});
							
							// 调用撤销API
							await cancelContract(this.contract!.id);
							
							uni.hideLoading();
							
							// 成功提示
				uni.showToast({
								title: '合同已撤销',
								icon: 'success'
							});
							
							// 延迟返回上一页
							setTimeout(() => {
								uni.navigateBack();
							}, 1500);
							
						} catch (error) {
							uni.hideLoading();
							console.error('撤销失败:', error);
						uni.showToast({
								title: '撤销失败',
								icon: 'none'
							});
						}
					}
				}
			});
		},
		
		/**
		 * 删除合同
		 */
		async handleDelete(): Promise<void> {
			if (!this.contract) return;
			
				uni.showModal({
				title: '删除合同',
				content: '确定要删除该合同吗？删除后将无法恢复。',
				success: async (res) => {
						if (res.confirm) {
						try {
							uni.showLoading({
								title: '删除中...'
							});
							
							// 调用删除API
							await deleteContract(this.contract!.id);
							
							uni.hideLoading();
							
			// 成功提示
								uni.showToast({
								title: '合同已删除',
									icon: 'success'
							});
								
							// 延迟返回上一页
								setTimeout(() => {
								uni.navigateBack();
							}, 1500);
							
						} catch (error) {
							uni.hideLoading();
							console.error('删除失败:', error);
							uni.showToast({
								title: '删除失败',
								icon: 'none'
							});
						}
					}
				}
			});
		},
		
	/**
	 * 下载合同
	 */
	async handleDownload(): Promise<void> {
		if (!this.contract) return;
		
		try {
			console.log('📥 下载合同:', this.contract.id);
			
			// 使用已签署的文件或原文件
			const fileUrl = this.contract.signedFileUrl || this.contract.fileUrl;
			
			if (!fileUrl) {
				uni.showToast({
					title: '文件不存在',
					icon: 'none',
					duration: 2000
				});
				return;
			}
			
			// 生成文件名
			const fileName = `${this.contract.name || '合同'}_${this.contract.id}.pdf`;
			
			// 使用统一的下载工具
			await downloadContractFile(fileUrl, fileName);
			
		} catch (error) {
			console.error('❌ 下载合同失败:', error);
			uni.showToast({
				title: '下载失败',
				icon: 'none',
				duration: 2000
			});
		}
	},
	
	/**
	 * AI审查合同
	 */
	async handleAIAudit(): Promise<void> {
		if (!this.contract) return;
		
		try {
			uni.showLoading({
				title: '正在启动AI审查...'
			});
			
			// 调用后端接口发起AI审查
			const taskId = await post<number>('/api/v1/seal/audit/start', {
				contractId: this.contract.id,
				auditType: 1 // 标准审查
		}, {
			timeout: 180000  // AI审查需要3分钟超时
			});
			
			uni.hideLoading();
			
			uni.showToast({
				title: 'AI审查已启动',
				icon: 'success'
			});
			
			// 跳转到审查进度页
			setTimeout(() => {
				uni.navigateTo({
					url: `/pages/contract-audit/progress?taskId=${taskId}`
				});
			}, 1000);
		} catch (error) {
			uni.hideLoading();
			console.error('AI审查启动失败:', error);
			uni.showToast({
				title: (error instanceof Error ? error.message : String(error)) || '网络错误',
				icon: 'none',
				duration: 2000
			});
		}
	},
	
	/**
	 * 预览合同（先检测H5服务，再跳转H5预览页面）
	 * 
	 * 检测流程：
	 * 1. 检查用户网络状态
	 * 2. 获取 H5 预览 URL
	 * 3. 测试 H5 服务器可用性
	 * 4. 检测通过后才跳转
	 */
	async handlePreview(): Promise<void> {
			if (!this.contract) return;
			
			console.log('[合同详情] 准备预览合同:', this.contract.id);
			
			try {
				// 显示检测进度
				uni.showLoading({ 
					title: '正在检测预览服务...',
					mask: true 
				});
				
				// 步骤 1: 检查网络状态
				const networkResult = await checkNetworkStatus();
				if (!networkResult.success) {
					uni.hideLoading();
					uni.showModal({
						title: '网络异常',
						content: networkResult.errorMessage || '请检查网络连接后重试',
						showCancel: false
					});
					return;
				}
				
				// 步骤 2: 获取 H5 预览 URL
				uni.showLoading({ 
					title: '正在连接预览服务...',
					mask: true 
				});
				
				let viewUrl: string;
				try {
					viewUrl = await getSealPageUrl('view', this.contract.id);
				} catch (error) {
					uni.hideLoading();
					uni.showModal({
						title: '服务异常',
						content: '无法连接到预览服务\n请稍后重试或联系技术支持',
						showCancel: false
					});
					return;
				}
				
				// 步骤 3: 测试 H5 服务器可用性
				uni.showLoading({ 
					title: '正在检测服务状态...',
					mask: true 
				});
				
				const serviceResult = await testH5ServiceAvailability(viewUrl, 8000);
				
				uni.hideLoading();
				
				if (!serviceResult.available) {
					uni.showModal({
						title: '预览服务暂时不可用',
						content: serviceResult.errorMessage || 'H5预览服务暂时无法访问\n请稍后重试或联系技术支持',
						showCancel: false
					});
					return;
				}
				
				// 步骤 4: 所有检测通过，跳转到预览页面
				// 🔧 后端已经自动处理：已完成时 fileUrl = signedFileUrl，其他状态 fileUrl = 原文件
				const previewUrl = this.contract.fileUrl;
				const encodedUrl = encodeURIComponent(previewUrl);
				const jumpUrl = `/pages/contract-view/h5-view?taskId=${this.contract.id}&fileUrl=${encodedUrl}&status=${this.contract.status}`;
				
				console.log('🚀 跳转URL:', jumpUrl);
				
				uni.navigateTo({
					url: jumpUrl
				});
				
			} catch (error) {
				uni.hideLoading();
				uni.showModal({
					title: '检测失败',
					content: '无法完成服务检测\n请稍后重试',
					showCancel: false
				});
			}
		},
		
		/**
		 * 获取状态名称（基础版本）
		 */
		getStatusName(status: ContractStatus): string {
			return getContractStatusName(status);
		},
		
		/**
		 * 🆕 获取智能状态名称（根据当前用户角色显示不同文本）
		 */
		getSmartStatusName(): string {
			if (!this.contract) return '';
			
			// 表单填写中状态
			if (this.contract.status === this.STATUS_FORM_FILLING) {
				// 只有明确需要自己填写表单时才显示"待填写"
				if (this.canFillForm()) {
					return '待填写';
				}
				// 🔧 其他所有情况（发起人/已填完/DIRECT模式等）都显示"他人填写中"
				return '他人填写中';
			}
			
			// 签署中状态
			if (this.contract.status === this.STATUS_SIGNING) {
				// 只有明确需要自己签署时才显示"待签署"
				if (this.canSign()) {
					return '待签署';
				}
				// 🔧 其他所有情况（发起人/已签署等）都显示"他人签署中"
				return '他人签署中';
			}
			
			// 其他状态使用默认名称
			return getContractStatusName(this.contract.status);
		},
		
		/**
		 * 🆕 判断当前用户是否在等待他人填写表单
		 */
		isWaitingForOthersToFillForm(): boolean {
			if (!this.contract) return false;
			if (this.contract.status !== this.STATUS_FORM_FILLING) return false;
			
			const myParticipant = this.contract.participants?.find(
				(p: any) => p.isCurrentUser === true
			);
			
			if (!myParticipant) return false;
			
			// DIRECT模式的用户在表单填写阶段等待他人
			if (myParticipant.flowMode === 'DIRECT' && myParticipant.status === this.PARTICIPANT_PENDING) {
				return true;
			}
			// TWO_STAGE模式用户已填写表单，但在等待他人填写
			if (myParticipant.flowMode === 'TWO_STAGE' && myParticipant.status === this.PARTICIPANT_FORM_FILLED) {
				return true;
			}
			return false;
		},
		
		/**
		 * 🆕 判断当前用户是否在等待他人签署
		 */
		isWaitingForOthersToSign(): boolean {
			if (!this.contract) return false;
			if (this.contract.status !== this.STATUS_SIGNING) return false;
			
			const myParticipant = this.contract.participants?.find(
				(p: any) => p.isCurrentUser === true
			);
			
			if (!myParticipant) return false;
			
			// 当前用户已签署，等待他人
			return myParticipant.status === this.PARTICIPANT_SIGNED;
		},
		
		/**
		 * 获取状态颜色
		 */
		getStatusColor(status: ContractStatus): string {
			return getContractStatusColor(status);
		},
		
	/**
	 * 获取参与人状态名称（增强版，考虑流程模式）
	 */
	getParticipantStatus(status: ParticipantStatus): string {
		// 使用API中的统一状态名称映射
		return getParticipantStatusName(status);
	},
	
	/**
	 * 🔧 获取参与人状态文本（考虑流程模式）
	 * 与PC端保持一致的实现
	 */
	getParticipantStatusText(participant: any): string {
		const status = participant.status;
		const flowMode = participant.flowMode || null;
		
		// 如果是待处理状态，需要根据流程模式区分
		if (status === this.PARTICIPANT_PENDING) {
			// 两阶段模式：先填表后签署
			if (flowMode === 'TWO_STAGE') {
				return '待填表';
			}
			// 直接签署模式
			return '待签署';
		}
		
		// 其他状态：使用标准状态名称
		return getParticipantStatusName(status);
	},
		
	/**
	 * 获取参与人姓名（参考后台代码实现）
	 */
	getParticipantName(participant: any): string {
		// 参考后台 seal/signTask/index.vue 第446行的实现
		return participant.userName || participant.nickname || '未知';
	},
	
	/**
	 * 🔧 根据用户ID获取头像颜色（随机但固定）
	 */
	getAvatarColor(userId: any): string[] {
		// 将用户ID转换为数字
		const id = String(userId || '0');
		let hash = 0;
		for (let i = 0; i < id.length; i++) {
			hash = id.charCodeAt(i) + ((hash << 5) - hash);
		}
		// 使用 hash 值选择颜色
		const index = Math.abs(hash) % this.avatarColors.length;
		return this.avatarColors[index];
	},
		
	/**
	 * 🔧 手机号脱敏处理
	 * @param phone 手机号
	 * @returns 脱敏后的手机号（例如：136****6666）
	 */
	maskPhone(phone: string): string {
		if (!phone || phone.length < 11) return phone;
		return phone.substring(0, 3) + '****' + phone.substring(7);
	},
	
	/**
	 * 格式化日期时间
	 */
	formatDateTime(dateStr: string | null): string {
			if (!dateStr) return '';
			
			try {
				let date: Date;
				// 判断是时间戳还是日期字符串
				if (/^\d+$/.test(dateStr)) {
					// 时间戳
					date = new Date(parseInt(dateStr));
				} else {
					// 日期字符串
					date = new Date(dateStr);
				}
				
				// 检查日期是否有效
				if (isNaN(date.getTime())) {
					return dateStr;
				}
				
				const year = date.getFullYear();
				const month = String(date.getMonth() + 1).padStart(2, '0');
				const day = String(date.getDate()).padStart(2, '0');
				const hours = String(date.getHours()).padStart(2, '0');
				const minutes = String(date.getMinutes()).padStart(2, '0');
				
				return `${year}-${month}-${day} ${hours}:${minutes}`;
			} catch (error) {
				console.error('日期格式化失败:', error);
				return dateStr || '';
			}
		},
		
	/**
	 * 🆕 判断是否可以填写表单
	 * 条件：任务状态=表单填写中(7) 且 当前用户的参与人模式=TWO_STAGE 且 状态=PENDING(0)
	 */
	canFillForm(): boolean {
		if (!this.contract) return false;
		if (this.contract.status !== 7) return false;  // STATUS_FORM_FILLING
		
		// 🔧 直接使用后端返回的isCurrentUser字段，支持userId和手机号两种匹配方式
		const myParticipant = this.contract.participants?.find(
			(p: any) => p.isCurrentUser === true
		);
		
		if (!myParticipant) return false;
		
		// 必须是两阶段模式且状态为待处理
		return myParticipant.flowMode === 'TWO_STAGE' && myParticipant.status === this.PARTICIPANT_PENDING;
	},
	
	/**
	 * 🔧 判断是否可以签署
	 * 
	 * 签署权限规则：
	 * 1. FORM_FILLING(7)状态：任何人都不能签署！必须等所有人填完表
	 * 2. SIGNING(2)状态：所有状态为PENDING或FORM_FILLED的参与者都可以签署
	 */
	canSign(): boolean {
		if (!this.contract) return false;
		
		// 🔧 只有签署中状态才能签署，表单填写中不能签署！
		if (this.contract.status !== this.STATUS_SIGNING) return false;
		
		// 🔧 直接使用后端返回的isCurrentUser字段，支持userId和手机号两种匹配方式
		const myParticipant = this.contract.participants?.find(
			(p: any) => p.isCurrentUser === true
		);
		
		if (!myParticipant) return false;
		
		// 🎯 SIGNING(2)阶段：状态为PENDING或FORM_FILLED的参与者都可以签署
		// PENDING: 直接进入签署阶段的参与者（SIMPLE/DIRECT模式）
		// FORM_FILLED: 已完成表单填写的参与者（TWO_STAGE模式）
		return myParticipant.status === this.PARTICIPANT_PENDING || 
		       myParticipant.status === this.PARTICIPANT_FORM_FILLED;
	},
		
	/**
	 * 🔧 判断是否可以撤销（加入权限判断）
	 */
	canCancel(): boolean {
		if (!this.contract) return false;
		
		// 只有草稿、表单填写中或签署中的合同可以撤销
		if (this.contract.status !== this.STATUS_DRAFT && 
		    this.contract.status !== this.STATUS_SIGNING &&
		    this.contract.status !== 7) {  // STATUS_FORM_FILLING
			return false;
		}
		
		// 只有创建者可以撤销
		return String(this.contract.creator) === String(this.currentUserId);
	},
		
		/**
		 * 🔧 判断是否可以删除（加入权限判断）
		 */
		canDelete(): boolean {
			if (!this.contract) return false;
			
			// 只有终态的合同可以删除
			const deletableStatuses = [
				this.STATUS_COMPLETED,
				this.STATUS_CANCELLED,
				this.STATUS_REJECTED,
				this.STATUS_EXPIRED
			];
			
			if (!deletableStatuses.includes(this.contract.status)) return false;
			
			// 只有创建者可以删除
			return String(this.contract.creator) === String(this.currentUserId);
		},

		/**
		 * 🔍 获取可分享（待办）的参与人列表
		 */
		getShareableParticipants(): any[] {
			if (!this.contract || !this.contract.participants) return [];
			
			// 过滤出：非当前用户（或者当前用户也可以分享给自己？通常是分享给他人）
			// 且状态为：待处理(0) 或 表单已填写(1)
			return this.contract.participants.filter((p: any) => {
				const status = Number(p.status);
				return status === this.PARTICIPANT_PENDING || 
				       status === this.PARTICIPANT_FORM_FILLED;
			});
		},

		/**
		 * 🔧 判断是否可以分享（仅发起人且合同未结束时可见）
		 */
		canShare(): boolean {
			if (!this.contract) return false;
			
			// 只有签署中或表单填写中的合同可以分享链接
			if (this.contract.status !== this.STATUS_SIGNING && 
			    this.contract.status !== this.STATUS_FORM_FILLING) {
				return false;
			}
			
			// 只有创建者可以分享
			return String(this.contract.creator) === String(this.currentUserId);
		},

		/**
		 * 🔗 处理分享按钮点击
		 * 🚀 极致简化：如果只有一个可分享人，直接复制；否则才弹窗选择。
		 */
		handleShare() {
			const shareables = this.getShareableParticipants();
			
			if (shareables.length === 0) {
				uni.showToast({
					title: '所有参与人已完成操作',
					icon: 'none'
				});
				return;
			}
			
			if (shareables.length === 1) {
				// 只有一个参与人，直接复制，无需弹窗
				const p = shareables[0];
				console.log('🚀 只有一个待办参与人，直接复制链接:', p.userId);
				this.copySignLink(p);
			} else {
				// 多个参与人，弹窗选择
				this.showSharePopup = true;
			}
		},

		/**
		 * 🔗 获取并复制签署链接
		 */
		async copySignLink(participant: any) {
			if (!this.contract || !participant) return;
			
			uni.showLoading({ title: '获取链接中...' });
			
			try {
				const params: GenerateSignLinkParams = {
					participantId: participant.id,
					validHours: 24,
					oneTime: false
				};
				
				const res = await generateSignLink(this.contractId, params);
				
				if (res && res.signUrl) {
					uni.setClipboardData({
						data: res.signUrl,
						success: () => {
							uni.showToast({
								title: '链接已复制到剪贴板',
								icon: 'success'
							});
						}
					});
				} else {
					uni.showToast({
						title: '获取链接失败',
						icon: 'none'
					});
				}
			} catch (error) {
				console.error('获取签署链接失败:', error);
				uni.showToast({
					title: '获取链接失败',
					icon: 'none'
				});
			} finally {
				uni.hideLoading();
			}
		}
	}
}
</script>

<template>
	<view class="contract-detail">
		<!-- 加载中 -->
		<view v-if="loading" class="loading-container">
			<view class="loading-spinner"></view>
			<text class="loading-text">加载中...</text>
		</view>
		
		<!-- 合同内容 -->
	<scroll-view v-if="!loading && contract" class="content-scroll" scroll-y="true">
		<view class="content-wrapper">
			<!-- 🆕 阶段提示卡片（表单填写中时显示） -->
			<view v-if="contract && contract.status === 7" class="stage-hint-card">
				<view class="stage-hint-icon">
					<text class="fa fa-info-circle"></text>
				</view>
				<view class="stage-hint-content">
					<view class="stage-hint-title"><text class="fa fa-pencil-square-o stage-hint-title-icon"></text> 当前处于表单填写阶段</view>
					<view class="stage-hint-desc">所有参与人填写完表单后，将自动进入签署阶段</view>
				</view>
			</view>
			
			<!-- 合同基本信息卡片 -->
			<view class="info-card">
					<!-- 合同标题 + 状态标签（内联） -->
					<view class="contract-header">
						<view class="title-row">
							<text class="contract-title">{{ contract.name }}</text>
						</view>
						<view class="contract-status-tag" :style="{ backgroundColor: getStatusColor(contract.status) + '1A', borderColor: getStatusColor(contract.status) }">
							<text class="contract-status-tag-text" :style="{ color: getStatusColor(contract.status) }">{{ getSmartStatusName() }}</text>
						</view>
					</view>
					
					<!-- 基本信息 -->
					<view class="detail-section">
						<view class="detail-row">
							<text class="fa fa-clock detail-icon"></text>
							<text class="detail-label">创建时间</text>
							<text class="detail-value">{{ formatDateTime(contract.createTime) }}</text>
						</view>
						
						<view class="detail-row" v-if="contract.deadline">
							<text class="fa fa-calendar detail-icon"></text>
							<text class="detail-label">截止时间</text>
							<text class="detail-value">{{ formatDateTime(contract.deadline) }}</text>
						</view>
						
						<view class="detail-row" v-if="contract.templateId">
							<text class="fa fa-file-text detail-icon"></text>
							<text class="detail-label">合同模板</text>
							<text class="detail-value">{{ templateName || '加载中...' }}</text>
						</view>
					</view>
				</view>
				
			<!-- 参与人信息卡片 -->
			<view class="info-card participants-card" v-if="contract">
				<view class="card-header">
					<view class="header-left">
						<text class="card-title">参与方信息</text>
					</view>
					<view class="participant-count" v-if="contract.participants && contract.participants.length > 0">
						<text class="count-text">{{ contract.participants.length }}方</text>
					</view>
				</view>
				
				<!-- 有参与人时显示列表 -->
				<view v-if="contract.participants && contract.participants.length > 0" class="participants-list">
		<view 
			v-for="(participant, index) in contract.participants" 
			:key="index"
			class="participant-item"
			:class="{
				'signed': participant.status === PARTICIPANT_SIGNED,
				'form-filled': participant.status === PARTICIPANT_FORM_FILLED,
				'rejected': participant.status === PARTICIPANT_REJECTED,
				'pending': participant.status === PARTICIPANT_PENDING
			}"
		>
				<!-- 左侧：头像区域 -->
				<view class="participant-avatar">
					<view 
						class="avatar-circle" 
						:style="{ 
							backgroundColor: getAvatarColor(participant.userId)[0]
						}"
					>
						<!-- 🔧 使用姓名首字作为头像 -->
						<text class="avatar-text">{{ getParticipantName(participant).substring(0, 1) }}</text>
					</view>
					<!-- 🔧 签署顺序徽章 -->
					<view class="order-badge" v-if="contract.participants && contract.participants.length > 1">
						<text class="order-num">{{ participant.order || (index + 1) }}</text>
					</view>
				</view>
						
						<!-- 中间：参与人信息 -->
						<view class="participant-content">
							<!-- 姓名 -->
							<view class="name-row">
								<text class="participant-name">{{ getParticipantName(participant) }}</text>
				<!-- 状态标签 -->
				<view class="status-tag" :class="{
					'status-signed': participant.status === PARTICIPANT_SIGNED,
					'status-form-filled': participant.status === PARTICIPANT_FORM_FILLED,
					'status-form-filling': participant.status === PARTICIPANT_PENDING && participant.flowMode === 'TWO_STAGE',
					'status-pending': participant.status === PARTICIPANT_PENDING && (!participant.flowMode || participant.flowMode !== 'TWO_STAGE'),
					'status-rejected': participant.status === PARTICIPANT_REJECTED,
					'status-cancelled': participant.status === PARTICIPANT_CANCELLED
				}">
					<!-- 已签署 -->
					<text class="fa fa-check-circle status-icon" v-if="participant.status === PARTICIPANT_SIGNED"></text>
					<!-- 表单已填写 -->
					<text class="fa fa-file-check status-icon" v-if="participant.status === PARTICIPANT_FORM_FILLED"></text>
					<!-- 待填表（两阶段流程的待处理状态） -->
					<text class="fa fa-edit status-icon" v-if="participant.status === PARTICIPANT_PENDING && participant.flowMode === 'TWO_STAGE'"></text>
					<!-- 待签署（直接签署流程的待处理状态） -->
					<text class="fa fa-clock status-icon" v-if="participant.status === PARTICIPANT_PENDING && (!participant.flowMode || participant.flowMode !== 'TWO_STAGE')"></text>
					<!-- 已拒绝 -->
					<text class="fa fa-times-circle status-icon" v-if="participant.status === PARTICIPANT_REJECTED"></text>
					<!-- 已取消 -->
					<text class="fa fa-ban status-icon" v-if="participant.status === PARTICIPANT_CANCELLED"></text>
					<text class="status-text">{{ getParticipantStatusText(participant) }}</text>
				</view>
							</view>
							
				<!-- 联系方式：手机号或企业信息 -->
				<view v-if="participant.userMobile || participant.enterpriseName" class="info-row contact-info">
					<text class="fa fa-phone info-icon" v-if="participant.userMobile"></text>
					<text class="fa fa-building info-icon" v-if="!participant.userMobile && participant.enterpriseName"></text>
					<text class="info-text">{{ participant.userMobile ? maskPhone(participant.userMobile) : participant.enterpriseName || '' }}</text>
					<text class="history-phone-tag" v-if="participant.isCurrentUser && participant.userMobile && currentUserMobile && participant.userMobile !== currentUserMobile">历史手机号</text>
				</view>
					
					<!-- 🔧 签署时间（只在已签署时显示） -->
					<view v-if="participant.status === PARTICIPANT_SIGNED && participant.signTime" class="info-row">
						<text class="fa fa-calendar-check info-icon"></text>
						<text class="info-text">签署于 {{ formatDateTime(participant.signTime) }}</text>
					</view>
					
					<!-- 🔧 拒签时间（已拒签时显示） -->
					<view v-if="participant.status === PARTICIPANT_REJECTED && participant.signTime" class="info-row">
						<text class="fa fa-calendar-times info-icon"></text>
						<text class="info-text">拒签于 {{ formatDateTime(participant.signTime) }}</text>
					</view>
					
					<!-- 🔧 拒签原因（已拒签时显示） -->
					<view v-if="participant.status === PARTICIPANT_REJECTED && participant.rejectReason" class="info-row">
						<text class="fa fa-comment-dots info-icon"></text>
						<text class="info-text">{{ participant.rejectReason }}</text>
					</view>
					
					<!-- 使用的印章（只在已签署时显示） -->
					<view v-if="participant.status === PARTICIPANT_SIGNED && participant.sealName" class="info-row">
						<text class="fa fa-stamp info-icon"></text>
						<text class="info-text">{{ participant.sealName }}</text>
					</view>
						</view>
					</view>
				</view>
				
				<!-- 无参与人时显示空状态 -->
				<view v-else class="empty-participants">
					<text class="fa fa-user-slash empty-icon"></text>
					<text class="empty-text">暂无参与人信息</text>
				</view>
			</view>
			
			<!-- 拒绝原因（如果有） -->
			<view class="info-card warning" v-if="contract && contract.status === STATUS_REJECTED && contract.reason">
				<view class="card-header">
					<text class="fa fa-exclamation-circle card-icon"></text>
					<text class="card-title">拒绝原因</text>
				</view>
				<view class="reason-content">
					<text class="reason-text">{{ contract.reason }}</text>
				</view>
			</view>
			
			<!-- 底部安全间距 -->
			<view class="bottom-safe-area"></view>
		</view>
	</scroll-view>
		
	<!-- 底部操作栏 -->
	<view v-if="!loading && contract" class="bottom-bar">
		<!-- 预览按钮 -->
		<view class="action-btn secondary" @click="handlePreview">
			<text class="fa fa-eye"></text>
			<text class="action-text">预览</text>
		</view>
		
		<!-- 🆕 填写表单按钮 -->
		<view v-if="canFillForm()" class="action-btn form" @click="handleFillForm">
			<text class="fa fa-edit"></text>
			<text class="action-text">填写表单</text>
		</view>
		
		<!-- 签署按钮 -->
		<view v-if="canSign()" class="action-btn primary" @click="handleSign">
			<text class="fa fa-signature"></text>
			<text class="action-text">立即签署</text>
		</view>
		
		<!-- 撤销按钮 -->
		<view v-if="canCancel()" class="action-btn danger" @click="handleCancel">
			<text class="fa fa-undo"></text>
			<text class="action-text">撤销</text>
		</view>
		
		<!-- 🆕 分享按钮 -->
		<view v-if="canShare()" class="action-btn secondary" @click="handleShare">
			<text class="fa fa-share-alt-square"></text>
			<text class="action-text">分享链接</text>
		</view>
		
	<!-- AI审查按钮 -->
	<view v-if="contract && contract.status === STATUS_COMPLETED" class="action-btn audit" @click="handleAIAudit">
		<text class="fa fa-search"></text>
		<text class="action-text">AI审查</text>
	</view>
	
	<!-- 下载按钮 -->
	<view v-if="contract && contract.status === STATUS_COMPLETED" class="action-btn primary" @click="handleDownload">
		<text class="fa fa-download"></text>
		<text class="action-text">下载</text>
	</view>
	
	<!-- 删除按钮 -->
	<view v-if="canDelete()" class="action-btn danger" @click="handleDelete">
		<text class="fa fa-trash"></text>
		<text class="action-text">删除</text>
	</view>
	</view>
	</view>
	
	<!-- 🆕 分享链接弹窗 -->
	<view v-if="showSharePopup && contract" class="share-popup-mask" @click="showSharePopup = false">
		<view class="share-popup-container" @click.stop>
			<view class="share-popup-header">
				<text class="share-popup-title">分享签署链接</text>
				<text class="fa fa-times close-icon" @click="showSharePopup = false"></text>
			</view>
			
			<view class="share-popup-content">
				<view class="share-tip">
					<text class="fa fa-info-circle tip-icon"></text>
					<text class="tip-text">请选择需要分享的参与人，复制后可粘贴发送</text>
				</view>
				
				<scroll-view class="share-participant-list" scroll-y="true">
					<view 
						v-for="(p, index) in getShareableParticipants()" 
						:key="index"
						class="share-participant-item"
					>
						<view class="share-participant-info">
							<text class="share-participant-name">{{ getParticipantName(p) }}</text>
							<text class="share-participant-status">{{ getParticipantStatusText(p) }}</text>
						</view>
						<view class="copy-btn" @click="copySignLink(p)">
							<text class="fa fa-copy"></text>
							<text class="copy-btn-text">复制链接</text>
						</view>
					</view>
				</scroll-view>
			</view>
			
			<view class="share-popup-footer">
				<button class="close-btn" @click="showSharePopup = false">取消</button>
			</view>
		</view>
	</view>
</template>

<style>
