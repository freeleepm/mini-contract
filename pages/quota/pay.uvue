<template>
	<view class="pay-page">
		<scroll-view scroll-y="true" class="content">
			<view class="detail-content">
				<!-- 购买账户信息 -->
				<view class="buyer-card" v-if="!loading">
					<view class="buyer-header">
						<text class="fa fa-user buyer-header-icon"></text>
						<text class="buyer-header-title">购买账户</text>
						<view class="buyer-tag" :class="{ 'buyer-tag-enterprise': enterpriseId != null }">
							<text class="buyer-tag-text">{{ enterpriseId != null ? '企业账户' : '个人账户' }}</text>
						</view>
					</view>
					<view class="buyer-divider"></view>
					<view class="buyer-body">
						<view class="buyer-info-item">
							<text class="buyer-label">用户昵称</text>
							<text class="buyer-value">{{ buyerNickname }}</text>
						</view>
						<view class="buyer-info-item">
							<text class="buyer-label">手机号码</text>
							<text class="buyer-value">{{ buyerMobile }}</text>
						</view>
						<view class="buyer-info-item" v-if="enterpriseId != null">
							<text class="buyer-label">充值账户</text>
							<text class="buyer-value buyer-value-highlight">企业账户</text>
						</view>
					</view>
					<view class="buyer-tip">
						<text class="fa fa-exclamation-triangle buyer-tip-icon"></text>
						<text class="buyer-tip-text">配额将充值到上述账户，请确认后再支付</text>
					</view>
				</view>

				<!-- 支付订单信息 -->
				<view class="order-card" v-if="!loading">
					<view class="order-header">
						<text class="order-title">{{ payOrder.subject }}</text>
						<view class="order-status" :class="getStatusClass(payOrder.status)">
							<text class="status-text">{{ getStatusText(payOrder.status) }}</text>
						</view>
					</view>
					<view class="order-divider"></view>
					<view class="order-body">
						<view class="order-info-item">
							<text class="info-label">订单号</text>
							<text class="info-value">{{ payOrder.no }}</text>
						</view>
						<view class="order-info-item">
							<text class="info-label">商品说明</text>
							<text class="info-value">{{ payOrder.body }}</text>
						</view>
						<view class="order-info-item">
							<text class="info-label">创建时间</text>
							<text class="info-value">{{ payOrder.createTime }}</text>
						</view>
					</view>
					<view class="order-divider"></view>
					<view class="order-footer">
						<text class="price-label">支付金额</text>
						<text class="price-value">¥{{ formatPrice(payOrder.price) }}</text>
					</view>
				</view>

				<!-- 加载中 -->
				<view class="loading-card" v-else>
					<text class="loading-text">加载中...</text>
				</view>

				<!-- 支付方式选择 -->
				<view class="pay-methods" v-if="payOrder.status === 0">
					<view class="section-title">
						<text class="section-title-text">选择支付方式</text>
					</view>
					
					<!-- 加载中提示 -->
					<view class="loading-tip" v-if="channelLoading">
						<text class="loading-text">加载支付渠道中...</text>
					</view>
					
					<!-- 无可用渠道提示 -->
					<view class="no-channel-tip" v-else-if="getAvailableChannels().length === 0">
						<text class="no-channel-text">暂无可用支付渠道</text>
					</view>
					
					<!-- 动态渠道列表 -->
					<view v-else>
						<view class="method-item" 
							v-for="(channel, index) in getAvailableChannels()"
							:key="channel.code"
							:class="{ 'selected': selectedChannel === channel.code }"
							@click="selectChannel(channel.code)">
							<view class="method-icon">
								<text class="icon" :class="channel.icon"></text>
							</view>
							<view class="method-info">
								<text class="method-name">{{ channel.name }}</text>
								<text class="method-desc">{{ channel.desc }}</text>
							</view>
							<view class="method-check" v-if="selectedChannel === channel.code">
								<text class="icon icon-check"></text>
							</view>
						</view>
					</view>
				</view>

				<!-- 支付成功提示 -->
				<view class="success-card" v-if="payOrder.status === 10">
					<view class="success-icon-container">
						<text class="icon icon-check-circle success-icon"></text>
					</view>
					<text class="success-title">支付成功</text>
					<text class="success-desc">配额已添加到您的账户</text>
				</view>
			</view>
		</scroll-view>

		<!-- 底部操作栏 -->
		<view class="bottom-bar" v-if="payOrder.status === 0">
			<view class="pay-btn" :class="{ 'disabled': !selectedChannel || submitting }"
				@click="handlePay">
				<text class="pay-btn-text">{{ submitting ? '支付中...' : '立即支付' }}</text>
			</view>
		</view>
		
		<view class="bottom-bar" v-else-if="payOrder.status === 10">
			<view class="pay-btn success-btn" @click="goBack">
				<text class="pay-btn-text">返回</text>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	import { 
		getPayOrder, 
		submitPayOrder, 
		syncOrderPayStatus,
		getEnableChannelCodeList,
		getQuotaBalance,
		type PayOrderInfo 
	} from '@/api/quota/index';
	import { get } from '@/api/index';

	// 支付状态枚举
	const PayOrderStatusEnum = {
		WAITING: 0,   // 待支付
		SUCCESS: 10,  // 支付成功
		REFUND: 20,   // 已退款
		CLOSED: 30,   // 支付关闭
		EXPIRED: 40   // 已过期
	};
	
	// 所有支付渠道配置
	type ChannelConfig = {
		name: string;
		code: string;
		desc: string;
		icon: string;
	};
	
	const allChannelsConfig: ChannelConfig[] = [
		{ name: '模拟支付', code: 'mock', desc: '用于测试，立即到账', icon: 'icon-credit-card' },
		{ name: '支付宝扫码', code: 'alipay_qr', desc: '使用支付宝扫码支付', icon: 'icon-credit-card' },
		{ name: '支付宝H5', code: 'alipay_wap', desc: '跳转支付宝网页支付', icon: 'icon-credit-card' },
		{ name: '微信扫码', code: 'wx_native', desc: '使用微信扫码支付', icon: 'icon-credit-card' },
		{ name: '微信H5', code: 'wx_h5', desc: '跳转微信网页支付', icon: 'icon-credit-card' },
		{ name: '微信小程序', code: 'wx_lite', desc: '微信小程序内支付', icon: 'icon-credit-card' }
	];

	export default {
		data() {
			return {
				loading: true,
				submitting: false,
				orderId: null as number | null,
				payOrderId: null as number | null,
				payOrder: {} as PayOrderInfo,
				selectedChannel: '',
				pollingTimer: null as number | null,
				enabledChannelCodes: [] as string[],
				channelLoading: false,
				enterpriseId: null as number | null,
				buyerNickname: '-',
				buyerMobile: '-'
			}
		},

		async onLoad(options: OnLoadOptions) {
			if (options['orderId'] != null) {
				this.orderId = parseInt(options['orderId'] as string);
			}
			if (options['payOrderId'] != null) {
				this.payOrderId = parseInt(options['payOrderId'] as string);
			}
			if (options['enterpriseId'] != null) {
				this.enterpriseId = parseInt(options['enterpriseId'] as string);
			}
			
			// 加载当前用户信息
			this.loadBuyerInfo();
			
			// 检查配额功能是否启用
			try {
				const balanceRes = await getQuotaBalance();
				if (balanceRes != null && balanceRes.enabled === false) {
					uni.showToast({
						title: '配额功能已关闭',
						icon: 'none'
					});
					setTimeout(() => {
						uni.navigateBack();
					}, 1500);
					return;
				}
			} catch (e) {
				console.warn('检查配额开关状态失败', e);
			}
			
			if (this.payOrderId != null) {
				this.loadPayOrder();
			} else {
				uni.showToast({
					title: '订单参数错误',
					icon: 'none'
				});
				setTimeout(() => {
					uni.navigateBack();
				}, 1500);
			}
		},

		onUnload() {
			this.stopPolling();
		},

		methods: {
			async loadBuyerInfo() {
				try {
					const res = await get<any>('/api/v1/member/user/get');
					this.buyerNickname = (res.nickname as string | null) ?? '-';
					const mobile = (res.mobile as string | null) ?? '';
					if (mobile.length >= 7) {
						this.buyerMobile = mobile.substring(0, 3) + '****' + mobile.substring(7);
					} else {
						this.buyerMobile = mobile.length > 0 ? mobile : '-';
					}
				} catch (error: any) {
					console.warn('获取购买用户信息失败', error);
				}
			},

			formatPrice(price: number): string {
				return (price / 100).toFixed(2);
			},

			getStatusClass(status: number): string {
				if (status === PayOrderStatusEnum.SUCCESS) {
					return 'status-success';
				} else if (status === PayOrderStatusEnum.WAITING) {
					return 'status-waiting';
				} else {
					return 'status-closed';
				}
			},

			getStatusText(status: number): string {
				switch (status) {
					case PayOrderStatusEnum.WAITING:
						return '待支付';
					case PayOrderStatusEnum.SUCCESS:
						return '支付成功';
					case PayOrderStatusEnum.REFUND:
						return '已退款';
					case PayOrderStatusEnum.CLOSED:
						return '已关闭';
					case PayOrderStatusEnum.EXPIRED:
						return '已过期';
					default:
						return '未知状态';
				}
			},

			async loadPayOrder() {
				this.loading = true;
				try {
					const res = await getPayOrder(this.payOrderId as number, true);
					this.payOrder = res;
					
					// 如果已支付成功，同步订单状态
					if (res.status === PayOrderStatusEnum.SUCCESS && this.orderId != null) {
						await this.syncPayStatus();
					}
					
					// 🔧 动态加载可用支付渠道
					if (res.appId != null) {
						await this.loadEnabledChannels(res.appId as number);
					}
				} catch (error: any) {
					console.error('加载支付订单失败', error);
					uni.showToast({
						title: error.message || '加载失败',
						icon: 'none'
					});
				} finally {
					this.loading = false;
				}
			},
			
			// 加载可用支付渠道
			async loadEnabledChannels(appId: number) {
				this.channelLoading = true;
				try {
					const codes = await getEnableChannelCodeList(appId);
					this.enabledChannelCodes = codes || [];
					console.log('[Pay] 可用支付渠道:', this.enabledChannelCodes);
					
					// 默认选中第一个可用渠道
					if (this.enabledChannelCodes.length > 0) {
						this.selectedChannel = this.enabledChannelCodes[0];
					}
				} catch (error: any) {
					console.error('加载支付渠道失败', error);
					// 加载失败时使用默认的模拟支付
					this.enabledChannelCodes = ['mock'];
					this.selectedChannel = 'mock';
				} finally {
					this.channelLoading = false;
				}
			},
			
			// 获取可用的渠道配置列表
			getAvailableChannels(): ChannelConfig[] {
				return allChannelsConfig.filter((c: ChannelConfig): boolean => 
					this.enabledChannelCodes.indexOf(c.code) !== -1
				);
			},

			selectChannel(channel: string) {
				this.selectedChannel = channel;
			},

			handlePay() {
				if (!this.selectedChannel || this.submitting) {
					return;
				}

				// 🔐 二次确认弹窗
				const priceText = '¥' + this.formatPrice(this.payOrder.price);
				const that = this; // 保存 this 引用
				uni.showModal({
					title: '支付确认',
					content: '您即将支付 ' + priceText + '，确认继续？',
					confirmText: '确认支付',
					cancelText: '取消',
					success: (res) => {
						if (res.confirm) {
							that.doSubmitPay();
						}
					}
				});
			},
			
			// 实际提交支付逻辑
			async doSubmitPay() {
				this.submitting = true;
				try {
					const res = await submitPayOrder(
						this.payOrderId as number, 
						this.selectedChannel
					);
					
					// 模拟支付直接成功
					if (res.status === PayOrderStatusEnum.SUCCESS) {
						this.payOrder.status = PayOrderStatusEnum.SUCCESS;
						await this.syncPayStatus();
						uni.showToast({
							title: '支付成功！',
							icon: 'success'
						});
					} else {
						// 其他支付方式，开始轮询
						this.startPolling();
					}
				} catch (error: any) {
					console.error('支付失败', error);
					uni.showToast({
						title: error.message || '支付失败',
						icon: 'none'
					});
				} finally {
					this.submitting = false;
				}
			},

			async syncPayStatus() {
				if (this.orderId == null) return;
				
				try {
					await syncOrderPayStatus(this.orderId as number);
					console.log('同步支付状态成功');
				} catch (error) {
					console.warn('同步支付状态失败', error);
				}
			},

			startPolling() {
				this.stopPolling();
				this.pollingTimer = setInterval(() => {
					this.checkPayStatus();
				}, 3000) as number;
			},

			stopPolling() {
				if (this.pollingTimer != null) {
					clearInterval(this.pollingTimer);
					this.pollingTimer = null;
				}
			},

			async checkPayStatus() {
				try {
					const res = await getPayOrder(this.payOrderId as number, true);
					if (res.status === PayOrderStatusEnum.SUCCESS) {
						this.stopPolling();
						this.payOrder.status = PayOrderStatusEnum.SUCCESS;
						await this.syncPayStatus();
						uni.showToast({
							title: '支付成功！',
							icon: 'success'
						});
					} else if (res.status !== PayOrderStatusEnum.WAITING) {
						this.stopPolling();
						this.payOrder.status = res.status;
					}
				} catch (error) {
					console.error('检查支付状态失败', error);
				}
			},

			goBack() {
				uni.navigateBack({
					delta: 2
				});
			}
		}
	}
</script>

