<script>
/**
 * H5预览页面（WebView方式）
 * 
 * 专门用于预览合同文档，不包含签署功能
 */
import { getSealPageUrl } from '../../api/seals/index';
import { getContract, ContractStatus, type Contract } from '../../api/contracts/index';
import { downloadContractFile } from '../../api/utils/download';
import { buildViewShareConfig, buildDefaultShareConfig } from '../../utils/share';

export default {
	data() {
		return {
			// H5预览页面URL
			viewUrl: '' as string,
			
			// 任务ID
			taskId: '' as string,
			
			// 文件URL（可选，用于直接预览指定文件）
			fileUrl: null as string | null,
			
			// 合同状态（从父页面传递，避免重复调用接口）
			contractStatus: null as number | null,
			
			// 合同详情（仅在需要时加载）
			contract: null as Contract | null,
			
			// 页面加载状态
			loading: true as boolean,
			
			// 下载中状态
			downloading: false as boolean,
			
			// 错误信息
			errorMessage: '' as string
		}
	},
	
	computed: {
		/**
		 * 是否可以下载（签署任务已完成）
		 */
		canDownload() {
			// 优先使用传递的状态，否则从合同详情获取
			const status = this.contractStatus !== null ? this.contractStatus : this.contract?.status;
			// ContractStatus.COMPLETED = 3（数字，不是字符串！）
			const result = status === ContractStatus.COMPLETED;
			console.log('[H5预览] 下载权限检查:', {
				contractStatus: this.contractStatus,
				contractDetailStatus: this.contract?.status,
				finalStatus: status,
				COMPLETED_VALUE: ContractStatus.COMPLETED,
				canDownload: result
			});
			return result;
		}
	},
	
	// #ifdef MP-WEIXIN
	onShareAppMessage() : any {
		if (this.taskId) {
			const title = this.contract != null ? (this.contract!.title ?? '合同') : '合同';
			const config = buildViewShareConfig(this.taskId, title);
			return {
				title: config.title,
				path: config.path,
				imageUrl: config.imageUrl
			};
		}
		const defaultConfig = buildDefaultShareConfig();
		return {
			title: defaultConfig.title,
			path: defaultConfig.path,
			imageUrl: defaultConfig.imageUrl
		};
	},
	// #endif
	
	onLoad(options: any) {
		console.log('[H5预览] 页面加载，参数:', options);
		
		// 获取任务ID
		if (options && options.taskId) {
			this.taskId = options.taskId;
		} else {
			uni.showToast({
				title: '缺少任务ID',
				icon: 'none'
			});
			setTimeout(() => {
				uni.navigateBack();
			}, 1500);
			return;
		}
		
		// 可选：获取文件URL
		if (options && options.fileUrl) {
			this.fileUrl = decodeURIComponent(options.fileUrl);
			console.log('[H5预览] 接收到文件URL:', this.fileUrl);
		}
		
		// 可选：获取合同状态（避免重复调用接口）
		if (options && options.status) {
			this.contractStatus = parseInt(options.status);
			console.log('[H5预览] ✅ 接收到合同状态:', this.contractStatus, '(无需调用接口)');
		} else {
			// 如果没有传递状态，才调用接口获取合同详情
			console.log('[H5预览] ⚠️ 未接收到状态参数，将调用接口获取合同详情');
			this.loadContractDetail();
		}
		
		// 构建H5预览页面URL
		this.buildViewUrl();
	},
	
	methods: {
		/**
		 * 加载合同详情
		 */
		async loadContractDetail() {
			try {
				const response = await getContract(this.taskId);
				console.log('[H5预览] 获取合同详情成功:', response);
				console.log('[H5预览] ✅ 合同状态:', response?.status);
				console.log('[H5预览] ✅ 合同名称:', response?.name);
				this.contract = response;
			} catch (error) {
				console.error('[H5预览] ❌ 获取合同详情失败:', error);
			}
		},
		
		/**
		 * 构建H5预览页面URL
		 */
	async buildViewUrl() {
		try {
			// 使用统一印章应用，mode=view
			// ✅ getSealPageUrl 现在是异步函数，需要 await
			let previewUrl = await getSealPageUrl('view', this.taskId);
			console.log('[H5预览] ✅ 统一应用预览URL (含 Seal-Token):', previewUrl);
				
				// 如果传入了fileUrl参数，附加到预览URL上
				if (this.fileUrl) {
					console.log('[H5预览] ✅ 接收到文件URL，准备附加到预览页面');
					console.log('[H5预览] 📄 原始文件URL:', this.fileUrl);
					
					const encodedFileUrl = encodeURIComponent(this.fileUrl);
					console.log('[H5预览] 🔐 编码后的文件URL:', encodedFileUrl);
					
					previewUrl += `&fileUrl=${encodedFileUrl}`;
					console.log('[H5预览] 🎯 附加参数后的完整URL:', previewUrl);
				} else {
					console.warn('[H5预览] ⚠️ 未接收到文件URL参数，H5页面将使用默认逻辑');
				}
				
				this.viewUrl = previewUrl;
				console.log('[H5预览] 🚀 最终传递给WebView的URL:', this.viewUrl);
				
				uni.showLoading({
					title: '加载预览...'
				});
			} catch (error) {
				console.error('[H5预览] 构建URL失败:', error);
				this.errorMessage = '预览页面加载失败';
				uni.showToast({
					title: this.errorMessage,
					icon: 'none'
				});
			}
		},
		
		/**
		 * H5页面加载完成
		 */
		handleLoad(e: any): void {
			console.log('[H5预览] 页面加载完成:', e);
			this.loading = false;
			uni.hideLoading();
		},
		
		/**
		 * H5页面加载失败
		 */
		handleError(e: any): void {
			console.error('[H5预览] 页面加载失败:', e);
			
			this.loading = false;
			this.errorMessage = 'H5页面加载失败，请检查网络连接';
			
			uni.hideLoading();
			
			uni.showModal({
				title: '错误',
				content: 'H5页面加载失败，请检查网络连接或联系技术支持',
				showCancel: true,
				confirmText: '重试',
				cancelText: '返回',
				success: (res) => {
					if (res.confirm) {
						this.buildViewUrl();
					} else {
						uni.navigateBack();
					}
				}
			});
		},
		
		/**
		 * 接收H5页面消息
		 */
		handleMessage(e : WebViewMessageEvent) {
			console.log('[H5预览] ✅ 收到H5消息事件');
			console.log('[H5预览] e.detail:', JSON.stringify(e.detail));
			
			// 兼容不同版本的消息格式
			let data : any = null;
			
			// 格式1: e.detail.data 是数组
			if (e.detail.data != null && Array.isArray(e.detail.data) && e.detail.data.length > 0) {
				data = e.detail.data[e.detail.data.length - 1];
				console.log('[H5预览] 从数组获取消息:', JSON.stringify(data));
			} 
			// 格式2: e.detail.data 直接是对象
			else if (e.detail.data != null && typeof e.detail.data === 'object') {
				data = e.detail.data;
				console.log('[H5预览] 直接获取消息对象:', JSON.stringify(data));
			}
			// 格式3: e.detail 本身就是消息（检查是否有 type 属性）
			else if (e.detail != null) {
				const detail = e.detail as any;
				if (detail.type != null) {
					data = detail;
					console.log('[H5预览] 从 detail 获取消息:', JSON.stringify(data));
				}
			}
			
			if (data == null) {
				console.log('[H5预览] ⚠️ 无法解析消息数据');
				return;
			}
			
			const messageType = (data as any).type;
			console.log('[H5预览] 处理消息, type:', messageType);
			
			if (messageType == 'close') {
				console.log('[H5预览] 🚀 H5页面请求关闭，执行 navigateBack');
				uni.navigateBack();
			} else if (messageType == 'ready') {
				console.log('[H5预览] H5页面已准备就绪');
			} else if (messageType == 'ERROR') {
				this.handleH5Error((data as any).message);
			} else {
				console.log('[H5预览] 未知消息类型:', messageType);
			}
		},
		
		/**
		 * H5错误处理
		 */
		handleH5Error(message: string | null): void {
			console.error('[H5预览] H5错误:', message);
			
			uni.showModal({
				title: '错误',
				content: message || '预览过程中出现错误',
				showCancel: false
			});
		},
		
		/**
		 * 下载合同
		 */
		async handleDownload(): Promise<void> {
			// 如果正在下载，直接返回
			if (this.downloading) return;
			
			// 如果签署未完成，显示提示
			if (!this.canDownload) {
				console.log('[H5预览] 签署未完成，无法下载');
				uni.showToast({
					title: '请等待所有签署方完成签署',
					icon: 'none',
					duration: 2000
				});
				return;
			}
			
			this.downloading = true;
			
			try {
				// 优先使用 fileUrl，否则使用 contract.signedFileUrl
				const downloadUrl = this.fileUrl || (this.contract && this.contract.signedFileUrl) || '';
				
				if (!downloadUrl) {
					throw new Error('无法获取下载地址');
				}
				
				console.log('[H5预览] 开始下载合同:', downloadUrl);
				
				// 使用下载工具函数
				await downloadContractFile(downloadUrl, this.contract?.name || '合同');
				
			} catch (error) {
				console.error('[H5预览] 下载失败:', error);
				uni.showToast({
					title: '下载失败',
					icon: 'none'
				});
			} finally {
				this.downloading = false;
			}
		}
	}
}
</script>

<template>
	<view class="h5-view-container">
		<!-- 加载中提示 -->
		<view v-if="loading" class="loading-container">
			<view class="loading-spinner"></view>
			<text class="loading-text">加载预览中...</text>
		</view>
		
		<!-- 错误提示 -->
		<view v-if="errorMessage" class="error-container">
			<text class="fa fa-exclamation-circle error-icon"></text>
			<text class="error-text">{{ errorMessage }}</text>
		</view>
		
		<!-- WebView -->
		<view v-if="viewUrl && !errorMessage" class="webview-wrapper">
			<web-view 
				class="webview-content"
				:src="viewUrl"
				@load="handleLoad"
				@error="handleError"
				@message="handleMessage"
			></web-view>
		</view>
		
		<!-- 底部固定操作栏（始终显示，根据状态控制是否可用） -->
		<view class="bottom-bar" v-if="!errorMessage">
			<view 
				class="download-btn" 
				:class="{ 'disabled': !canDownload, 'loading': downloading }"
				@click="handleDownload"
			>
				<text class="btn-text">{{ downloading ? '下载中...' : (canDownload ? '下载合同' : '签署完成后可下载') }}</text>
			</view>
		</view>
	</view>
</template>

<style>
/* FontAwesome基础样式 */
.fa {
	font-family: FontAwesome;
	font-size: 26rpx;
	font-style: normal;
	-webkit-font-smoothing: antialiased;
	-moz-osx-font-smoothing: grayscale;
}

/* 页面容器 */
.h5-view-container {
	flex: 1;
	background-color: #F7F9FC;
	/* 为底部按钮预留空间 */
	padding-bottom: 128rpx;
}

/* WebView容器 */
.webview-wrapper {
	flex: 1;
	width: 100%;
	height: 100%;
	position: relative;
}

.webview-content {
	flex: 1;
	width: 100%;
	height: 100%;
}

/* 加载中容器 */
.loading-container {
	width: 100%;
	height: 100%;
	align-items: center;
	justify-content: center;
}

.loading-spinner {
	width: 80rpx;
	height: 80rpx;
	border-width: 4rpx;
	border-style: solid;
	border-color: #E4E7ED;
	border-top-color: #00C28A;
	border-radius: 40rpx;
	animation: spin 1s linear infinite;
}

@keyframes spin {
	0% {
		transform: rotate(0deg);
	}
	100% {
		transform: rotate(360deg);
	}
}

.loading-text {
	font-size: 28rpx;
	color: #909399;
	margin-top: 30rpx;
}

/* 错误容器 */
.error-container {
	width: 100%;
	height: 100%;
	align-items: center;
	justify-content: center;
	padding: 60rpx;
}

.error-icon {
	font-size: 100rpx;
	color: #F56C6C;
	margin-bottom: 30rpx;
}

.error-text {
	font-size: 30rpx;
	color: #606266;
	text-align: center;
	line-height: 50rpx;
}

/* 底部固定操作栏 */
.bottom-bar {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	background-color: #FFFFFF;
	padding: 20rpx 30rpx;
	box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
	/* 安全区域适配 */
	padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* 下载按钮 */
.download-btn {
	height: 88rpx;
	border-radius: 16rpx;
	background-color: #00C28A;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	transition: opacity 0.3s;
}

.download-btn:active {
	opacity: 0.9;
}

.download-btn.disabled {
	background-color: #A0CFBE;
	opacity: 0.8;
}

.download-btn.loading {
	opacity: 0.8;
}

.btn-icon {
	font-size: 32rpx;
	color: #FFFFFF;
	margin-right: 8rpx;
}

.btn-text {
	font-size: 30rpx;
	color: #FFFFFF;
	font-weight: 500;
}
</style>
