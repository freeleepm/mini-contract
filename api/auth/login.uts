/**
 * 登录相关API
 */

import { request } from '../index'

/**
 * 手机号+验证码登录请求参数
 */
export interface SmsLoginRequest {
	mobile: string      // 手机号
	code: string        // 验证码
}

/**
 * 手机号+密码登录请求参数
 */
export interface PasswordLoginRequest {
	mobile: string      // 手机号
	password: string    // 密码
}

/**
 * 登录响应数据
 */
export interface LoginResponse {
	accessToken: string      // 访问令牌
	refreshToken: string     // 刷新令牌
	userId: number           // 用户ID
	expiresTime: number      // 过期时间（时间戳）
}

/**
 * 发送验证码请求参数
 */
export interface SendCodeRequest {
	mobile: string      // 手机号
	scene: number       // 场景：1-登录 2-注册 3-修改密码等
}

/**
 * 手机号+验证码登录（登录即注册）
 * @param data 登录参数
 * @returns 登录结果
 * @note request 函数已经解包了 ApiResponse，所以直接返回 data 部分
 */
export function smsLogin(data: SmsLoginRequest): Promise<LoginResponse> {
	return request<LoginResponse>({
		url: '/api/v1/member/auth/sms-login',
		method: 'POST',
		data: data,
		isAuth: false
	})
}

/**
 * 手机号+密码登录
 * @param data 登录参数
 * @returns 登录结果
 * @note request 函数已经解包了 ApiResponse，所以直接返回 data 部分
 */
export function passwordLogin(data: PasswordLoginRequest): Promise<LoginResponse> {
	return request<LoginResponse>({
		url: '/api/v1/member/auth/login',
		method: 'POST',
		data: data,
		isAuth: false
	})
}

/**
 * 发送登录验证码
 * @param mobile 手机号
 * @returns 发送结果
 * @note request 函数已经解包了 ApiResponse，所以直接返回 data 部分
 */
export function sendLoginCode(mobile: string): Promise<boolean> {
	return request<boolean>({
		url: '/api/v1/member/auth/send-sms-code',
		method: 'POST',
		data: {
			mobile: mobile,
			scene: 1  // 场景：1表示登录
		},
		isAuth: false
	})
}

export function sendUpdatePasswordCode(mobile: string): Promise<boolean> {
	return request<boolean>({
		url: '/api/v1/member/auth/send-sms-code',
		method: 'POST',
		data: {
			mobile: mobile,
			scene: 3 
		}
	})
}

export function updateUserPassword(data: { password: string; code: string }): Promise<boolean> {
	return request<boolean>({
		url: '/api/v1/member/user/update-password',
		method: 'PUT',
		data
	})
}

/**
 * 发送修改手机号验证码
 * @param mobile 手机号（旧手机号或新手机号）
 * @returns 发送结果
 */
export function sendUpdateMobileCode(mobile: string): Promise<boolean> {
	return request<boolean>({
		url: '/api/v1/member/auth/send-sms-code',
		method: 'POST',
		data: {
			mobile: mobile,
			scene: 2
		}
	})
}

/**
 * 校验短信验证码（仅验证，不消费）
 * @param mobile 手机号
 * @param code 验证码
 * @param scene 场景
 * @returns 校验结果
 */
export function validateSmsCode(mobile: string, code: string, scene: number): Promise<boolean> {
	return request<boolean>({
		url: '/api/v1/member/auth/validate-sms-code',
		method: 'POST',
		data: {
			mobile: mobile,
			code: code,
			scene: scene
		}
	})
}

/**
 * 修改手机号
 * @param data 包含新手机号、新手机号验证码、旧手机号验证码
 * @returns 修改结果
 */
export function updateMobile(data: { mobile: string; code: string; oldCode: string }): Promise<boolean> {
	return request<boolean>({
		url: '/api/v1/member/user/update-mobile',
		method: 'PUT',
		data: data
	})
}
