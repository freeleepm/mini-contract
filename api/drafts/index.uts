import {
  ContractStatus,
  getContract,
  getContractPage,
  type Contract,
  type ContractListResponse
} from '../contracts/index.uts'

export interface DraftPageParams {
  page: number;
  size: number;
}

/**
 * 草稿就是状态为 DRAFT 的签署任务，不维护第二套本地伪造数据源。
 */
export function getDraftList(params: DraftPageParams): Promise<ContractListResponse> {
  return getContractPage({
    pageNo: params.page,
    pageSize: params.size,
    status: ContractStatus.DRAFT,
    roleFilter: 'creator'
  })
}

export function getDraftDetail(draftId: string): Promise<Contract> {
  return getContract(draftId)
}
