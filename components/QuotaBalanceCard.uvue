<template>
	<view class="quota-balance-card" v-if="!loading">
		<view class="card-header">
			<view class="title">
				<text class="icon icon-wallet title-icon"></text>
				<text class="title-text">{{ accountTypeName }}</text>
			</view>
			<view class="enterprise-tag" v-if="enterpriseName">
				<text class="enterprise-tag-text">{{ enterpriseName }}</text>
			</view>
		</view>

		<view class="card-body">
			<view class="balance-info">
				<text class="balance-value">{{ balance }}</text>
				<text class="balance-label">剩余合同份数</text>
			</view>

			<view class="stats-row">
				<view class="stat-item">
					<text class="stat-value stat-success">+{{ totalAcquired }}</text>
					<text class="stat-label">累计获得</text>
				</view>
				<view class="stat-item">
					<text class="stat-value stat-warning">-{{ totalUsed }}</text>
					<text class="stat-label">累计使用</text>
				</view>
			</view>
		</view>

		<view class="card-footer" v-if="showActions">
			<view class="action-btn action-btn-primary" @click="handlePurchase">
				<text class="icon icon-shopping-cart action-icon"></text>
				<text class="action-text">购买套餐</text>
			</view>
			<view class="action-btn action-btn-default" @click="handleViewLogs">
				<text class="icon icon-file-text action-icon"></text>
				<text class="action-text">变动记录</text>
			</view>
		</view>
	</view>

	<view class="loading-container" v-else>
		<text class="loading-text">加载中...</text>
	</view>
</template>

<script lang="uts">
	import { getQuotaBalance, type QuotaBalanceResponse } from '@/api/quota/index';

	export default {
		props: {
			/**
			 * 企业ID（可选，不传则显示个人账户）
			 */
			enterpriseId: {
				type: Number,
				default: null
			},
			/**
			 * 是否显示操作按钮
			 */
			showActions: {
				type: Boolean,
				default: true
			}
		},

		data() {
			return {
				loading: true,
				accountTypeName: '个人账户',
				balance: 0,
				totalAcquired: 0,
				totalUsed: 0,
				enterpriseName: '' as string
			}
		},

		watch: {
			enterpriseId: {
				handler(newVal: number | null) {
					this.fetchBalance();
				},
				immediate: true
			}
		},

		methods: {
			/**
			 * 获取配额余额
			 */
			async fetchBalance() {
				this.loading = true;
				try {
					const res = await getQuotaBalance(this.enterpriseId);
					if (res != null) {
						this.accountTypeName = res.accountTypeName || '个人账户';
						this.balance = res.balance || 0;
						this.totalAcquired = res.totalAcquired || 0;
						this.totalUsed = res.totalUsed || 0;
						this.enterpriseName = res.enterpriseName || '';
					}
				} catch (error) {
					console.error('获取配额余额失败', error);
					// 设置默认值
					this.balance = 0;
					this.totalAcquired = 0;
					this.totalUsed = 0;
				} finally {
					this.loading = false;
				}
			},

			/**
			 * 刷新余额
			 */
			refresh() {
				this.fetchBalance();
			},

			/**
			 * 处理购买操作
			 */
			handlePurchase() {
				this.$emit('purchase');
			},

			/**
			 * 处理查看记录操作
			 */
			handleViewLogs() {
				this.$emit('viewLogs');
			}
		}
	}
</script>

<style>
	/* 引入FontAwesome图标 */
	@import url("../static/styles/fontawesome.css");
	
