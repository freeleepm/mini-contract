<template>
	<view class="modal-overlay" v-if="visible" @click="handleOverlayClick">
		<view class="modal-container" @click.stop>
			<!-- 图标 -->
			<view class="icon-wrapper">
				<text class="icon icon-alert-triangle warning-icon"></text>
			</view>

			<!-- 标题 -->
			<text class="modal-title">配额不足</text>

			<!-- 消息内容 -->
			<view class="modal-content">
				<text class="main-text">{{ message }}</text>
				<view class="balance-row">
					<text class="sub-text">当前剩余 </text>
					<text class="balance-text">{{ balance }}</text>
					<text class="sub-text"> 份</text>
				</view>
				<text class="hint-text">请购买套餐后继续操作</text>
			</view>

			<!-- 按钮区域 -->
			<view class="modal-actions">
				<view class="action-btn action-btn-cancel" @click="handleClose">
					<text class="action-btn-text action-btn-cancel-text">稍后再说</text>
				</view>
				<view class="action-btn action-btn-primary" @click="handlePurchase">
					<text class="icon icon-shopping-cart action-icon"></text>
					<text class="action-btn-text action-btn-primary-text">立即购买</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	export default {
		props: {
			/**
			 * 是否显示弹窗
			 */
			visible: {
				type: Boolean,
				default: false
			},
			/**
			 * 提示消息
			 */
			message: {
				type: String,
				default: '您的合同配额不足，无法创建新合同'
			},
			/**
			 * 当前余额
			 */
			balance: {
				type: Number,
				default: 0
			},
			/**
			 * 企业ID（购买时传递）
			 */
			enterpriseId: {
				type: Number,
				default: null
			}
		},

		methods: {
			handleOverlayClick() {
				// 点击遮罩层不关闭
			},

			handleClose() {
				this.$emit('close');
			},

			handlePurchase() {
				this.$emit('close');
				// 跳转到购买页面
				let url = '/pages/quota/purchase';
				if (this.enterpriseId != null) {
					url += '?enterpriseId=' + this.enterpriseId;
				}
				uni.navigateTo({ url: url });
			}
		}
	}
</script>

