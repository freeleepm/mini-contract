	font-size: 28rpx;
	font-weight: 500;
	color: #333333;
}

.result-content {
	gap: 16rpx;
}

.result-item {
	flex-direction: row;
	align-items: center;
}

.result-label {
	font-size: 26rpx;
	color: #666666;
	width: 140rpx;
}

.result-value {
	font-size: 26rpx;
	color: #333333;
	flex: 1;
}

/* 拍照指导弹窗 */
.modal-overlay {
	position: fixed;
	top: 0;
