	padding: 40rpx 30rpx 20rpx;
	align-items: center;
}

.modal-title {
	font-size: 34rpx;
	font-weight: bold;
	color: #333333;
}

.modal-body {
	padding: 20rpx 30rpx 30rpx;
}

.guidance-item {
	flex-direction: row;
	margin-bottom: 16rpx;
}

.guidance-number {
	font-size: 26rpx;
	color: #0A2E5C;
