<script lang="uts">
/**
 * 模板二维码弹窗组件
 * 
 * 功能：
 * - 展示微信官方小程序码
 * - 支持保存到相册
 * - 支持分享
 * 
 * @author 小华同学AI
 */
import { SEAL_CORE_H5_URL } from '../config/app.config';
import { getWxaQrcode } from '../api/auth/social';

export default {
	props: {
		/** 是否显示弹窗 */
		visible: {
			type: Boolean,
			default: false
		},
		/** 模板名称 */
		templateName: {
			type: String,
			default: ''
		},
		/** 基础模板ID（用于生成小程序码场景值或 H5 降级链接） */
		baseTemplateId: {
			type: String,
			default: ''
		}
	},
	
	emits: ['update:visible', 'close'],
	
	data() {
		return {
			/** QR码是否已生成 */
			qrReady: false,
			/** 生成中状态 */
			generating: false,
			/** 错误信息 */
			errorMsg: '' as string,
			/** 微信官方小程序码图片 */
			qrcodeImageSrc: '' as string
		}
	},
	
	computed: {
		/** 
		 * 保存失败或非小程序分享时使用的 H5 降级链接。
		 */
		qrCodeUrl() : string {
			if (!this.baseTemplateId) return '';
			return `${SEAL_CORE_H5_URL}/h5/sign/create?templateId=${this.baseTemplateId}`;
		}
	},
	
	watch: {
		visible(newVal : boolean) {
			if (newVal && this.baseTemplateId) {
				this.$nextTick(() => {
					// 延迟确保弹窗和图片容器完成布局渲染
					setTimeout(() => {
						this.generateQRCode();
					}, 200);
				});
			}
			if (!newVal) {
				this.qrReady = false;
				this.generating = false;
				this.errorMsg = '';
				this.qrcodeImageSrc = '';
			}
		}
	},
	
	methods: {
		/**
		 * 生成微信官方小程序码
		 */
		generateQRCode() : void {
			if (!this.baseTemplateId) {
				this.errorMsg = '无法生成二维码：缺少模板信息';
				return;
			}
			
			this.generating = true;
			this.qrReady = false;
			this.errorMsg = '';
			
			console.log('[QR Modal] 开始生成模板二维码, baseTemplateId:', this.baseTemplateId);

			this.generateMiniProgramCode();
		},

		/**
		 * 生成微信官方小程序码，扫码后直接进入模板分享落地页
		 */
		async generateMiniProgramCode() : Promise<void> {
			try {
				const base64Image = await getWxaQrcode({
					scene: `tq_${this.baseTemplateId}`,
					path: 'pages/share/landing',
					width: 430,
					autoColor: false,
					checkPath: true,
					hyaline: false
				});

				if (base64Image === '') {
					throw new Error('小程序码图片为空');
				}

				this.qrcodeImageSrc = base64Image.startsWith('data:')
					? base64Image
					: `data:image/png;base64,${base64Image}`;
				this.qrReady = true;
				this.generating = false;
				console.log('[QR Modal] 微信小程序码生成完成');
			} catch (error : any) {
				console.error('[QR Modal] 微信小程序码生成失败:', error);
				this.errorMsg = '小程序码生成失败，请重试';
				this.generating = false;
			}
		},
		
		/**
		 * 保存到相册
		 * H5 端触发浏览器下载，其他端写入临时文件后保存到系统相册。
		 */
		saveToAlbum() : void {
			if (!this.qrReady || this.qrcodeImageSrc === '') {
				uni.showToast({ title: '小程序码正在生成中', icon: 'none' });
				return;
			}

			// #ifdef H5
			const link = document.createElement('a');
			link.href = this.qrcodeImageSrc;
			link.download = '模板小程序码_' + this.templateName + '.png';
			link.style.display = 'none';
			document.body.appendChild(link);
			link.click();
			setTimeout(() => {
				document.body.removeChild(link);
			}, 100);
			uni.showToast({ title: '图片已下载', icon: 'success' });
			return;
			// #endif

			// #ifndef H5
			this.saveDataUrlToAlbum(this.qrcodeImageSrc);
			// #endif
		},

		/**
		 * 将小程序码 Data URL 写入本地文件后保存到相册
		 */
		saveDataUrlToAlbum(dataURL : string) : void {
			// #ifndef H5
			const separatorIndex = dataURL.indexOf(',');
			if (separatorIndex < 0 || separatorIndex >= dataURL.length - 1) {
				console.error('[QR Modal] Data URL 格式无效');
				this.fallbackCopyLink();
				return;
			}

			const base64Data = dataURL.substring(separatorIndex + 1);
			const tempFilePath = `${uni.env.USER_DATA_PATH}/template-qrcode-${Date.now()}.png`;
			const fileSystemManager = uni.getFileSystemManager();

			fileSystemManager.writeFile({
				filePath: tempFilePath,
				data: base64Data,
				encoding: 'base64',
				success: () => {
					uni.saveImageToPhotosAlbum({
						filePath: tempFilePath,
						success: () => {
							uni.showToast({ title: '已保存到相册', icon: 'success' });
						},
						fail: (err : any) => {
							this.handleSaveImageError(err);
						},
						complete: () => {
							fileSystemManager.unlink({
								filePath: tempFilePath,
								fail: () => {}
							});
						}
					});
				},
				fail: (err : any) => {
					console.error('[QR Modal] 写入二维码临时文件失败:', err);
					this.fallbackCopyLink();
				}
			});
			// #endif
		},

		/**
		 * 统一处理相册保存失败和授权提示
		 */
		handleSaveImageError(err : any) : void {
			console.error('[QR Modal] 保存到相册失败:', err);
			const errMsg = String(err.errMsg ?? '').toLowerCase();
			if (errMsg.indexOf('auth') >= 0 || errMsg.indexOf('deny') >= 0) {
				uni.showModal({
					title: '权限提示',
					content: '需要相册权限才能保存图片，请在设置中开启',
					confirmText: '去设置',
					success: (modalRes) => {
						if (modalRes.confirm) {
							uni.openSetting({});
						}
					}
				});
				return;
			}
			this.fallbackCopyLink();
		},
		
		/**
		 * 保存失败时的降级方案：复制链接到剪贴板
		 */
		fallbackCopyLink() : void {
			uni.setClipboardData({
				data: this.qrCodeUrl,
				success: () => {
					uni.showToast({ title: '保存失败，链接已复制到剪贴板', icon: 'none' });
				}
			});
		},
		
		/**
		 * 分享二维码链接
		 */
		shareQrcode() : void {
			if (!this.qrCodeUrl) {
				uni.showToast({ title: '二维码尚未生成', icon: 'none' });
				return;
			}
			
			// #ifdef H5
			// H5端：复制链接到剪贴板
			uni.setClipboardData({
				data: this.qrCodeUrl,
				success: () => {
					uni.showToast({ title: '链接已复制', icon: 'success' });
				}
			});
			// #endif
			
			// #ifdef APP-PLUS
			// App端：使用系统分享。微信小程序由 open-type="share" 按钮触发页面分享。
			uni.share({
				provider: 'weixin',
				type: 0,
				title: this.templateName + ' - 合同模版',
				summary: '扫描二维码使用此模板创建合同',
				href: this.qrCodeUrl,
				success: () => {
					console.log('[QR Modal] 分享成功');
				},
				fail: (err : any) => {
					console.error('[QR Modal] 分享失败:', err);
					// fallback: 复制链接
					uni.setClipboardData({
						data: this.qrCodeUrl,
						success: () => {
							uni.showToast({ title: '链接已复制', icon: 'success' });
						}
					});
				}
			});
			// #endif
		},
		
		/**
		 * 关闭弹窗
		 */
		handleClose() : void {
			this.$emit('update:visible', false);
			this.$emit('close');
		},
		
		/**
		 * 阻止遮罩层穿透
		 */
		preventClose() : void {
			// 空方法，阻止事件冒泡
		}
	}
}
</script>

<template>
	<view class="modal-mask" v-if="visible" @click="handleClose">
		<view class="modal-container" @click.stop="preventClose">
			<!-- 标题栏 -->
			<view class="modal-header">
				<text class="modal-title">模板二维码</text>
				<view class="close-btn" @click="handleClose">
					<text class="close-icon-text">✕</text>
				</view>
			</view>
			
			<!-- 内容区 -->
			<view class="modal-body">
				<!-- 模板名称 -->
				<text class="template-name">{{ templateName }}</text>
				
				<!-- QR码区域 -->
				<view class="qr-wrapper">
					<view v-if="generating" class="qr-loading">
						<text class="loading-text">正在生成二维码...</text>
					</view>
					<view v-else-if="errorMsg !== ''" class="qr-error">
						<text class="error-text">{{ errorMsg }}</text>
						<view class="retry-btn" @click="generateQRCode">
							<text class="retry-text">点击重试</text>
						</view>
					</view>
					<image v-if="qrcodeImageSrc !== ''" class="qr-image" :src="qrcodeImageSrc" mode="aspectFit"></image>
				</view>
				
				<!-- 提示文字 -->
				<text class="qr-tip">微信扫码进入小程序，使用此模板创建合同</text>
			</view>
			
			<!-- 操作按钮 -->
			<view class="modal-footer">
				<view class="footer-btn-row">
					<!-- #ifdef MP-WEIXIN -->
					<button class="share-btn" open-type="share">
						<text class="share-btn-text">分享链接</text>
					</button>
					<!-- #endif -->
					<!-- #ifndef MP-WEIXIN -->
					<view class="share-btn" @click="shareQrcode">
						<text class="share-btn-text">分享链接</text>
					</view>
					<!-- #endif -->
					<view class="save-btn" @click="saveToAlbum">
						<text class="save-text">保存到相册</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<style>
	.modal-mask {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, 0.5);
		align-items: center;
		justify-content: center;
		z-index: 999;
	}
	
	.modal-container {
		width: 600rpx;
		background-color: #FFFFFF;
		border-radius: 24rpx;
		overflow: hidden;
		box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);
	}
	
	/* 标题栏 */
	.modal-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 30rpx;
		border-bottom-width: 1rpx;
		border-bottom-color: #EBEEF5;
		border-bottom-style: solid;
	}
	
	.modal-title {
		font-size: 32rpx;
		font-weight: 600;
		color: #303133;
	}
	
	.close-btn {
		width: 50rpx;
		height: 50rpx;
		align-items: center;
		justify-content: center;
	}
	
	.close-icon-text {
		font-size: 36rpx;
		color: #909399;
	}
	
	/* 内容区 */
	.modal-body {
		align-items: center;
		padding: 40rpx 30rpx 20rpx 30rpx;
	}
	
	.template-name {
		font-size: 28rpx;
		font-weight: 500;
		color: #303133;
		margin-bottom: 30rpx;
		text-align: center;
	}
	
	/* QR码区域 */
	.qr-wrapper {
		width: 440rpx;
		height: 440rpx;
		align-items: center;
		justify-content: center;
		background-color: #FFFFFF;
		border-radius: 16rpx;
		border-width: 1rpx;
		border-color: #EBEEF5;
		border-style: solid;
		padding: 20rpx;
		margin-bottom: 20rpx;
		position: relative;
	}
	
	.qr-image {
		width: 400rpx;
		height: 400rpx;
	}
	
	.qr-loading {
		position: absolute;
		align-items: center;
		justify-content: center;
		z-index: 1;
	}
	
	.loading-text {
		font-size: 24rpx;
		color: #909399;
	}
	
	.qr-error {
		position: absolute;
		align-items: center;
		justify-content: center;
		z-index: 1;
	}
	
	.error-text {
		font-size: 24rpx;
		color: #F56C6C;
		margin-bottom: 16rpx;
		text-align: center;
	}
	
	.retry-btn {
		padding: 8rpx 24rpx;
		background-color: rgba(245, 108, 108, 0.08);
		border-radius: 20rpx;
	}
	
	.retry-text {
		font-size: 24rpx;
		color: #F56C6C;
	}
	
	.qr-tip {
		font-size: 24rpx;
		color: #909399;
		margin-bottom: 10rpx;
	}
	
	/* 操作按钮区 */
	.modal-footer {
		padding: 20rpx 30rpx 30rpx 30rpx;
	}
	
	.footer-btn-row {
		flex-direction: row;
		gap: 16rpx;
	}
	
	.share-btn {
		flex: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		height: 80rpx;
		line-height: normal;
		padding: 0;
		margin: 0;
		background-color: #F5F7FA;
		border-radius: 40rpx;
		border-width: 1rpx;
		border-color: #DCDFE6;
		border-style: solid;
	}

	.share-btn::after {
		border: none;
	}
	
	.share-btn-text {
		font-size: 28rpx;
		font-weight: 500;
		color: #606266;
	}
	
	.save-btn {
		flex: 1;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		height: 80rpx;
		background-color: #00C28A;
		border-radius: 40rpx;
	}
	
	.save-text {
		font-size: 28rpx;
		font-weight: 500;
		color: #FFFFFF;
	}
</style>
